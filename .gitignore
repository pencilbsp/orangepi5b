# Build artifacts and generated images
/build/
/cache/
/sources/

# Images stay out; built .deb packages are tracked. build-mesa-package.sh runs
# on macOS while install-rootfs.sh runs on the x86 host, so the host cannot
# rebuild mesa for itself -- the six .deb files have to travel through git.
/output/*
!/output/debs/
/output/debs/*
!/output/debs/*.deb
/*.log
/*.log.*
/output/**/*.img
/output/**/*.img.xz

# Local editor/OS noise
.DS_Store
*.swp
*~
__pycache__/
*.py[cod]

# Spike build products, not part of the image
/spike/**/out/
/spike/**/*capture*/
/spike/**/*snapshot*/
/spike/**/remote-watch*/
/spike/**/analysis-*.txt
/spike/**/*-pull-*.txt
/spike/**/*.log
/spike/v4l2-probe/v4l2-formats
# Incomplete legacy experiment; its source patch was not preserved.
/spike/frl-debug/

# External kernel clones used by BSP comparison builds
/worktrees/

# Board and build-host connection details, contain credentials
/target.json
/server.json
