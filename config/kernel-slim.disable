# First-pass Orange Pi 5B slim profile.
# Keep: RK3588S boot/storage, onboard LAN, USB, HDMI/DRM Rockchip,
# Panthor Mali GPU, Rockchip media codecs/RGA, Broadcom Wi-Fi family.

# Build-time diagnostics and test suites
DEBUG_INFO
DEBUG_INFO_BTF
DEBUG_INFO_BTF_MODULES
KUNIT
KUNIT_ALL_TESTS
GCOV_KERNEL
KCOV
TEST_BPF
TEST_DIV64
TEST_LOCKUP
TEST_MEMCAT_P
TEST_VMALLOC
TEST_XARRAY
NETDEV_ADDR_LIST_TEST
SPI_LOOPBACK_TEST
SND_SOC_UTILS_KUNIT_TEST
SND_TEST_COMPONENT
XZ_DEC_TEST
ASYNC_RAID6_TEST
PKCS7_TEST_KEY

# Legacy and unrelated platform buses / virtualization frontends
STAGING
XEN
CXL_BUS
INFINIBAND
TARGET_CORE
FIREWIRE
PCCARD
PCMCIA
MACINTOSH_DRIVERS
VIRTIO_FS
VHOST_SCSI
VHOST_VDPA
DRM_VIRTIO_GPU
SND_VIRTIO
I2C_VIRTIO
GPIO_VIRTIO
BT_VIRTIO
PTP_1588_CLOCK_KVM

# Unused network protocol families for this desktop image
ATM
ATALK
X25
LAPB
PHONET
RDS
BATMAN_ADV
NFC
IEEE802154
6LOWPAN
OPENVSWITCH
TIPC
MPLS
NET_9P
AF_RXRPC
CEPH_LIB
NET_DSA
HSR
QRTR

# Media: keep V4L2 core, UVC, CEC and Rockchip codecs; drop tuner/broadcast/SDR stacks
MEDIA_ANALOG_TV_SUPPORT
MEDIA_DIGITAL_TV_SUPPORT
MEDIA_RADIO_SUPPORT
MEDIA_SDR_SUPPORT
DVB_CORE

# Audio: keep ASoC Rockchip, HDMI codec and USB audio; drop unrelated buses
SND_PCI
SND_DRIVERS
SND_PCMCIA
SND_FIREWIRE
SND_XEN_FRONTEND

# Input devices not needed for the fixed desktop baseline
INPUT_JOYSTICK

# Unrelated DRM/GPU and display bridges. Keep Rockchip DRM, HDMI QP, display-connector and Panthor.
DRM_ACCEL
DRM_ACCEL_ROCKET
DRM_BOCHS
DRM_ETNAVIV
DRM_GM12U320
DRM_GUD
DRM_KOMEDA
