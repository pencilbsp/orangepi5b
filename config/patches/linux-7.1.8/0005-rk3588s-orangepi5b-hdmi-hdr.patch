+	/*
+	 * Rockchip's HDMI path feeds a full-range RGB framebuffer into the
+	 * controller. The CTA automatic default would advertise limited range
+	 * for CEA timings such as 3840x2160p120, which leaves the sink applying
+	 * a range expansion to pixels that were never compressed. Make the
+	 * default explicit so HDR->SDR transitions return to an unambiguous SDR
+	 * state. Userspace can still request limited range through the property.
+	 */
+	new_conn_state->hdmi.broadcast_rgb = DRM_HDMI_BROADCAST_RGB_FULL;
 }
