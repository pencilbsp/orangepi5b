+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.c	2026-09-09 08:49:39.497692058 +0000
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * H.264 parameter set composition for the Rockchip VEPU580 encoder driver.
+ *
+ * Copyright (C) 2026 Orange Pi 5B mainline project
+ */
+
+#include <linux/bits.h>
+#include <linux/export.h>
+#include <linux/kernel.h>
+
+#include "rkvenc-bits.h"
+#include "rkvenc-h264.h"
+
+#define RKVENC_NAL_SPS			7
+#define RKVENC_NAL_PPS			8
+
+/* A parameter set is far smaller than this; the slack costs one stack frame. */
+#define RKVENC_PS_RBSP_MAX		128
+
+/*
+ * Annex A, table A-1. MaxFS bounds the picture in macroblocks, MaxMBPS the
+ * macroblock rate. Level 1b shares level_idc 11 with level 1.1 and is only
+ * distinguished by constraint_set3_flag, so it is left out: a stream that
+ * would qualify for 1b is signalled as 1.1, which is a superset.
+ */
+static const struct {
+	u8 level_idc;
+	u32 max_fs;
+	u32 max_mbps;
+} rkvenc_h264_levels[] = {
+	{ 10,     99,	    1485 },
+	{ 11,    396,	    3000 },
+	{ 12,    396,	    6000 },
+	{ 13,    396,	   11880 },
+	{ 20,    396,	   11880 },
+	{ 21,    792,	   19800 },
+	{ 22,   1620,	   20250 },
+	{ 30,   1620,	   40500 },
+	{ 31,   3600,	  108000 },
+	{ 32,   5120,	  216000 },
+	{ 40,   8192,	  245760 },
+	{ 41,   8192,	  245760 },
+	{ 42,   8704,	  522240 },
+	{ 50,  22080,	  589824 },
+	{ 51,  36864,	  983040 },
+	{ 52,  36864,	 2073600 },
+	{ 60, 139264,	 4177920 },
+	{ 61, 139264,	 8355840 },
+	{ 62, 139264,	16711680 },
+};
+
+u8 rkvenc_h264_level_idc(u32 mb_width, u32 mb_height, u32 fps_num, u32 fps_den)
+{
+	u32 frame_size = mb_width * mb_height;
+	u32 mbps;
+	unsigned int i;
+
+	if (!fps_den)
+		fps_den = 1;
+
+	/*
+	 * Round the rate up. A stream at 29.97 fps must not be signalled as
+	 * though the decoder only has to keep up with 29.
+	 */
+	mbps = DIV_ROUND_UP((u64)frame_size * fps_num, fps_den);
+
+	for (i = 0; i < ARRAY_SIZE(rkvenc_h264_levels); i++)
+		if (frame_size <= rkvenc_h264_levels[i].max_fs &&
+		    mbps <= rkvenc_h264_levels[i].max_mbps)
+			return rkvenc_h264_levels[i].level_idc;
+
+	/* Beyond the table: claim the highest level rather than a wrong one. */
+	return rkvenc_h264_levels[ARRAY_SIZE(rkvenc_h264_levels) - 1].level_idc;
+}
+
+/*
+ * constraint_set flags say which tools the stream promises not to use, so a
+ * decoder built for a lower profile can still accept it. Only the ones we can
+ * honestly assert are set.
+ */
+static u8 rkvenc_h264_constraints(u8 profile_idc)
+{
+	switch (profile_idc) {
+	case RKVENC_H264_PROFILE_BASELINE:
+		/* set0: obeys the baseline restrictions. */
+		return BIT(7);
+	case RKVENC_H264_PROFILE_MAIN:
+		/* set1: obeys the main restrictions. */
+		return BIT(6);
+	default:
+		return 0;
+	}
+}
+
+size_t rkvenc_h264_write_sps(const struct rkvenc_h264_params *p,
+			     void *dst, size_t size)
+{
+	u32 mb_width = DIV_ROUND_UP(p->width, 16);
+	u32 mb_height = DIV_ROUND_UP(p->height, 16);
+	u8 rbsp[RKVENC_PS_RBSP_MAX];
+	struct rkvenc_bits b;
+	u32 crop_right, crop_bottom;
+
+	rkvenc_bits_init(&b, rbsp, sizeof(rbsp));
+
+	rkvenc_put_bits(&b, p->profile_idc, 8);
+	rkvenc_put_bits(&b, rkvenc_h264_constraints(p->profile_idc), 8);
+	rkvenc_put_bits(&b, p->level_idc, 8);
+	rkvenc_put_ue(&b, 0);				/* seq_parameter_set_id */
+
+	if (p->profile_idc == RKVENC_H264_PROFILE_HIGH) {
+		rkvenc_put_ue(&b, 1);			/* chroma_format_idc: 4:2:0 */
+		rkvenc_put_ue(&b, 0);			/* bit_depth_luma_minus8 */
+		rkvenc_put_ue(&b, 0);			/* bit_depth_chroma_minus8 */
+		rkvenc_put_bits(&b, 0, 1);		/* qpprime_y_zero_transform_bypass */
+		rkvenc_put_bits(&b, 0, 1);		/* seq_scaling_matrix_present */
+	}
+
+	rkvenc_put_ue(&b, p->log2_max_frame_num_minus4);
+
+	/*
+	 * POC type 0. Type 2 would be cheaper -- output order equals decoding
+	 * order here, so the slice header would carry no picture order at all
+	 * -- but the block emits pic_order_cnt_lsb regardless. A parameter set
+	 * that says otherwise leaves the decoder reading every later field at
+	 * the wrong bit offset, which surfaces as a corrupt first macroblock
+	 * rather than as anything that looks like a header problem.
+	 */
+	rkvenc_put_ue(&b, 0);				/* pic_order_cnt_type */
+	rkvenc_put_ue(&b, p->log2_max_poc_lsb_minus4);
+
+	rkvenc_put_ue(&b, p->max_num_ref_frames);
+	rkvenc_put_bits(&b, 0, 1);			/* gaps_in_frame_num_allowed */
+	rkvenc_put_ue(&b, mb_width - 1);
+	rkvenc_put_ue(&b, mb_height - 1);		/* frame_mbs_only, so map units == MB rows */
+	rkvenc_put_bits(&b, 1, 1);			/* frame_mbs_only_flag */
+	rkvenc_put_bits(&b, 1, 1);			/* direct_8x8_inference_flag */
+
+	/*
+	 * The hardware encodes whole macroblocks, so a 1080-line picture is
+	 * coded as 1088 and the extra eight lines are cropped here. For 4:2:0
+	 * with frame_mbs_only the crop unit is two samples in each direction.
+	 */
+	crop_right = (mb_width * 16 - p->width) / 2;
+	crop_bottom = (mb_height * 16 - p->height) / 2;
+	if (crop_right || crop_bottom) {
+		rkvenc_put_bits(&b, 1, 1);		/* frame_cropping_flag */
+		rkvenc_put_ue(&b, 0);			/* crop_left */
+		rkvenc_put_ue(&b, crop_right);
+		rkvenc_put_ue(&b, 0);			/* crop_top */
+		rkvenc_put_ue(&b, crop_bottom);
+	} else {
+		rkvenc_put_bits(&b, 0, 1);
+	}
+
+	if (p->fps_num && p->fps_den) {
+		rkvenc_put_bits(&b, 1, 1);		/* vui_parameters_present */
+		rkvenc_put_bits(&b, 0, 1);		/* aspect_ratio_info_present */
+		rkvenc_put_bits(&b, 0, 1);		/* overscan_info_present */
+		rkvenc_put_bits(&b, 0, 1);		/* video_signal_type_present */
+		rkvenc_put_bits(&b, 0, 1);		/* chroma_loc_info_present */
+		rkvenc_put_bits(&b, 1, 1);		/* timing_info_present */
+		/*
+		 * time_scale counts field ticks, so it is twice the frame
+		 * rate; a frame lasts two ticks. Getting this factor wrong is
+		 * the classic way to hand a player a stream that runs at half
+		 * or double speed.
+		 */
+		rkvenc_put_bits(&b, p->fps_den, 32);	/* num_units_in_tick */
+		rkvenc_put_bits(&b, p->fps_num * 2, 32);/* time_scale */
+		rkvenc_put_bits(&b, 1, 1);		/* fixed_frame_rate_flag */
+		rkvenc_put_bits(&b, 0, 1);		/* nal_hrd_parameters_present */
+		rkvenc_put_bits(&b, 0, 1);		/* vcl_hrd_parameters_present */
+		rkvenc_put_bits(&b, 0, 1);		/* pic_struct_present */
+		rkvenc_put_bits(&b, 0, 1);		/* bitstream_restriction */
+	} else {
+		rkvenc_put_bits(&b, 0, 1);
+	}
+
+	rkvenc_put_trailing_bits(&b);
+	if (b.overflow)
+		return 0;
+
+	/* A parameter set is always a reference NAL: nal_ref_idc must be set. */
+	return rkvenc_emit_nal(dst, size, 3, RKVENC_NAL_SPS,
+			       rbsp, rkvenc_bits_len(&b));
+}
+
+size_t rkvenc_h264_write_pps(const struct rkvenc_h264_params *p,
+			     void *dst, size_t size)
+{
+	u8 rbsp[RKVENC_PS_RBSP_MAX];
+	struct rkvenc_bits b;
+
+	rkvenc_bits_init(&b, rbsp, sizeof(rbsp));
+
+	rkvenc_put_ue(&b, 0);				/* pic_parameter_set_id */
+	rkvenc_put_ue(&b, 0);				/* seq_parameter_set_id */
+	rkvenc_put_bits(&b, p->cabac ? 1 : 0, 1);	/* entropy_coding_mode_flag */
+	rkvenc_put_bits(&b, 0, 1);			/* bottom_field_pic_order_present */
+	rkvenc_put_ue(&b, 0);				/* num_slice_groups_minus1 */
+	rkvenc_put_ue(&b, 0);				/* num_ref_idx_l0_default_active_minus1 */
+	rkvenc_put_ue(&b, 0);				/* num_ref_idx_l1_default_active_minus1 */
+	rkvenc_put_bits(&b, 0, 1);			/* weighted_pred_flag */
+	rkvenc_put_bits(&b, 0, 2);			/* weighted_bipred_idc */
+	rkvenc_put_se(&b, (s32)p->init_qp - 26);	/* pic_init_qp_minus26 */
+	rkvenc_put_se(&b, 0);				/* pic_init_qs_minus26 */
+	rkvenc_put_se(&b, p->chroma_qp_index_offset);
+
+	/*
+	 * The deblocking controls are announced so a slice header may switch
+	 * the filter off. Rate control leans on that for the frames where the
+	 * filter costs more than it returns.
+	 */
+	rkvenc_put_bits(&b, 1, 1);			/* deblocking_filter_control_present */
+	rkvenc_put_bits(&b, 0, 1);			/* constrained_intra_pred_flag */
+	rkvenc_put_bits(&b, 0, 1);			/* redundant_pic_cnt_present */
+
+	rkvenc_put_trailing_bits(&b);
+	if (b.overflow)
+		return 0;
+
+	return rkvenc_emit_nal(dst, size, 3, RKVENC_NAL_PPS,
+			       rbsp, rkvenc_bits_len(&b));
+}
diff -uNr -x '.*' -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x modules.order -x Module.symvers -x Kconfig base/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.h ktest/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.h
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.h	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.h	2026-09-09 08:49:05.193783845 +0000
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * H.264 parameter set composition for the Rockchip VEPU580 encoder driver.
+ *
+ * Copyright (C) 2026 Orange Pi 5B mainline project
+ *
+ * VEPU580 emits slice NALs only, so the sequence and picture parameter sets
+ * are the driver's job. Like the bit writer below it, nothing here touches
+ * the hardware or V4L2: it takes a plain description of the stream and
+ * returns Annex B bytes, which is what lets it be checked against a real
+ * H.264 parser instead of only on the board.
+ */
+
+#ifndef _RKVENC_H264_H_
+#define _RKVENC_H264_H_
+
+#include <linux/types.h>
+
+#define RKVENC_H264_PROFILE_BASELINE	66
+#define RKVENC_H264_PROFILE_MAIN	77
+#define RKVENC_H264_PROFILE_HIGH	100
+
+/**
+ * struct rkvenc_h264_params - everything the parameter sets depend on
+ * @width:	visible luma width in samples
+ * @height:	visible luma height in samples
+ * @profile_idc: one of RKVENC_H264_PROFILE_*
+ * @level_idc:	level, as carried in the SPS
+ * @cabac:	true for CABAC, false for CAVLC
+ * @init_qp:	pic_init_qp, 0..51
+ * @chroma_qp_index_offset: -12..12
+ * @fps_num:	frame rate numerator, 0 to omit VUI timing
+ * @fps_den:	frame rate denominator
+ * @log2_max_frame_num_minus4: sets the frame_num wrap
+ * @max_num_ref_frames: DPB size the stream needs
+ *
+ * The encoder produces I and P pictures only, in output order, so the
+ * parameter sets are written for that case and nothing else: POC type 2,
+ * frame_mbs_only, no picture reordering.
+ */
+struct rkvenc_h264_params {
+	u32 width;
+	u32 height;
+	u8 profile_idc;
+	u8 level_idc;
+	bool cabac;
+	u8 init_qp;
+	s8 chroma_qp_index_offset;
+	u32 fps_num;
+	u32 fps_den;
+	u8 log2_max_frame_num_minus4;
+	u8 log2_max_poc_lsb_minus4;
+	u8 max_num_ref_frames;
+};
+
+/*
+ * Smallest level whose Annex A limits hold for this frame size and rate.
+ * Picking too high a level is legal but tells a decoder to reserve more than
+ * the stream needs; picking too low makes the stream non-conforming.
+ */
+u8 rkvenc_h264_level_idc(u32 mb_width, u32 mb_height, u32 fps_num, u32 fps_den);
+
+/*
+ * Write one Annex B NAL. Both return the byte count, or 0 when the buffer is
+ * too small -- a truncated parameter set is never emitted.
+ */
+size_t rkvenc_h264_write_sps(const struct rkvenc_h264_params *p,
+			     void *dst, size_t size);
+size_t rkvenc_h264_write_pps(const struct rkvenc_h264_params *p,
+			     void *dst, size_t size);
+
+#endif /* _RKVENC_H264_H_ */
diff -uNr -x '.*' -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x modules.order -x Module.symvers -x Kconfig base/drivers/media/platform/rockchip/rkvenc/rkvenc-hw.c ktest/drivers/media/platform/rockchip/rkvenc/rkvenc-hw.c
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-hw.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-hw.c	2026-09-09 08:49:39.497692058 +0000
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Per-frame register path for the Rockchip VEPU580 encoder driver.
+ *
+ * Copyright (C) 2026 Orange Pi 5B mainline project
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+
+#include <linux/align.h>
+#include <linux/minmax.h>
+
+#include "rkvenc-hw.h"
+#include "rkvenc-regs.h"
+
+/* H.264 NAL unit types the block emits on our behalf. */
+#define RKVENC_NAL_SLICE_NON_IDR	1
+#define RKVENC_NAL_SLICE_IDR		5
+
+static inline void rkvenc_wr(void __iomem *regs, u32 reg, u32 val)
+{
+	writel(val, regs + reg);
+}
+
+static inline u32 rkvenc_rd(void __iomem *regs, u32 reg)
+{
+	return readl(regs + reg);
+}
+
+void rkvenc_hw_setup_common(void __iomem *regs)
+{
+	/*
+	 * Everything here is block state rather than job state, but it has to
+	 * be reapplied on every runtime resume: the power domain gates the
+	 * block, and a gated block comes back with its registers cleared.
+	 * Doing it once at probe leaves the first job after an idle period
+	 * running against a dead clock gate and an unconfigured bus.
+	 */
+	writel(RKVENC_FUNC_EN_CKE | RKVENC_FUNC_EN_RESETN_HW |
+	       RKVENC_FUNC_EN_DONE_TMVP,
+	       regs + RKVENC_REG_FUNC_EN);
+
+	/* Leave no clear request standing from a previous job. */
+	writel(0, regs + RKVENC_REG_ENC_CLR);
+
+	/*
+	 * Bus byte order. The bitstream write path is the one that has to be
+	 * told: it assembles bytes the other way round from the rest of the
+	 * block, so without this the stream comes out with its bytes swapped
+	 * -- or, when the burst size is also left unset, lands outside the
+	 * buffer entirely.
+	 */
+	writel(FIELD_PREP(RKVENC_DTRNS_BSW_BUS_EDIN, 7) |
+	       RKVENC_DTRNS_AFBC_BSIZE,
+	       regs + RKVENC_REG_DTRNS_MAP);
+	writel(RKVENC_DTRNS_CFG_DSPR_OTSD, regs + RKVENC_REG_DTRNS_CFG);
+
+	/*
+	 * The watchdog counts cycles a job may spend waiting on its source.
+	 * Left at zero it fires immediately, so a block that would have
+	 * finished reports a timeout instead.
+	 */
+	writel(FIELD_PREP(RKVENC_ENC_WDG_VS_LOAD_THD, 0x1fffff),
+	       regs + RKVENC_REG_ENC_WDG);
+
+	writel(0, regs + RKVENC_REG_INT_MASK);
+	writel(RKVENC_INT_ALL, regs + RKVENC_REG_INT_CLR);
+	writel(RKVENC_INT_ENC_DONE | RKVENC_INT_SCLR_DONE | RKVENC_INT_ERROR,
+	       regs + RKVENC_REG_INT_EN);
+}
+
+void rkvenc_hw_load_tables(void __iomem *regs)
+{
+	unsigned int i;
+
+	/*
+	 * A flat scaling list: the encoder applies no per-coefficient
+	 * weighting, which is what the SPS we emit promises by leaving
+	 * seq_scaling_matrix_present_flag clear. The two have to agree.
+	 */
+	for (i = 0; i < RKVENC_SCL_TAB_LEN; i++)
+		writel(rkvenc_h264_flat_scl_tab[i],
+		       regs + RKVENC_REG_SCL_BASE + i * 4);
+
+	for (i = 0; i < RKVENC_LAMBDA_TAB_LEN; i++) {
+		/* One rate-distortion lambda per QP. */
+		writel(rkvenc_h264_lambda_tab[i],
+		       regs + RKVENC_REG_RDO_WGTA + i * 4);
+
+		/*
+		 * Intra-prediction weights are a HEVC path. Clearing them
+		 * matters: the block reads this window whichever standard is
+		 * selected, and stale values steer mode decisions.
+		 */
+		writel(0, regs + RKVENC_REG_IPRD_WGT + i * 4);
+	}
+}
+
+int rkvenc_hw_reset(void __iomem *regs)
+{
+	u32 status;
+	int ret;
+
+	/* First let outstanding AXI transactions drain cleanly. */
+	rkvenc_wr(regs, RKVENC_REG_INT_MASK, RKVENC_INT_ALL);
+	rkvenc_wr(regs, RKVENC_REG_ENC_CLR, RKVENC_ENC_CLR_SAFE);
+	ret = readl_poll_timeout_atomic(regs + RKVENC_REG_INT_STA, status,
+					status & RKVENC_INT_SCLR_DONE, 0, 5);
+
+	/* Force the block idle even when safe-clear did not acknowledge. */
+	rkvenc_wr(regs, RKVENC_REG_ENC_CLR, RKVENC_ENC_CLR_FORCE);
+	udelay(5);
+	rkvenc_wr(regs, RKVENC_REG_ENC_CLR, 0);
+	rkvenc_wr(regs, RKVENC_REG_INT_CLR, RKVENC_INT_ALL);
+	rkvenc_rd(regs, RKVENC_REG_INT_STA);
+
+	return ret;
+}
+
+u32 rkvenc_hw_bitstream_len(void __iomem *regs)
+{
+	return rkvenc_rd(regs, RKVENC_REG_ST_BS_LENGTH);
+}
+
+static void rkvenc_hw_set_addresses(void __iomem *regs,
+				    const struct rkvenc_frame_job *job)
+{
+	rkvenc_wr(regs, RKVENC_REG_ADR_SRC0, job->src_y);
+	rkvenc_wr(regs, RKVENC_REG_ADR_SRC1, job->src_c);
+	rkvenc_wr(regs, RKVENC_REG_ADR_SRC2, 0);
+
+	rkvenc_wr(regs, RKVENC_REG_RFPW_H_ADDR, job->recon_hdr);
+	rkvenc_wr(regs, RKVENC_REG_RFPW_B_ADDR, job->recon_body);
+	rkvenc_wr(regs, RKVENC_REG_RFPR_H_ADDR, job->ref_hdr);
+	rkvenc_wr(regs, RKVENC_REG_RFPR_B_ADDR, job->ref_body);
+	rkvenc_wr(regs, RKVENC_REG_DSPW_ADDR, job->recon_thumb);
+	rkvenc_wr(regs, RKVENC_REG_DSPR_ADDR, job->ref_thumb);
+
+	/*
+	 * Colocated motion vectors and the motion-info dump belong to features
+	 * this path does not use yet -- temporal direct prediction and the
+	 * per-macroblock statistics readback. Point them at nothing rather
+	 * than at stale addresses from a previous job.
+	 */
+	rkvenc_wr(regs, RKVENC_REG_CMVW_ADDR, 0);
+	rkvenc_wr(regs, RKVENC_REG_CMVR_ADDR, 0);
+	rkvenc_wr(regs, RKVENC_REG_MEIW_ADDR, 0);
+
+	/*
+	 * The bitstream window is described by its two ends plus where to
+	 * start writing. Software headers already sit at the front of the
+	 * buffer, so the block starts past them; bottom stays at the base so
+	 * the hardware's own length count and our offset add up to the
+	 * payload the client receives.
+	 */
+	rkvenc_wr(regs, RKVENC_REG_BSBB_ADDR, job->bs_base);
+	rkvenc_wr(regs, RKVENC_REG_BSBT_ADDR, job->bs_base + job->bs_size);
+	rkvenc_wr(regs, RKVENC_REG_BSBR_ADDR, job->bs_base);
+	rkvenc_wr(regs, RKVENC_REG_ADR_BSBS, job->bs_base + job->bs_offset);
+
+	if (job->ext_line_size) {
+		rkvenc_wr(regs, RKVENC_REG_EBUFT_ADDR,
+			  job->ext_line + job->ext_line_size);
+		rkvenc_wr(regs, RKVENC_REG_EBUFB_ADDR, job->ext_line);
+	} else {
+		rkvenc_wr(regs, RKVENC_REG_EBUFT_ADDR, 0);
+		rkvenc_wr(regs, RKVENC_REG_EBUFB_ADDR, 0);
+	}
+
+	/* Region-of-interest control is off; leave no stale pointers behind. */
+	rkvenc_wr(regs, RKVENC_REG_ROI_ADDR, 0);
+	rkvenc_wr(regs, RKVENC_REG_ROI_QP_ADDR, 0);
+}
+
+static void rkvenc_hw_set_source(void __iomem *regs,
+				 const struct rkvenc_frame_job *job)
+{
+	/* Resolution is carried in eight-pixel units, minus one. */
+	rkvenc_wr(regs, RKVENC_REG_ENC_RSL,
+		  FIELD_PREP(RKVENC_ENC_RSL_PIC_WD8_M1,
+			     job->coded_width / 8 - 1) |
+		  FIELD_PREP(RKVENC_ENC_RSL_PIC_HD8_M1,
+			     job->coded_height / 8 - 1));
+
+	/*
+	 * How much of the last macroblock row and column is padding. The block
+	 * repeats edge samples into it; leaving this at zero makes it encode
+	 * whatever the source buffer happens to hold past the picture.
+	 */
+	rkvenc_wr(regs, RKVENC_REG_SRC_FILL,
+		  FIELD_PREP(RKVENC_SRC_FILL_W,
+			     job->coded_width - job->visible_width) |
+		  FIELD_PREP(RKVENC_SRC_FILL_H,
+			     job->coded_height - job->visible_height));
+
+	rkvenc_wr(regs, RKVENC_REG_SRC_FMT,
+		  FIELD_PREP(RKVENC_SRC_FMT_CFMT, RKVENC_CFMT_YUV420SP) |
+		  RKVENC_SRC_FMT_RANGE | RKVENC_SRC_FMT_OUT_FMT);
+
+	/* No colour conversion: the source is already 4:2:0 YUV. */
+	rkvenc_wr(regs, RKVENC_REG_SRC_UDFY, 0);
+	rkvenc_wr(regs, RKVENC_REG_SRC_UDFU, 0);
+	rkvenc_wr(regs, RKVENC_REG_SRC_UDFV, 0);
+	rkvenc_wr(regs, RKVENC_REG_SRC_UDFO, 0);
+
+	/*
+	 * Let prediction cross the internal row boundaries. Without this the
+	 * block treats each row as its own slice, so the first macroblock of
+	 * every row picks an intra mode whose neighbour it then does not
+	 * signal -- which a decoder rejects as "top block unavailable".
+	 */
+	rkvenc_wr(regs, RKVENC_REG_SLI_CFG, RKVENC_SLI_CFG_SLI_CRS_EN);
+
+	rkvenc_wr(regs, RKVENC_REG_SRC_STRD0,
+		  FIELD_PREP(RKVENC_SRC_STRD0, job->src_stride_y));
+	rkvenc_wr(regs, RKVENC_REG_SRC_STRD1,
+		  FIELD_PREP(RKVENC_SRC_STRD1, job->src_stride_c));
+
+	/*
+	 * The source is read from its origin and the coded picture already
+	 * covers the macroblock padding, so there is no crop offset and no
+	 * edge fill to ask for.
+	 */
+	rkvenc_wr(regs, RKVENC_REG_PIC_OFST, 0);
+	rkvenc_wr(regs, RKVENC_REG_SRC_PROC, 0);
+}
+
+/*
+ * Mode decision. Without this the block still encodes, and the result still
+ * parses as H.264 -- but it picks intra predictors that need neighbours the
+ * picture edge does not have, and a decoder rejects the first macroblock.
+ */
+static void rkvenc_hw_set_rdo(void __iomem *regs,
+			      const struct rkvenc_frame_job *job)
+{
+	u32 cfg;
+
+	/* Activity thresholds that gate the intra search, luma and chroma. */
+	rkvenc_wr(regs, RKVENC_REG_IPRD_CSTS,
+		  FIELD_PREP(RKVENC_IPRD_CSTS_VTHD_Y, 9) |
+		  FIELD_PREP(RKVENC_IPRD_CSTS_VTHD_C, 63));
+
+	cfg = RKVENC_RDO_CFG_INTER_4X4 | RKVENC_RDO_CFG_CHRM_SPCL |
+	      RKVENC_RDO_CFG_CCWA_E | RKVENC_RDO_CFG_ATR_E |
+	      RKVENC_RDO_CFG_ATF_INTRA_E;
+
+	/* Coefficient run limits belong to CAVLC and mean nothing under CABAC. */
+	if (!job->cabac)
+		cfg |= RKVENC_RDO_CFG_VLC_LMT;
+
+	/* Partition shapes are restricted only for low-level Baseline. */
+	if (job->profile_idc == 66 && job->level_idc <= 30)
+		cfg |= RKVENC_RDO_CFG_RECT_SIZE;
+
+	/*
+	 * Scaling list select stays zero: neither parameter set we emit
+	 * carries a scaling matrix, and the table loaded at resume is flat.
+	 */
+	rkvenc_wr(regs, RKVENC_REG_RDO_CFG, cfg);
+}
+
+static void rkvenc_hw_set_syntax(void __iomem *regs,
+				 const struct rkvenc_frame_job *job)
+{
+	u32 nal_type = job->idr ? RKVENC_NAL_SLICE_IDR :
+				  RKVENC_NAL_SLICE_NON_IDR;
+	u32 slice_type = job->idr ? RKVENC_SLI_TYPE_I : RKVENC_SLI_TYPE_P;
+
+	/*
+	 * nal_ref_idc is non-zero for every picture this driver produces:
+	 * with a single reference slot, each frame is the prediction source
+	 * for the next one.
+	 */
+	rkvenc_wr(regs, RKVENC_REG_SYNT_NAL,
+		  FIELD_PREP(RKVENC_SYNT_NAL_REF_IDC, job->idr ? 3 : 2) |
+		  FIELD_PREP(RKVENC_SYNT_NAL_UNIT_TYPE, nal_type));
+
+	rkvenc_wr(regs, RKVENC_REG_SYNT_SPS,
+		  FIELD_PREP(RKVENC_SYNT_SPS_MAX_FNUM,
+			     job->log2_max_frame_num_minus4) |
+		  RKVENC_SYNT_SPS_DRCT_8X8 |
+		  FIELD_PREP(RKVENC_SYNT_SPS_MPOC_LM4,
+			     job->log2_max_poc_lsb_minus4));
+
+	/*
+	 * These fields mirror what rkvenc-h264.c wrote into the PPS. The
+	 * chroma offset is a signed five-bit field, so it is masked rather
+	 * than sign-extended into the neighbouring bits.
+	 */
+	rkvenc_wr(regs, RKVENC_REG_SYNT_PPS,
+		  (job->cabac ? RKVENC_SYNT_PPS_ETPY_MODE : 0) |
+		  FIELD_PREP(RKVENC_SYNT_PPS_PIC_INIT_QP, job->qp) |
+		  FIELD_PREP(RKVENC_SYNT_PPS_CB_OFST,
+			     job->chroma_qp_index_offset & 0x1f) |
+		  FIELD_PREP(RKVENC_SYNT_PPS_CR_OFST,
+			     job->chroma_qp_index_offset & 0x1f) |
+		  RKVENC_SYNT_PPS_DBF_CP_FLG);
+
+	rkvenc_wr(regs, RKVENC_REG_SYNT_SLI0,
+		  FIELD_PREP(RKVENC_SYNT_SLI0_TYPE, slice_type) |
+		  FIELD_PREP(RKVENC_SYNT_SLI0_PPS_ID, 0) |
+		  FIELD_PREP(RKVENC_SYNT_SLI0_FRM_NUM, job->frame_num));
+
+	/*
+	 * idr_pic_id is read only for an IDR; elsewhere the block expects the
+	 * all-ones "not applicable" value.
+	 */
+	rkvenc_wr(regs, RKVENC_REG_SYNT_SLI1,
+		  FIELD_PREP(RKVENC_SYNT_SLI1_IDR_PID,
+			     job->idr ? job->idr_pic_id : 0xffff) |
+		  FIELD_PREP(RKVENC_SYNT_SLI1_POC_LSB, job->poc_lsb));
+
+	/* Deblocking on, no reference reordering, no MMCO. */
+	rkvenc_wr(regs, RKVENC_REG_SYNT_SLI2, 0);
+	rkvenc_wr(regs, RKVENC_REG_SYNT_REFM0, 0);
+	rkvenc_wr(regs, RKVENC_REG_SYNT_REFM1, 0);
+	rkvenc_wr(regs, RKVENC_REG_SYNT_REFM2, 0);
+}
+
+/*
+ * Motion search window and its cache. The window is clamped to what the
+ * picture can hold, then the cache split between the two RAMs is grown until
+ * it no longer fits -- the block reads this geometry rather than deriving it.
+ */
+static void rkvenc_hw_set_me(void __iomem *regs,
+			     const struct rkvenc_frame_job *job)
+{
+	u32 pic_wd64 = ALIGN(job->mb_width * 16, 64) / 64;
+	u32 blk_w = 44, blk_h = 28;
+	u32 srch_w, srch_h, linebuf_w, rama_h, ramb_h, rama_max;
+	u32 srch_16_w, srch_4_h;
+	const u32 cache_max = 2464;
+	const u32 ctu_4_h = 1;
+
+	if (blk_w / 4 * 2 > (job->mb_width * 2 + 1) / 2)
+		blk_w = (job->mb_width * 2 + 1) / 2 / 2 * 4;
+	if (blk_h / 4 > ALIGN(job->mb_height * 16, 64) / 128 * 4)
+		blk_h = ALIGN(job->mb_height * 16, 64) / 128 * 16;
+
+	srch_w = blk_w / 4;
+	srch_h = blk_h / 4;
+
+	rkvenc_wr(regs, RKVENC_REG_ME_RNGE,
+		  FIELD_PREP(RKVENC_ME_RNGE_CME_SRCH_H, srch_w) |
+		  FIELD_PREP(RKVENC_ME_RNGE_CME_SRCH_V, srch_h) |
+		  FIELD_PREP(RKVENC_ME_RNGE_RME_SRCH_H, 7) |
+		  FIELD_PREP(RKVENC_ME_RNGE_RME_SRCH_V, 5));
+
+	/* An IDR has nothing to predict from, so its motion cost is zero. */
+	rkvenc_wr(regs, RKVENC_REG_ME_CFG,
+		  FIELD_PREP(RKVENC_ME_CFG_PMV_MDST_H, job->idr ? 0 : 5) |
+		  FIELD_PREP(RKVENC_ME_CFG_PMV_MDST_V, job->idr ? 0 : 5) |
+		  FIELD_PREP(RKVENC_ME_CFG_MV_LIMIT,
+			     job->level_idc > 20 ? 2 :
+			     (job->level_idc >= 11 ? 1 : 0)) |
+		  FIELD_PREP(RKVENC_ME_CFG_PMV_NUM, 2));
+
+	linebuf_w = pic_wd64 ? pic_wd64 : 1;
+	srch_16_w = min(linebuf_w, (srch_w * 8 + 15) / 16 + 1);
+	srch_4_h = (srch_h * 8 + 3) / 4 + ctu_4_h;
+
+	rama_h = ctu_4_h;
+	ramb_h = srch_4_h;
+	while (rama_h < srch_4_h &&
+	       cache_max > ((rama_h - ctu_4_h) * linebuf_w * 4 +
+			    ramb_h * 4 * srch_16_w)) {
+		rama_h += ctu_4_h;
+		ramb_h = ramb_h > 2 * ctu_4_h ? ramb_h - ctu_4_h : ctu_4_h;
+	}
+	if (srch_4_h == ctu_4_h) {
+		rama_h += ctu_4_h;
+		ramb_h = 0;
+	}
+	if (cache_max < ((rama_h - ctu_4_h) * linebuf_w * 4 +
+			 ramb_h * 4 * srch_16_w))
+		rama_h -= ctu_4_h;
+
+	rama_max = (rama_h - ctu_4_h) / ctu_4_h * linebuf_w + srch_16_w;
+
+	rkvenc_wr(regs, RKVENC_REG_ME_CACH,
+		  FIELD_PREP(RKVENC_ME_CACH_RAMA_MAX, rama_max) |
+		  FIELD_PREP(RKVENC_ME_CACH_RAMA_H, rama_h) |
+		  FIELD_PREP(RKVENC_ME_CACH_LINEBUF_W, linebuf_w));
+
+	/* No global motion hint. */
+	rkvenc_wr(regs, RKVENC_REG_GMV, 0);
+}
+
+/* Mode-cost weights, a different half of the table for intra and inter. */
+static void rkvenc_hw_set_klut(void __iomem *regs, bool idr)
+{
+	unsigned int base = idr ? 0 : 4;
+	unsigned int i;
+
+	rkvenc_wr(regs, RKVENC_REG_KLUT_OFST,
+		  FIELD_PREP(RKVENC_KLUT_OFST_CHRM, idr ? 0 : 3));
+
+	for (i = 0; i < RKVENC_KLUT_WGT_COUNT; i++)
+		rkvenc_wr(regs, RKVENC_REG_KLUT_WGT + i * 4,
+			  rkvenc_h264_klut_weight[base + i]);
+}
+
+void rkvenc_hw_run(void __iomem *regs, const struct rkvenc_frame_job *job)
+{
+	u32 enc_pic;
+
+	/*
+	 * The block-level setup is repeated per frame, not left to the resume
+	 * path alone: a job that ended in an error can leave the clock gate
+	 * and bus configuration disturbed, and the next frame must not
+	 * inherit that.
+	 */
+	rkvenc_hw_setup_common(regs);
+	rkvenc_hw_set_source(regs, job);
+	rkvenc_hw_set_syntax(regs, job);
+	rkvenc_hw_set_rdo(regs, job);
+	rkvenc_hw_set_me(regs, job);
+	rkvenc_hw_set_klut(regs, job->idr);
+	rkvenc_hw_set_addresses(regs, job);
+
+	/* One slice per picture: nothing to split. */
+	rkvenc_wr(regs, RKVENC_REG_SLI_SPLT, 0);
+
+	/*
+	 * Hardware rate control stays off for now, so the QP written below is
+	 * the QP every macroblock gets. Turning RC_CFG_EN on without also
+	 * loading the look-up tables it reads would let the block pick QPs
+	 * from uninitialised memory.
+	 */
+	rkvenc_wr(regs, RKVENC_REG_RC_CFG, 0);
+
+	enc_pic = FIELD_PREP(RKVENC_ENC_PIC_STND, RKVENC_STND_H264) |
+		  FIELD_PREP(RKVENC_ENC_PIC_PIC_QP, job->qp) |
+		  RKVENC_ENC_PIC_CUR_FRM_REF |
+		  RKVENC_ENC_PIC_BS_SCP;
+	rkvenc_wr(regs, RKVENC_REG_ENC_PIC, enc_pic);
+
+	/* One core does the whole frame; no split job. */
+	rkvenc_wr(regs, RKVENC_REG_DUAL_CORE, 0);
+
+	/*
+	 * The write to ENC_START is what hands the block the job, so every
+	 * other register has to be in place first. Read it back to keep the
+	 * posted writes above from arriving after the start.
+	 */
+	rkvenc_rd(regs, RKVENC_REG_ENC_PIC);
+	rkvenc_wr(regs, RKVENC_REG_ENC_START,
+		  FIELD_PREP(RKVENC_ENC_START_CMD, RKVENC_CMD_ONE_FRAME));
+}
