--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-regs.h	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-regs.h	2026-09-09 07:58:42.496187275 +0000
@@ -0,0 +1,440 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Rockchip VEPU580 (RKVENC) register definitions
+ *
+ * Copyright (C) 2026 Orange Pi 5B mainline project
+ *
+ * Offsets and field positions transcribed from Rockchip's MPP encoder HAL
+ * (mpp/hal/rkenc/h264e/hal_h264e_vepu580_reg.h and
+ * mpp/hal/rkenc/common/vepu580_common.h, branch develop).
+ *
+ * The out-of-tree mpp-service port in rcawston/rockchip-rk3588-mainline-patches
+ * carries a second set of defines, named RKVENC2_*, which differ from these in
+ * places. They describe a different member of the family, not this one: that
+ * same file overrides one of them for our block as
+ * RKVENC580_REG_ADR_BSBR 0x02b8, and 0x02b8 is what MPP gives for VEPU580's
+ * bsbr while its RKVENC2_ value is 0x02bc. So where the two disagree, MPP's
+ * VEPU580 layout is the one followed here.
+ *
+ * The block groups its registers into classes at fixed bases:
+ *
+ *   0x0000  CTL   control: version, start, interrupts
+ *   0x0280  BASE  per-frame: buffer addresses, picture config, H.264 syntax
+ *   0x1000  RC    rate control look-up tables
+ *   0x1700  PAR   encoder parameters (ME, RDO weights)
+ *   0x2000  SQI   subjective quality tuning
+ *   0x2200  SCL   quantisation scaling lists
+ *   0x3000  OSD   on-screen display blending
+ *   0x4000  ST    status, written by hardware
+ *   0x5000  DBG   debug counters
+ *
+ * Checked against silicon, 2026-09-09: both blocks on an Orange Pi 5B read
+ * VERSION as 0x50603312, which decodes through the fields below as IP_ID
+ * 0x50, FBC_CAP 3, HEVC_CAP set and H264_CAP set. Three independent fields
+ * landing on sensible values is weak evidence for one register and none at
+ * all for the rest -- the per-frame offsets stay unverified until a frame
+ * comes out of the block.
+ *
+ * Only CTL, BASE and ST are described here: they are what a baseline encode
+ * needs. RC, PAR, SQI and SCL are loaded as tables and are added as the
+ * H.264 register path grows.
+ */
+
+#ifndef _RKVENC_REGS_H_
+#define _RKVENC_REGS_H_
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/sizes.h>
+
+/* ---------------------------------------------------------------- control */
+
+#define RKVENC_REG_VERSION		0x0000
+#define   RKVENC_VERSION_SUB_VER	GENMASK(7, 0)
+#define   RKVENC_VERSION_H264_CAP	BIT(8)
+#define   RKVENC_VERSION_HEVC_CAP	BIT(9)
+#define   RKVENC_VERSION_FBC_CAP	GENMASK(22, 21)
+#define   RKVENC_VERSION_IP_ID		GENMASK(31, 24)
+
+#define RKVENC_REG_ENC_START		0x0010
+#define   RKVENC_ENC_START_LKT_NUM	GENMASK(7, 0)
+#define   RKVENC_ENC_START_CMD		GENMASK(9, 8)
+#define     RKVENC_CMD_ONE_FRAME	1	/* encode a single frame */
+#define     RKVENC_CMD_LINK_TABLE	2	/* run a link-table job list */
+
+#define RKVENC_REG_ENC_CLR		0x0014
+#define   RKVENC_ENC_CLR_SAFE		BIT(0)
+#define   RKVENC_ENC_CLR_FORCE		BIT(1)
+
+/*
+ * The interrupt enable, mask, clear and status registers all use the same
+ * bit assignment, so one set of names covers the four.
+ */
+#define RKVENC_REG_INT_EN		0x0020
+#define RKVENC_REG_INT_MASK		0x0024
+#define RKVENC_REG_INT_CLR		0x0028
+#define RKVENC_REG_INT_STA		0x002c
+#define   RKVENC_INT_ENC_DONE		BIT(0)
+#define   RKVENC_INT_LKT_NODE_DONE	BIT(1)
+#define   RKVENC_INT_SCLR_DONE		BIT(2)
+#define   RKVENC_INT_SLC_DONE		BIT(3)
+#define   RKVENC_INT_BSF_OFLW		BIT(4)
+#define   RKVENC_INT_BRSP_OTSD		BIT(5)
+#define   RKVENC_INT_WBUS_ERR		BIT(6)
+#define   RKVENC_INT_RBUS_ERR		BIT(7)
+#define   RKVENC_INT_WDG		BIT(8)
+#define   RKVENC_INT_LKT_ERR		BIT(9)
+#define   RKVENC_INT_ALL		GENMASK(9, 0)
+/*
+ * Everything that means the job did not produce a usable frame. The
+ * mpp-service port's RKVENC2_ reading of this register places slice-done at
+ * bit 1 and the watchdog at bit 5, against bits 3 and 8 here; both agree
+ * that encode-done is bit 0. Until a running encoder settles it, log the raw
+ * status whenever anything outside ENC_DONE and SLC_DONE is set rather than
+ * trusting either decode of the error bits.
+ */
+#define   RKVENC_INT_ERROR		(RKVENC_INT_BSF_OFLW | \
+					 RKVENC_INT_BRSP_OTSD | \
+					 RKVENC_INT_WBUS_ERR | \
+					 RKVENC_INT_RBUS_ERR | \
+					 RKVENC_INT_WDG | \
+					 RKVENC_INT_LKT_ERR)
+
+#define RKVENC_REG_DTRNS_MAP		0x0030
+#define   RKVENC_DTRNS_LPFW_BUS_ORDR	BIT(0)
+#define   RKVENC_DTRNS_CMVW_BUS_ORDR	BIT(1)
+#define   RKVENC_DTRNS_DSPW_BUS_ORDR	BIT(2)
+#define   RKVENC_DTRNS_RFPW_BUS_ORDR	BIT(3)
+#define   RKVENC_DTRNS_SRC_BUS_EDIN	GENMASK(7, 4)
+#define   RKVENC_DTRNS_MEIW_BUS_EDIN	GENMASK(11, 8)
+#define   RKVENC_DTRNS_BSW_BUS_EDIN	GENMASK(14, 12)
+#define   RKVENC_DTRNS_LKTR_BUS_EDIN	GENMASK(18, 15)
+#define   RKVENC_DTRNS_ROIR_BUS_EDIN	GENMASK(22, 19)
+#define   RKVENC_DTRNS_LKTW_BUS_EDIN	GENMASK(26, 23)
+#define   RKVENC_DTRNS_AFBC_BSIZE	BIT(27)
+
+#define RKVENC_REG_DTRNS_CFG		0x0034
+#define   RKVENC_DTRNS_CFG_DSPR_OTSD	BIT(7)
+#define   RKVENC_DTRNS_CFG_AXI_BRSP_CKE	GENMASK(23, 16)
+
+#define RKVENC_REG_ENC_WDG		0x0038
+#define   RKVENC_ENC_WDG_VS_LOAD_THD	GENMASK(23, 0)
+#define   RKVENC_ENC_WDG_RFP_LOAD_THD	GENMASK(31, 24)
+
+#define RKVENC_REG_ENC_IDLE_EN		0x0050
+
+#define RKVENC_REG_FUNC_EN		0x0054
+#define   RKVENC_FUNC_EN_CKE		BIT(0)
+#define   RKVENC_FUNC_EN_RESETN_HW	BIT(1)
+#define   RKVENC_FUNC_EN_DONE_TMVP	BIT(2)
+#define   RKVENC_FUNC_EN_SRAM_CKG	BIT(3)
+
+#define RKVENC_REG_ENC_ID		0x005c
+#define   RKVENC_ENC_ID_CORE		GENMASK(1, 0)
+
+/* ------------------------------------------------------- base: addresses */
+
+/*
+ * Every address register holds a 32-bit device address; the block reaches
+ * memory through its IOMMU, so these are IOVAs.
+ */
+#define RKVENC_REG_ADR_SRC0		0x0280	/* source plane 0 (luma) */
+#define RKVENC_REG_ADR_SRC1		0x0284	/* source plane 1 */
+#define RKVENC_REG_ADR_SRC2		0x0288	/* source plane 2 */
+#define RKVENC_REG_RFPW_H_ADDR		0x028c	/* recon write, FBC header */
+#define RKVENC_REG_RFPW_B_ADDR		0x0290	/* recon write, FBC body */
+#define RKVENC_REG_RFPR_H_ADDR		0x0294	/* reference read, FBC header */
+#define RKVENC_REG_RFPR_B_ADDR		0x0298	/* reference read, FBC body */
+#define RKVENC_REG_CMVW_ADDR		0x029c	/* colocated MV write */
+#define RKVENC_REG_CMVR_ADDR		0x02a0	/* colocated MV read */
+#define RKVENC_REG_DSPW_ADDR		0x02a4	/* downscaled recon write */
+#define RKVENC_REG_DSPR_ADDR		0x02a8	/* downscaled reference read */
+#define RKVENC_REG_MEIW_ADDR		0x02ac	/* motion info write */
+#define RKVENC_REG_BSBT_ADDR		0x02b0	/* bitstream buffer top */
+#define RKVENC_REG_BSBB_ADDR		0x02b4	/* bitstream buffer bottom */
+#define RKVENC_REG_BSBR_ADDR		0x02b8	/* bitstream read pointer */
+#define RKVENC_REG_ADR_BSBS		0x02bc	/* bitstream write start */
+#define RKVENC_REG_LPFW_ADDR		0x02c0	/* loop filter line write */
+#define RKVENC_REG_LPFR_ADDR		0x02c4	/* loop filter line read */
+#define RKVENC_REG_ROI_ADDR		0x02c8
+#define RKVENC_REG_ROI_QP_ADDR		0x02cc
+#define RKVENC_REG_ROI_AMV_ADDR		0x02d0
+#define RKVENC_REG_ROI_MV_ADDR		0x02d4
+#define RKVENC_REG_EBUFT_ADDR		0x02d8	/* external line buffer top */
+#define RKVENC_REG_EBUFB_ADDR		0x02dc	/* external line buffer bottom */
+
+/* ---------------------------------------------------- base: picture config */
+
+#define RKVENC_REG_ENC_PIC		0x0300
+#define   RKVENC_ENC_PIC_STND		BIT(0)	/* 0 = H.264, 1 = HEVC */
+#define     RKVENC_STND_H264		0
+#define     RKVENC_STND_HEVC		1
+#define   RKVENC_ENC_PIC_ROI_EN		BIT(1)
+#define   RKVENC_ENC_PIC_CUR_FRM_REF	BIT(2)	/* keep this frame as reference */
+#define   RKVENC_ENC_PIC_MEI_STOR	BIT(3)
+#define   RKVENC_ENC_PIC_BS_SCP		BIT(4)	/* emit Annex B start codes */
+#define   RKVENC_ENC_PIC_PIC_QP		GENMASK(13, 8)
+#define   RKVENC_ENC_PIC_NUM_PIC_TOT	GENMASK(18, 14)
+#define   RKVENC_ENC_PIC_LOG2_CTU_NUM	GENMASK(23, 19)
+#define   RKVENC_ENC_PIC_SLEN_FIFO	BIT(30)
+#define   RKVENC_ENC_PIC_REC_FBC_DIS	BIT(31)
+
+#define RKVENC_REG_DUAL_CORE		0x0304
+
+/* Picture size, counted in 8-pixel units, minus one. */
+#define RKVENC_REG_ENC_RSL		0x0310
+#define   RKVENC_ENC_RSL_PIC_WD8_M1	GENMASK(10, 0)
+#define   RKVENC_ENC_RSL_PIC_HD8_M1	GENMASK(26, 16)
+
+#define RKVENC_REG_SRC_FILL		0x0314
+#define   RKVENC_SRC_FILL_W		GENMASK(5, 0)
+#define   RKVENC_SRC_FILL_H		GENMASK(21, 16)
+
+#define RKVENC_REG_SRC_FMT		0x0318
+#define   RKVENC_SRC_FMT_ALPHA_SWAP	BIT(0)
+#define   RKVENC_SRC_FMT_RBUV_SWAP	BIT(1)
+#define   RKVENC_SRC_FMT_CFMT		GENMASK(5, 2)
+#define     RKVENC_CFMT_YUV422SP	4
+#define     RKVENC_CFMT_YUV422P		5
+#define     RKVENC_CFMT_YUV420SP	6	/* NV12 / NV21 */
+#define     RKVENC_CFMT_YUV420P		7	/* I420 / YV12 */
+#define     RKVENC_CFMT_YUV400		10
+#define   RKVENC_SRC_FMT_RANGE		BIT(6)
+#define   RKVENC_SRC_FMT_OUT_FMT	BIT(7)
+
+#define RKVENC_REG_SRC_UDFY		0x031c
+#define RKVENC_REG_SRC_UDFU		0x0320
+#define RKVENC_REG_SRC_UDFV		0x0324
+#define RKVENC_REG_SRC_UDFO		0x0328
+#define RKVENC_REG_SRC_PROC		0x032c
+#define   RKVENC_SRC_PROC_MIRR		BIT(26)
+#define   RKVENC_SRC_PROC_ROT		GENMASK(28, 27)
+#define   RKVENC_SRC_PROC_TXA_EN	BIT(29)
+#define   RKVENC_SRC_PROC_AFBCD_EN	BIT(30)
+
+#define RKVENC_REG_PIC_OFST		0x0330
+#define   RKVENC_PIC_OFST_X		GENMASK(13, 0)
+#define   RKVENC_PIC_OFST_Y		GENMASK(29, 16)
+
+#define RKVENC_REG_SRC_STRD0		0x0334	/* luma stride, bytes */
+#define   RKVENC_SRC_STRD0		GENMASK(16, 0)
+#define RKVENC_REG_SRC_STRD1		0x0338	/* chroma stride, bytes */
+#define   RKVENC_SRC_STRD1		GENMASK(15, 0)
+
+/* ------------------------------------------------- base: rate control */
+
+#define RKVENC_REG_RC_CFG		0x0350
+#define   RKVENC_RC_CFG_EN		BIT(0)
+#define   RKVENC_RC_CFG_AQ_EN		BIT(1)
+#define   RKVENC_RC_CFG_AQ_MODE		BIT(2)
+#define   RKVENC_RC_CFG_CTU_NUM		GENMASK(31, 12)
+
+#define RKVENC_REG_RC_QP		0x0354
+#define   RKVENC_RC_QP_RANGE		GENMASK(19, 16)
+#define   RKVENC_RC_QP_MAX		GENMASK(25, 20)
+#define   RKVENC_RC_QP_MIN		GENMASK(31, 26)
+
+#define RKVENC_REG_RC_TGT		0x0358
+
+/* ----------------------------------------------------- base: slice split */
+
+#define RKVENC_REG_SLI_SPLT		0x0360
+#define   RKVENC_SLI_SPLT_EN		BIT(0)
