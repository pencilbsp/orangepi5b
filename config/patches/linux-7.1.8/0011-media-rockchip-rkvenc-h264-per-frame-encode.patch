-static int rkvenc_open(struct file *file)
-{
-	struct rkvenc_dev *enc = video_drvdata(file);
-	struct rkvenc_ctx *ctx;
-	int ret;
-
-	ctx = kzalloc_obj(*ctx);
-	if (!ctx)
-		return -ENOMEM;
-
-	ctx->enc = enc;
-	ctx->bitrate = RKVENC_DEFAULT_BITRATE;
-	ctx->gop_size = RKVENC_DEFAULT_GOP_SIZE;
-	ctx->fps_num = RKVENC_DEFAULT_FPS;
-	ctx->fps_den = 1;
-
-	ctx->src_fmt.width = RKVENC_DEFAULT_WIDTH;
-	ctx->src_fmt.height = RKVENC_DEFAULT_HEIGHT;
-	ctx->src_fmt.colorspace = V4L2_COLORSPACE_REC709;
-	ctx->src_fmt.quantization = V4L2_QUANTIZATION_LIM_RANGE;
-	rkvenc_fill_raw_fmt(&ctx->src_fmt);
-
-	ctx->dst_fmt.width = RKVENC_DEFAULT_WIDTH;
-	ctx->dst_fmt.height = RKVENC_DEFAULT_HEIGHT;
-	ctx->dst_fmt.colorspace = V4L2_COLORSPACE_REC709;
-	ctx->dst_fmt.quantization = V4L2_QUANTIZATION_LIM_RANGE;
-	rkvenc_fill_coded_fmt(&ctx->dst_fmt);
-
-	ctx->crop.left = 0;
-	ctx->crop.top = 0;
-	ctx->crop.width = ctx->src_fmt.width;
-	ctx->crop.height = ctx->src_fmt.height;
-
-	if (mutex_lock_interruptible(&enc->mutex)) {
-		ret = -ERESTARTSYS;
-		goto err_free;
-	}
-
-	v4l2_fh_init(&ctx->fh, video_devdata(file));
-	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(enc->m2m_dev, ctx,
-					    rkvenc_queue_init);
-	if (IS_ERR(ctx->fh.m2m_ctx)) {
-		ret = PTR_ERR(ctx->fh.m2m_ctx);
-		goto err_fh;
-	}
-
-	ret = rkvenc_setup_ctrls(ctx);
-	if (ret)
-		goto err_m2m;
-
-	v4l2_fh_add(&ctx->fh, file);
-	mutex_unlock(&enc->mutex);
-
-	return 0;
-
-err_m2m:
-	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
-err_fh:
-	v4l2_fh_exit(&ctx->fh);
-	mutex_unlock(&enc->mutex);
-err_free:
-	kfree(ctx);
-	return ret;
-}
-
-static int rkvenc_release(struct file *file)
-{
-	struct rkvenc_ctx *ctx = file_to_ctx(file);
-	struct rkvenc_dev *enc = ctx->enc;
-
-	mutex_lock(&enc->mutex);
-	v4l2_fh_del(&ctx->fh, file);
-	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
-	v4l2_ctrl_handler_free(&ctx->ctrl_handler);
-	v4l2_fh_exit(&ctx->fh);
-	mutex_unlock(&enc->mutex);
-
-	kfree(ctx);
-
-	return 0;
-}
