diff -uNr -x '.*' -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x modules.order -x Module.symvers -x Kconfig base/drivers/media/platform/rockchip/rkvenc/rkvenc-bits.c ktest/drivers/media/platform/rockchip/rkvenc/rkvenc-bits.c
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-bits.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-bits.c	2026-09-09 07:49:03.346099396 +0000
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bitstream writer for the Rockchip VEPU580 encoder driver.
+ *
+ * Copyright (C) 2026 Orange Pi 5B mainline project
+ */
+
+#include <linux/bits.h>
+#include <linux/export.h>
+#include <linux/minmax.h>
+#include <linux/string.h>
+
+#include "rkvenc-bits.h"
+
+void rkvenc_bits_init(struct rkvenc_bits *b, void *buf, size_t size)
+{
+	b->buf = buf;
+	b->size = size;
+	b->byte = 0;
+	b->bit = 0;
+	b->overflow = false;
+
+	if (size)
+		b->buf[0] = 0;
+}
+
+void rkvenc_put_bits(struct rkvenc_bits *b, u32 value, unsigned int n)
+{
+	if (b->overflow || !n || n > 32)
+		return;
+
+	/*
+	 * Masking here rather than trusting the caller keeps a stray high bit
+	 * from corrupting the field written just before it, which is the kind
+	 * of damage that shows up as a decoder rejecting the stream rather
+	 * than as anything visible at the call site.
+	 */
+	if (n < 32)
+		value &= BIT(n) - 1;
+
+	while (n) {
+		unsigned int room = 8 - b->bit;
+		unsigned int take = min(room, n);
+		u32 chunk = (value >> (n - take)) & ((1U << take) - 1);
+
+		if (b->byte >= b->size) {
+			b->overflow = true;
+			return;
+		}
+
+		b->buf[b->byte] |= chunk << (room - take);
+		b->bit += take;
+		n -= take;
+
+		if (b->bit == 8) {
+			b->byte++;
+			b->bit = 0;
+			if (b->byte < b->size)
+				b->buf[b->byte] = 0;
+		}
+	}
+}
+
+void rkvenc_put_ue(struct rkvenc_bits *b, u32 value)
+{
+	unsigned int bits = 0;
+	u32 v;
+
+	/*
+	 * codeNum is coded as a prefix of N zeroes, a one, then N bits.
+	 * N is the position of the top set bit of value + 1.
+	 */
+	for (v = value + 1; v > 1; v >>= 1)
+		bits++;
+
+	rkvenc_put_bits(b, 0, bits + 1 > 32 ? 32 : bits);
+	rkvenc_put_bits(b, 1, 1);
+	if (bits)
+		rkvenc_put_bits(b, value + 1, bits);
+}
+
+void rkvenc_put_se(struct rkvenc_bits *b, s32 value)
+{
+	/* Zig-zag: 0, 1, -1, 2, -2 ... map to codeNum 0, 1, 2, 3, 4 ... */
+	if (value <= 0)
+		rkvenc_put_ue(b, (u32)(-value) * 2);
+	else
+		rkvenc_put_ue(b, (u32)value * 2 - 1);
+}
+
+void rkvenc_put_trailing_bits(struct rkvenc_bits *b)
+{
+	rkvenc_put_bits(b, 1, 1);
+	while (b->bit)
+		rkvenc_put_bits(b, 0, 1);
+}
+
+size_t rkvenc_emit_nal(void *dst, size_t dst_size, u8 nal_ref_idc,
+		       u8 nal_unit_type, const void *rbsp, size_t rbsp_len)
+{
+	static const u8 start_code[] = { 0x00, 0x00, 0x00, 0x01 };
+	const u8 *in = rbsp;
+	u8 *out = dst;
+	size_t pos = 0;
+	unsigned int zeroes = 0;
+	size_t i;
+
+	if (dst_size < sizeof(start_code) + 1)
+		return 0;
+
+	memcpy(out, start_code, sizeof(start_code));
+	pos = sizeof(start_code);
+	out[pos++] = (nal_ref_idc & 0x3) << 5 | (nal_unit_type & 0x1f);
+
+	for (i = 0; i < rbsp_len; i++) {
+		/*
+		 * Emulation prevention: a decoder scans for start codes in the
+		 * payload, so any 00 00 0x with x < 4 gets a 03 inserted. Two
+		 * zeroes are enough to arm it -- three would miss the case
+		 * where the third byte is itself a zero that starts the next
+		 * pair.
+		 */
+		if (zeroes >= 2 && in[i] <= 0x03) {
+			if (pos >= dst_size)
+				return 0;
+			out[pos++] = 0x03;
+			zeroes = 0;
+		}
+
+		if (pos >= dst_size)
+			return 0;
+		out[pos++] = in[i];
+
+		if (in[i] == 0x00)
+			zeroes++;
+		else
+			zeroes = 0;
+	}
+
+	return pos;
+}
diff -uNr -x '.*' -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x modules.order -x Module.symvers -x Kconfig base/drivers/media/platform/rockchip/rkvenc/rkvenc-bits.h ktest/drivers/media/platform/rockchip/rkvenc/rkvenc-bits.h
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-bits.h	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-bits.h	2026-09-09 07:39:20.400055922 +0000
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Bitstream writer for the Rockchip VEPU580 encoder driver.
+ *
+ * Copyright (C) 2026 Orange Pi 5B mainline project
+ *
+ * VEPU580 produces slice data but not the sequence and picture parameter
+ * sets, so the driver has to compose those itself. Everything here is plain
+ * H.264 Annex B / RBSP bit packing with no knowledge of the hardware or of
+ * V4L2, which keeps it testable on its own.
+ */
+
+#ifndef _RKVENC_BITS_H_
+#define _RKVENC_BITS_H_
+
+#include <linux/types.h>
+
+/**
+ * struct rkvenc_bits - a big-endian bit cursor over a caller-owned buffer
+ * @buf:      destination, written most-significant bit first
+ * @size:     capacity in bytes
+ * @byte:     index of the byte being filled
+ * @bit:      bits already used in @byte, 0..7
+ * @overflow: set once a write did not fit; every later write is dropped
+ *
+ * The overflow flag means callers can emit a whole parameter set without
+ * checking each field, and test once at the end. A truncated set is never
+ * handed out: the caller sees the flag and fails the frame instead.
+ */
+struct rkvenc_bits {
+	u8 *buf;
+	size_t size;
+	size_t byte;
+	unsigned int bit;
+	bool overflow;
+};
+
+void rkvenc_bits_init(struct rkvenc_bits *b, void *buf, size_t size);
+
+/* Writes the low @n bits of @value, n in 1..32. */
+void rkvenc_put_bits(struct rkvenc_bits *b, u32 value, unsigned int n);
+
+/* Exp-Golomb, unsigned (ue(v)) and signed (se(v)) as in H.264 clause 9.1. */
+void rkvenc_put_ue(struct rkvenc_bits *b, u32 value);
+void rkvenc_put_se(struct rkvenc_bits *b, s32 value);
+
+/* rbsp_trailing_bits(): a one bit, then zeroes to the byte boundary. */
+void rkvenc_put_trailing_bits(struct rkvenc_bits *b);
+
+/* Bytes written so far; only meaningful once byte-aligned. */
+static inline size_t rkvenc_bits_len(const struct rkvenc_bits *b)
+{
+	return b->byte + (b->bit ? 1 : 0);
+}
+
+/**
+ * rkvenc_emit_nal - wrap an RBSP as an Annex B NAL unit
+ * @dst:      destination buffer
+ * @dst_size: capacity of @dst
+ * @nal_ref_idc:   0 for a non-reference NAL, non-zero otherwise
+ * @nal_unit_type: H.264 NAL type
+ * @rbsp:     raw byte sequence payload
+ * @rbsp_len: length of @rbsp
+ *
+ * Emits the four-byte start code, the NAL header byte and the payload with
+ * emulation prevention applied. Returns the number of bytes written, or 0 if
+ * the result would not fit.
+ */
+size_t rkvenc_emit_nal(void *dst, size_t dst_size, u8 nal_ref_idc,
+		       u8 nal_unit_type, const void *rbsp, size_t rbsp_len);
+
+#endif /* _RKVENC_BITS_H_ */
diff -uNr -x '.*' -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x modules.order -x Module.symvers -x Kconfig base/drivers/media/platform/rockchip/rkvenc/rkvenc-buf.c ktest/drivers/media/platform/rockchip/rkvenc/rkvenc-buf.c
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-buf.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-buf.c	2026-09-09 08:31:37.260729050 +0000
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Internal frame buffers for the Rockchip VEPU580 encoder driver.
+ *
+ * Copyright (C) 2026 Orange Pi 5B mainline project
+ */
+
+#include <linux/align.h>
+#include <linux/math.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+
+#include "rkvenc-buf.h"
+
+/*
+ * Reconstruction geometry. The block writes whole 64-byte-wide tiles and
+ * reads a little past the last macroblock row, so the coded height carries a
+ * spare band on top of macroblock alignment. Sizing to the visible picture
+ * instead lets the hardware write past the allocation.
+ */
+#define RKVENC_RECON_ALIGN_W		64
+#define RKVENC_RECON_ALIGN_H		16
+#define RKVENC_RECON_EXTRA_H		16
+
+/* Motion search reads the thumbnail as 64x64 blocks of 256 bytes. */
+#define RKVENC_THUMB_BLOCK		64
+#define RKVENC_THUMB_BLOCK_BYTES	256
+
+/*
+ * The line buffer only exists past a 4K-wide picture, where the block splits
+ * a row and has to carry filter state across the seam.
+ */
+#define RKVENC_EXT_LINE_THRESHOLD	SZ_4K
+#define RKVENC_EXT_LINE_RESERVED	(3 * SZ_1K)
+#define RKVENC_EXT_LINE_PER_UNIT	480
+
+u32 rkvenc_recon_width(u32 width)
+{
+	return ALIGN(width, RKVENC_RECON_ALIGN_W);
+}
+
+u32 rkvenc_recon_height(u32 height)
+{
+	return ALIGN(height, RKVENC_RECON_ALIGN_H) + RKVENC_RECON_EXTRA_H;
+}
+
+u32 rkvenc_fbc_hdr_size(u32 width, u32 height)
+{
+	/* One header byte per 64 pixels, rounded to the block's 8K granule. */
+	return ALIGN(rkvenc_recon_width(width) * rkvenc_recon_height(height) / 64,
+		     SZ_8K);
+}
+
+static u32 rkvenc_fbc_body_size(u32 width, u32 height)
+{
+	/* NV12: one luma byte and half a chroma byte per pixel. */
+	return rkvenc_recon_width(width) * rkvenc_recon_height(height) * 3 / 2;
+}
+
+u32 rkvenc_recon_size(u32 width, u32 height)
+{
+	return rkvenc_fbc_hdr_size(width, height) +
+	       rkvenc_fbc_body_size(width, height);
+}
+
+u32 rkvenc_thumb_size(u32 width, u32 height)
+{
+	/*
+	 * Round the block counts up. The coded height is a multiple of 16, not
+	 * of 64, so a truncating divide drops the last partial row of blocks
+	 * -- which the hardware still writes. At small pictures the 8K
+	 * rounding below hides the shortfall; at 1280x720 it faulted exactly
+	 * one byte past the end of this buffer.
+	 */
+	u32 blocks = DIV_ROUND_UP(rkvenc_recon_width(width),
+				  RKVENC_THUMB_BLOCK) *
+		     DIV_ROUND_UP(rkvenc_recon_height(height),
+				  RKVENC_THUMB_BLOCK);
+
+	return ALIGN(blocks * RKVENC_THUMB_BLOCK_BYTES, SZ_8K);
+}
+
+u32 rkvenc_ext_line_size(u32 width)
+{
+	u32 aligned = rkvenc_recon_width(width);
+
+	if (aligned <= RKVENC_EXT_LINE_THRESHOLD)
+		return 0;
+
+	return (aligned - RKVENC_EXT_LINE_RESERVED) / 64 *
+	       RKVENC_EXT_LINE_PER_UNIT;
+}
+
+static int rkvenc_alloc_one(struct device *dev, struct rkvenc_dma_buf *buf,
+			    size_t size)
+{
+	if (!size)
+		return 0;
+
+	buf->cpu = dma_alloc_attrs(dev, size, &buf->dma, GFP_KERNEL,
+				   DMA_ATTR_NO_KERNEL_MAPPING);
+	if (!buf->cpu)
+		return -ENOMEM;
+
+	buf->size = size;
+
+	return 0;
+}
+
+static void rkvenc_free_one(struct device *dev, struct rkvenc_dma_buf *buf)
+{
+	if (!buf->cpu)
+		return;
+
+	dma_free_attrs(dev, buf->size, buf->cpu, buf->dma,
+		       DMA_ATTR_NO_KERNEL_MAPPING);
+	memset(buf, 0, sizeof(*buf));
+}
+
+void rkvenc_frame_bufs_free(struct device *dev, struct rkvenc_frame_bufs *bufs)
+{
+	unsigned int i;
+
+	for (i = 0; i < RKVENC_NUM_RECON; i++) {
+		rkvenc_free_one(dev, &bufs->recon[i].pixel);
+		rkvenc_free_one(dev, &bufs->recon[i].thumb);
+	}
+	rkvenc_free_one(dev, &bufs->ext_line);
+
+	bufs->fbc_hdr_size = 0;
+	bufs->width = 0;
+	bufs->height = 0;
+}
+
+int rkvenc_frame_bufs_alloc(struct device *dev, struct rkvenc_frame_bufs *bufs,
+			    u32 width, u32 height)
+{
+	size_t pixel, thumb, ext;
+	unsigned int i;
+	int ret;
+
+	if (bufs->width == width && bufs->height == height &&
+	    bufs->recon[0].pixel.cpu)
+		return 0;
+
+	rkvenc_frame_bufs_free(dev, bufs);
+
+	pixel = rkvenc_recon_size(width, height);
+	thumb = rkvenc_thumb_size(width, height);
+	ext = rkvenc_ext_line_size(width);
+
+	for (i = 0; i < RKVENC_NUM_RECON; i++) {
+		ret = rkvenc_alloc_one(dev, &bufs->recon[i].pixel, pixel);
+		if (ret)
+			goto err;
+		ret = rkvenc_alloc_one(dev, &bufs->recon[i].thumb, thumb);
+		if (ret)
+			goto err;
+	}
+
+	ret = rkvenc_alloc_one(dev, &bufs->ext_line, ext);
+	if (ret)
+		goto err;
+
+	bufs->fbc_hdr_size = rkvenc_fbc_hdr_size(width, height);
+	bufs->width = width;
+	bufs->height = height;
+
+	dev_info(dev,
+		"frame bufs for %ux%u: recon %zu x%u (fbc hdr %u), thumb %zu, ext %zu\n",
+		width, height, pixel, RKVENC_NUM_RECON, bufs->fbc_hdr_size,
+		thumb, ext);
+
+	return 0;
+
+err:
+	/*
+	 * These are contiguous DMA allocations of several megabytes each, so
+	 * partial success is a real outcome on a fragmented CMA pool. Give
+	 * back whatever landed rather than leaving the context half armed.
+	 */
+	dev_err(dev, "cannot allocate %ux%u frame buffers\n", width, height);
+	rkvenc_frame_bufs_free(dev, bufs);
+
+	return ret;
+}
diff -uNr -x '.*' -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x modules.order -x Module.symvers -x Kconfig base/drivers/media/platform/rockchip/rkvenc/rkvenc-buf.h ktest/drivers/media/platform/rockchip/rkvenc/rkvenc-buf.h
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-buf.h	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-buf.h	2026-09-09 07:51:57.319523135 +0000
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Internal frame buffers for the Rockchip VEPU580 encoder driver.
+ *
+ * Copyright (C) 2026 Orange Pi 5B mainline project
+ *
+ * Beyond the source picture and the bitstream, which come from userspace as
+ * vb2 buffers, the block needs memory of its own: a reconstruction of each
+ * coded frame to predict the next one from, a downscaled copy of it that
+ * motion estimation searches first, and on wide pictures a line buffer that
+ * carries state across the horizontal split.
+ *
+ * These are sized from the coded picture, not the visible one, and the
+ * geometry rules come from the hardware -- see rkvenc-regs.h for where the
+ * register and layout facts were taken from.
+ */
+
+#ifndef _RKVENC_BUF_H_
+#define _RKVENC_BUF_H_
+
+#include <linux/types.h>
+
+struct device;
+
+/* Reconstruction is double buffered: encode into one while predicting from
+ * the other. Two is the minimum for P pictures and all this driver needs,
+ * because it never references more than the previous frame.
+ */
+#define RKVENC_NUM_RECON		2
+
+struct rkvenc_dma_buf {
+	void *cpu;
+	dma_addr_t dma;
+	size_t size;
+};
+
+struct rkvenc_recon {
+	struct rkvenc_dma_buf pixel;	/* FBC header followed by body */
+	struct rkvenc_dma_buf thumb;	/* 1/64 scale, for motion search */
+};
+
+/**
+ * struct rkvenc_frame_bufs - everything the block allocates per context
+ * @recon:        reconstruction pair, indexed by rkvenc_frame_bufs_cur()
+ * @ext_line:     wide-picture line buffer, unallocated when not needed
+ * @fbc_hdr_size: offset of the FBC body within each @recon pixel buffer
+ * @width:        coded width the allocation was sized for
+ * @height:       coded height the allocation was sized for
+ */
+struct rkvenc_frame_bufs {
+	struct rkvenc_recon recon[RKVENC_NUM_RECON];
+	struct rkvenc_dma_buf ext_line;
+	u32 fbc_hdr_size;
+	u32 width;
+	u32 height;
+};
+
+/*
+ * Allocate for a coded picture of @width x @height. Safe to call when
+ * already allocated for the same size: it returns 0 without touching
+ * anything, so a stream that stops and starts does not churn CMA.
+ */
+int rkvenc_frame_bufs_alloc(struct device *dev, struct rkvenc_frame_bufs *bufs,
+			    u32 width, u32 height);
+void rkvenc_frame_bufs_free(struct device *dev, struct rkvenc_frame_bufs *bufs);
+
+/* Sizing rules, exposed so the register path and tests can agree with them. */
+u32 rkvenc_recon_width(u32 width);
+u32 rkvenc_recon_height(u32 height);
+u32 rkvenc_fbc_hdr_size(u32 width, u32 height);
+u32 rkvenc_recon_size(u32 width, u32 height);
+u32 rkvenc_thumb_size(u32 width, u32 height);
+u32 rkvenc_ext_line_size(u32 width);
+
+#endif /* _RKVENC_BUF_H_ */
diff -uNr -x '.*' -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x modules.order -x Module.symvers -x Kconfig base/drivers/media/platform/rockchip/rkvenc/rkvenc-core.c ktest/drivers/media/platform/rockchip/rkvenc/rkvenc-core.c
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-core.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-core.c	2026-09-09 08:49:39.497692058 +0000
@@ -0,0 +1,1430 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Rockchip VEPU580 (RKVENC) H.264 encoder driver
+ *
+ * Copyright (C) 2026 Orange Pi 5B mainline project
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/reset.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+#include <linux/slab.h>
+#include <linux/videodev2.h>
+
+#include <media/v4l2-common.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-fh.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+#include <media/videobuf2-v4l2.h>
+
+#include "rkvenc-buf.h"
+#include "rkvenc-regs.h"
+#include "rkvenc-h264.h"
+#include "rkvenc-hw.h"
+
+#define RKVENC_NAME			"rockchip-rkvenc"
+#define RKVENC_CARD_NAME		"Rockchip VEPU580 encoder"
+
+#define RKVENC_MIN_WIDTH		128U
+#define RKVENC_MIN_HEIGHT		96U
+#define RKVENC_MAX_WIDTH		4096U
+#define RKVENC_MAX_HEIGHT		4096U
+#define RKVENC_DEFAULT_WIDTH		1920U
+#define RKVENC_DEFAULT_HEIGHT		1080U
+#define RKVENC_MB_DIM			16U
+
+#define RKVENC_MIN_BITSTREAM_SIZE	SZ_512K
+#define RKVENC_MAX_BITSTREAM_SIZE	SZ_16M
+#define RKVENC_DEFAULT_BITRATE		12000000
+#define RKVENC_DEFAULT_GOP_SIZE		60
+#define RKVENC_DEFAULT_QP		26
+
+/* Generous next to a frame time, short next to a user noticing a stall. */
+#define RKVENC_JOB_TIMEOUT_MS		500
+
+/* Both are four-bit fields in the block's SPS register. */
+#define RKVENC_LOG2_MAX_FRAME_NUM_M4	12
+#define RKVENC_LOG2_MAX_POC_LSB_M4	12
+#define RKVENC_DEFAULT_FPS		60
+
+#define RKVENC_NUM_CLKS			3
+#define RKVENC_NUM_RESETS		3
+
+struct rkvenc_fmt {
+	u32 fourcc;
+	bool coded;
+};
+
+struct rkvenc_dev {
+	struct device *dev;
+	struct v4l2_device v4l2_dev;
+	struct video_device vfd;
+	struct v4l2_m2m_dev *m2m_dev;
+	void __iomem *regs;
+	struct clk_bulk_data clks[RKVENC_NUM_CLKS];
+	struct reset_control_bulk_data resets[RKVENC_NUM_RESETS];
+	struct mutex mutex;
+	int irq;
+	u32 hw_id;
+
+	/*
+	 * A job that never raises its interrupt must not hold the machine.
+	 * Whoever wins this flag -- the interrupt or the watchdog -- owns
+	 * finishing the job, so the two can never both complete it.
+	 */
+	struct delayed_work watchdog;
+	atomic_t job_active;
+	/* Serializes job launch against abort, IRQ and watchdog ownership. */
+	spinlock_t job_lock;
+};
+
+struct rkvenc_ctx {
+	struct v4l2_fh fh;
+	struct rkvenc_dev *enc;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_pix_format_mplane src_fmt;
+	struct v4l2_pix_format_mplane dst_fmt;
+	struct v4l2_rect crop;
+	u32 bitrate;
+	u32 gop_size;
+	u32 fps_num;
+	u32 fps_den;
+	u32 sequence_out;
+	u32 sequence_cap;
+
+	/* Reconstruction and scratch memory, sized from the coded picture. */
+	struct rkvenc_frame_bufs bufs;
+
+	/* Coding state carried from one frame to the next. */
+	u32 frame_cnt;		/* frames since the last IDR */
+	u16 idr_pic_id;		/* alternates so two IDRs never look alike */
+	unsigned int recon_idx;	/* which reconstruction slot to write */
+	u8 profile_idc;
+	u8 qp;
+	bool force_key_frame;
+	bool aborting;
+	u32 job_hdr_bytes;	/* software headers at the front of this frame */
+};
+
+static const struct rkvenc_fmt rkvenc_raw_fmts[] = {
+	{ .fourcc = V4L2_PIX_FMT_NV12 },
+};
+
+static const struct rkvenc_fmt rkvenc_coded_fmts[] = {
+	{ .fourcc = V4L2_PIX_FMT_H264, .coded = true },
+};
+
+static inline struct rkvenc_ctx *file_to_ctx(struct file *file)
+{
+	return container_of(file_to_v4l2_fh(file), struct rkvenc_ctx, fh);
+}
+
+static inline u32 rkvenc_read(struct rkvenc_dev *enc, u32 reg)
+{
+	return readl(enc->regs + reg);
+}
+
+static inline void rkvenc_write(struct rkvenc_dev *enc, u32 reg, u32 val)
+{
+	writel(val, enc->regs + reg);
+}
+
+static const struct rkvenc_fmt *rkvenc_find_fmt(u32 fourcc, bool coded)
+{
+	const struct rkvenc_fmt *fmts = coded ? rkvenc_coded_fmts : rkvenc_raw_fmts;
+	unsigned int num_fmts = coded ? ARRAY_SIZE(rkvenc_coded_fmts) :
+					ARRAY_SIZE(rkvenc_raw_fmts);
+	unsigned int i;
+
+	for (i = 0; i < num_fmts; i++) {
+		if (fmts[i].fourcc == fourcc)
+			return &fmts[i];
+	}
+
+	return NULL;
+}
+
+static void rkvenc_bound_dimensions(u32 *width, u32 *height)
+{
+	*width = clamp_t(u32, *width, RKVENC_MIN_WIDTH, RKVENC_MAX_WIDTH);
+	*height = clamp_t(u32, *height, RKVENC_MIN_HEIGHT, RKVENC_MAX_HEIGHT);
+	*width = ALIGN(*width, RKVENC_MB_DIM);
+	*height = ALIGN(*height, RKVENC_MB_DIM);
+}
+
+static u32 rkvenc_coded_sizeimage(u32 width, u32 height)
+{
+	u32 size = width * height;
+
+	return clamp_t(u32, size, RKVENC_MIN_BITSTREAM_SIZE,
+		       RKVENC_MAX_BITSTREAM_SIZE);
+}
+
+static void rkvenc_fill_raw_fmt(struct v4l2_pix_format_mplane *pix)
+{
+	u32 width = pix->width;
+	u32 height = pix->height;
+	u32 colorspace = pix->colorspace;
+	u32 ycbcr_enc = pix->ycbcr_enc;
+	u32 quantization = pix->quantization;
+	u32 xfer_func = pix->xfer_func;
+
+	rkvenc_bound_dimensions(&width, &height);
+	memset(pix, 0, sizeof(*pix));
+	pix->width = width;
+	pix->height = height;
+	pix->pixelformat = V4L2_PIX_FMT_NV12;
+	pix->field = V4L2_FIELD_NONE;
+	pix->colorspace = colorspace ?: V4L2_COLORSPACE_REC709;
+	pix->ycbcr_enc = ycbcr_enc ?: V4L2_YCBCR_ENC_DEFAULT;
+	pix->quantization = quantization ?: V4L2_QUANTIZATION_LIM_RANGE;
+	pix->xfer_func = xfer_func ?: V4L2_XFER_FUNC_DEFAULT;
+	v4l2_fill_pixfmt_mp(pix, pix->pixelformat, width, height);
+}
+
+static void rkvenc_fill_coded_fmt(struct v4l2_pix_format_mplane *pix)
+{
+	u32 width = pix->width;
+	u32 height = pix->height;
+	u32 colorspace = pix->colorspace;
+	u32 ycbcr_enc = pix->ycbcr_enc;
+	u32 quantization = pix->quantization;
+	u32 xfer_func = pix->xfer_func;
+
+	rkvenc_bound_dimensions(&width, &height);
+	memset(pix, 0, sizeof(*pix));
+	pix->width = width;
+	pix->height = height;
+	pix->pixelformat = V4L2_PIX_FMT_H264;
+	pix->field = V4L2_FIELD_NONE;
+	pix->colorspace = colorspace ?: V4L2_COLORSPACE_REC709;
+	pix->ycbcr_enc = ycbcr_enc ?: V4L2_YCBCR_ENC_DEFAULT;
+	pix->quantization = quantization ?: V4L2_QUANTIZATION_LIM_RANGE;
+	pix->xfer_func = xfer_func ?: V4L2_XFER_FUNC_DEFAULT;
+	pix->num_planes = 1;
+	pix->plane_fmt[0].bytesperline = 0;
+	pix->plane_fmt[0].sizeimage = rkvenc_coded_sizeimage(width, height);
+}
+
+static int rkvenc_querycap(struct file *file, void *priv,
+			   struct v4l2_capability *cap)
+{
+	struct rkvenc_dev *enc = video_drvdata(file);
+
+	strscpy(cap->driver, RKVENC_NAME, sizeof(cap->driver));
+	strscpy(cap->card, RKVENC_CARD_NAME, sizeof(cap->card));
+	snprintf(cap->bus_info, sizeof(cap->bus_info), "platform:%s",
+		 dev_name(enc->dev));
+
+	return 0;
+}
+
+static int rkvenc_enum_fmt(struct file *file, void *priv,
+			   struct v4l2_fmtdesc *f)
+{
+	const struct rkvenc_fmt *fmts;
+	unsigned int num_fmts;
+	bool coded = V4L2_TYPE_IS_CAPTURE(f->type);
+
+	fmts = coded ? rkvenc_coded_fmts : rkvenc_raw_fmts;
+	num_fmts = coded ? ARRAY_SIZE(rkvenc_coded_fmts) :
+			   ARRAY_SIZE(rkvenc_raw_fmts);
+
+	if (f->index >= num_fmts)
+		return -EINVAL;
+
+	f->pixelformat = fmts[f->index].fourcc;
+
+	return 0;
+}
+
+static int rkvenc_enum_framesizes(struct file *file, void *fh,
+				  struct v4l2_frmsizeenum *fsize)
+{
+	bool supported;
+
+	if (fsize->index)
+		return -EINVAL;
+
+	supported = rkvenc_find_fmt(fsize->pixel_format, false) ||
+		    rkvenc_find_fmt(fsize->pixel_format, true);
+	if (!supported)
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = RKVENC_MIN_WIDTH;
+	fsize->stepwise.max_width = RKVENC_MAX_WIDTH;
+	fsize->stepwise.step_width = RKVENC_MB_DIM;
+	fsize->stepwise.min_height = RKVENC_MIN_HEIGHT;
+	fsize->stepwise.max_height = RKVENC_MAX_HEIGHT;
+	fsize->stepwise.step_height = RKVENC_MB_DIM;
+
+	return 0;
+}
+
+static int rkvenc_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct rkvenc_ctx *ctx = file_to_ctx(file);
+	struct v4l2_pix_format_mplane *pix = &f->fmt.pix_mp;
+	bool coded = V4L2_TYPE_IS_CAPTURE(f->type);
+
+	if (coded) {
+		if (!rkvenc_find_fmt(pix->pixelformat, true))
+			pix->pixelformat = V4L2_PIX_FMT_H264;
+		if (!pix->width)
+			pix->width = ctx->src_fmt.width;
+		if (!pix->height)
+			pix->height = ctx->src_fmt.height;
+		rkvenc_fill_coded_fmt(pix);
+	} else {
+		if (!rkvenc_find_fmt(pix->pixelformat, false))
+			pix->pixelformat = V4L2_PIX_FMT_NV12;
+		rkvenc_fill_raw_fmt(pix);
+	}
+
+	return 0;
+}
+
+static int rkvenc_g_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct rkvenc_ctx *ctx = file_to_ctx(file);
+
+	f->fmt.pix_mp = V4L2_TYPE_IS_CAPTURE(f->type) ? ctx->dst_fmt :
+						 ctx->src_fmt;
+
+	return 0;
+}
+
+static int rkvenc_s_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct rkvenc_ctx *ctx = file_to_ctx(file);
+	struct vb2_queue *vq = v4l2_m2m_get_vq(ctx->fh.m2m_ctx, f->type);
+	int ret;
+
+	if (vb2_is_busy(vq))
+		return -EBUSY;
+
+	ret = rkvenc_try_fmt(file, priv, f);
+	if (ret)
+		return ret;
+
+	if (V4L2_TYPE_IS_CAPTURE(f->type)) {
+		ctx->dst_fmt = f->fmt.pix_mp;
+		return 0;
+	}
+
+	ctx->src_fmt = f->fmt.pix_mp;
+	ctx->crop.left = 0;
+	ctx->crop.top = 0;
+	ctx->crop.width = ctx->src_fmt.width;
+	ctx->crop.height = ctx->src_fmt.height;
+
+	ctx->dst_fmt.width = ctx->src_fmt.width;
+	ctx->dst_fmt.height = ctx->src_fmt.height;
+	rkvenc_fill_coded_fmt(&ctx->dst_fmt);
+
+	return 0;
+}
+
+static int rkvenc_g_selection(struct file *file, void *fh,
+			      struct v4l2_selection *s)
+{
+	struct rkvenc_ctx *ctx = file_to_ctx(file);
+
+	if (!V4L2_TYPE_IS_OUTPUT(s->type))
+		return -EINVAL;
+
+	switch (s->target) {
+	case V4L2_SEL_TGT_CROP:
+		s->r = ctx->crop;
+		break;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		s->r.left = 0;
+		s->r.top = 0;
+		s->r.width = ctx->src_fmt.width;
+		s->r.height = ctx->src_fmt.height;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int rkvenc_s_selection(struct file *file, void *fh,
+			      struct v4l2_selection *s)
+{
+	struct rkvenc_ctx *ctx = file_to_ctx(file);
+	struct vb2_queue *vq;
+
+	if (!V4L2_TYPE_IS_OUTPUT(s->type) || s->target != V4L2_SEL_TGT_CROP)
+		return -EINVAL;
+
+	vq = v4l2_m2m_get_src_vq(ctx->fh.m2m_ctx);
+	if (vb2_is_busy(vq))
+		return -EBUSY;
+
+	s->r.left = 0;
+	s->r.top = 0;
+	s->r.width = clamp_t(u32, s->r.width, RKVENC_MIN_WIDTH,
+			     ctx->src_fmt.width);
+	s->r.height = clamp_t(u32, s->r.height, RKVENC_MIN_HEIGHT,
+			      ctx->src_fmt.height);
+	s->r.width = ALIGN(s->r.width, RKVENC_MB_DIM);
+	s->r.height = ALIGN(s->r.height, RKVENC_MB_DIM);
+	if (s->r.width > ctx->src_fmt.width)
+		s->r.width = ctx->src_fmt.width;
+	if (s->r.height > ctx->src_fmt.height)
+		s->r.height = ctx->src_fmt.height;
+
+	ctx->crop = s->r;
+
+	return 0;
+}
+
+static int rkvenc_g_parm(struct file *file, void *fh,
+			 struct v4l2_streamparm *a)
+{
+	struct rkvenc_ctx *ctx = file_to_ctx(file);
+
+	if (!V4L2_TYPE_IS_OUTPUT(a->type))
+		return -EINVAL;
+
+	a->parm.output.capability = V4L2_CAP_TIMEPERFRAME;
+	a->parm.output.timeperframe.numerator = ctx->fps_den;
+	a->parm.output.timeperframe.denominator = ctx->fps_num;
+
+	return 0;
+}
+
+static int rkvenc_s_parm(struct file *file, void *fh,
+			 struct v4l2_streamparm *a)
+{
+	struct rkvenc_ctx *ctx = file_to_ctx(file);
+	struct v4l2_fract *tpf = &a->parm.output.timeperframe;
+
+	if (!V4L2_TYPE_IS_OUTPUT(a->type))
+		return -EINVAL;
+
+	if (tpf->numerator && tpf->denominator) {
+		ctx->fps_den = tpf->numerator;
+		ctx->fps_num = tpf->denominator;
+	}
+
+	return rkvenc_g_parm(file, fh, a);
+}
+
+static int rkvenc_encoder_cmd(struct file *file, void *priv,
+			      struct v4l2_encoder_cmd *ec)
+{
+	struct rkvenc_ctx *ctx = file_to_ctx(file);
+	int ret;
+
+	ret = v4l2_m2m_ioctl_try_encoder_cmd(file, priv, ec);
+	if (ret)
+		return ret;
+
+	ret = v4l2_m2m_ioctl_encoder_cmd(file, priv, ec);
+	if (ret)
+		return ret;
+
+	if (ec->cmd == V4L2_ENC_CMD_STOP &&
+	    v4l2_m2m_has_stopped(ctx->fh.m2m_ctx))
+		v4l2_event_queue_fh(&ctx->fh,
+				     &(const struct v4l2_event) {
+					.type = V4L2_EVENT_EOS,
+				     });
+
+	return 0;
+}
+
+static int rkvenc_subscribe_event(struct v4l2_fh *fh,
+				  const struct v4l2_event_subscription *sub)
+{
+	switch (sub->type) {
+	case V4L2_EVENT_EOS:
+		return v4l2_event_subscribe(fh, sub, 0, NULL);
+	default:
+		return v4l2_ctrl_subscribe_event(fh, sub);
+	}
+}
+
+static const struct v4l2_ioctl_ops rkvenc_ioctl_ops = {
+	.vidioc_querycap		= rkvenc_querycap,
+	.vidioc_enum_fmt_vid_cap	= rkvenc_enum_fmt,
+	.vidioc_enum_fmt_vid_out	= rkvenc_enum_fmt,
+	.vidioc_enum_framesizes		= rkvenc_enum_framesizes,
+	.vidioc_g_fmt_vid_cap_mplane	= rkvenc_g_fmt,
+	.vidioc_g_fmt_vid_out_mplane	= rkvenc_g_fmt,
+	.vidioc_try_fmt_vid_cap_mplane	= rkvenc_try_fmt,
+	.vidioc_try_fmt_vid_out_mplane	= rkvenc_try_fmt,
+	.vidioc_s_fmt_vid_cap_mplane	= rkvenc_s_fmt,
+	.vidioc_s_fmt_vid_out_mplane	= rkvenc_s_fmt,
+	.vidioc_g_selection		= rkvenc_g_selection,
+	.vidioc_s_selection		= rkvenc_s_selection,
+	.vidioc_g_parm			= rkvenc_g_parm,
+	.vidioc_s_parm			= rkvenc_s_parm,
+	.vidioc_reqbufs			= v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf		= v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf			= v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf			= v4l2_m2m_ioctl_dqbuf,
+	.vidioc_prepare_buf		= v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs		= v4l2_m2m_ioctl_create_bufs,
+	.vidioc_expbuf			= v4l2_m2m_ioctl_expbuf,
+	.vidioc_streamon		= v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff		= v4l2_m2m_ioctl_streamoff,
+	.vidioc_try_encoder_cmd		= v4l2_m2m_ioctl_try_encoder_cmd,
+	.vidioc_encoder_cmd		= rkvenc_encoder_cmd,
+	.vidioc_subscribe_event		= rkvenc_subscribe_event,
+	.vidioc_unsubscribe_event	= v4l2_event_unsubscribe,
+};
+
+static int rkvenc_queue_setup(struct vb2_queue *vq, unsigned int *num_buffers,
+			      unsigned int *num_planes, unsigned int sizes[],
+			      struct device *alloc_devs[])
+{
+	struct rkvenc_ctx *ctx = vb2_get_drv_priv(vq);
+	struct v4l2_pix_format_mplane *pix;
+
+	pix = V4L2_TYPE_IS_CAPTURE(vq->type) ? &ctx->dst_fmt : &ctx->src_fmt;
+
+	if (*num_planes) {
+		if (*num_planes != pix->num_planes ||
+		    sizes[0] < pix->plane_fmt[0].sizeimage)
+			return -EINVAL;
+		return 0;
+	}
+
+	*num_planes = pix->num_planes;
+	sizes[0] = pix->plane_fmt[0].sizeimage;
+
+	return 0;
+}
+
+static int rkvenc_buf_prepare(struct vb2_buffer *vb)
+{
+	struct rkvenc_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+	struct v4l2_pix_format_mplane *pix;
+
+	pix = V4L2_TYPE_IS_CAPTURE(vb->vb2_queue->type) ? &ctx->dst_fmt :
+							   &ctx->src_fmt;
+	if (vb2_plane_size(vb, 0) < pix->plane_fmt[0].sizeimage)
+		return -EINVAL;
+
+	if (V4L2_TYPE_IS_OUTPUT(vb->vb2_queue->type))
+		vb2_set_plane_payload(vb, 0, pix->plane_fmt[0].sizeimage);
+
+	return 0;
+}
+
+static int rkvenc_buf_out_validate(struct vb2_buffer *vb)
+{
+	to_vb2_v4l2_buffer(vb)->field = V4L2_FIELD_NONE;
+
+	return 0;
+}
+
+static void rkvenc_buf_queue(struct vb2_buffer *vb)
+{
+	struct rkvenc_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, to_vb2_v4l2_buffer(vb));
+}
+
+static void rkvenc_return_bufs(struct rkvenc_ctx *ctx, struct vb2_queue *vq,
+			       enum vb2_buffer_state state)
+{
+	struct vb2_v4l2_buffer *vbuf;
+
+	for (;;) {
+		if (V4L2_TYPE_IS_CAPTURE(vq->type))
+			vbuf = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+		else
+			vbuf = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx);
+		if (!vbuf)
+			break;
+		v4l2_m2m_buf_done(vbuf, state);
+	}
+}
+
+static int rkvenc_start_streaming(struct vb2_queue *vq, unsigned int count)
+{
+	struct rkvenc_ctx *ctx = vb2_get_drv_priv(vq);
+	unsigned long flags;
+	int ret;
+
+	/* A completed STREAMOFF makes the context eligible for jobs again. */
+	spin_lock_irqsave(&ctx->enc->job_lock, flags);
+	ctx->aborting = false;
+	spin_unlock_irqrestore(&ctx->enc->job_lock, flags);
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type))
+		ctx->sequence_out = 0;
+	else
+		ctx->sequence_cap = 0;
+
+	ret = pm_runtime_resume_and_get(ctx->enc->dev);
+	if (ret < 0) {
+		rkvenc_return_bufs(ctx, vq, VB2_BUF_STATE_QUEUED);
+		return ret;
+	}
+
+	/*
+	 * The block needs its own reconstruction memory, sized from the coded
+	 * picture rather than the visible one. Doing it here rather than at
+	 * S_FMT means several megabytes of CMA are only taken once a client
+	 * actually streams, and the coded geometry is settled by now.
+	 */
+	if (V4L2_TYPE_IS_OUTPUT(vq->type)) {
+		ret = rkvenc_frame_bufs_alloc(ctx->enc->dev, &ctx->bufs,
+					      ctx->src_fmt.width,
+					      ctx->src_fmt.height);
+		if (ret) {
+			pm_runtime_put(ctx->enc->dev);
+			rkvenc_return_bufs(ctx, vq, VB2_BUF_STATE_QUEUED);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static void rkvenc_stop_streaming(struct vb2_queue *vq)
+{
+	struct rkvenc_ctx *ctx = vb2_get_drv_priv(vq);
+
+	rkvenc_return_bufs(ctx, vq, VB2_BUF_STATE_ERROR);
+	pm_runtime_put(ctx->enc->dev);
+}
+
+static const struct vb2_ops rkvenc_qops = {
+	.queue_setup		= rkvenc_queue_setup,
+	.buf_out_validate	= rkvenc_buf_out_validate,
+	.buf_prepare		= rkvenc_buf_prepare,
+	.buf_queue		= rkvenc_buf_queue,
+	.start_streaming	= rkvenc_start_streaming,
+	.stop_streaming		= rkvenc_stop_streaming,
+};
+
+static int rkvenc_queue_init(void *priv, struct vb2_queue *src_vq,
+			     struct vb2_queue *dst_vq)
+{
+	struct rkvenc_ctx *ctx = priv;
+	int ret;
+
+	src_vq->type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+	src_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	src_vq->drv_priv = ctx;
+	src_vq->ops = &rkvenc_qops;
+	src_vq->mem_ops = &vb2_dma_contig_memops;
+	src_vq->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	src_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	src_vq->lock = &ctx->enc->mutex;
+	src_vq->dev = ctx->enc->dev;
+
+	ret = vb2_queue_init(src_vq);
+	if (ret)
+		return ret;
+
+	dst_vq->type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+	dst_vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	dst_vq->drv_priv = ctx;
+	dst_vq->ops = &rkvenc_qops;
+	dst_vq->mem_ops = &vb2_dma_contig_memops;
+	dst_vq->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	dst_vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	dst_vq->lock = &ctx->enc->mutex;
+	dst_vq->dev = ctx->enc->dev;
+
+	return vb2_queue_init(dst_vq);
+}
+
+static int rkvenc_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct rkvenc_ctx *ctx =
+		container_of(ctrl->handler, struct rkvenc_ctx, ctrl_handler);
+
+	switch (ctrl->id) {
+	case V4L2_CID_MPEG_VIDEO_BITRATE:
+		ctx->bitrate = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_GOP_SIZE:
+		ctx->gop_size = ctrl->val;
+		break;
+	case V4L2_CID_MPEG_VIDEO_H264_PROFILE:
+		switch (ctrl->val) {
+		case V4L2_MPEG_VIDEO_H264_PROFILE_CONSTRAINED_BASELINE:
+		case V4L2_MPEG_VIDEO_H264_PROFILE_BASELINE:
+			ctx->profile_idc = RKVENC_H264_PROFILE_BASELINE;
+			break;
+		case V4L2_MPEG_VIDEO_H264_PROFILE_MAIN:
+			ctx->profile_idc = RKVENC_H264_PROFILE_MAIN;
+			break;
+		default:
+			ctx->profile_idc = RKVENC_H264_PROFILE_HIGH;
+			break;
+		}
+		break;
+	case V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME:
+		/*
+		 * A button control: the value carries nothing, the write is
+		 * the request. Cleared once the frame it asked for is coded.
+		 */
+		ctx->force_key_frame = true;
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops rkvenc_ctrl_ops = {
+	.s_ctrl = rkvenc_s_ctrl,
+};
+
+static int rkvenc_setup_ctrls(struct rkvenc_ctx *ctx)
+{
+	struct v4l2_ctrl_handler *hdl = &ctx->ctrl_handler;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 16);
+
+	v4l2_ctrl_new_std(hdl, &rkvenc_ctrl_ops, V4L2_CID_MPEG_VIDEO_BITRATE,
+			  10000, 200000000, 1, RKVENC_DEFAULT_BITRATE);
+	v4l2_ctrl_new_std(hdl, &rkvenc_ctrl_ops, V4L2_CID_MPEG_VIDEO_GOP_SIZE,
+			  0, 1000, 1, RKVENC_DEFAULT_GOP_SIZE);
+	v4l2_ctrl_new_std(hdl, &rkvenc_ctrl_ops,
+			  V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME, 0, 0, 0, 0);
+	v4l2_ctrl_new_std_menu(hdl, &rkvenc_ctrl_ops,
+			       V4L2_CID_MPEG_VIDEO_BITRATE_MODE,
+			       V4L2_MPEG_VIDEO_BITRATE_MODE_CQ,
+			       ~(BIT(V4L2_MPEG_VIDEO_BITRATE_MODE_VBR) |
+				 BIT(V4L2_MPEG_VIDEO_BITRATE_MODE_CBR) |
+				 BIT(V4L2_MPEG_VIDEO_BITRATE_MODE_CQ)),
+			       V4L2_MPEG_VIDEO_BITRATE_MODE_CBR);
+	v4l2_ctrl_new_std_menu(hdl, &rkvenc_ctrl_ops,
+			       V4L2_CID_MPEG_VIDEO_H264_PROFILE,
+			       V4L2_MPEG_VIDEO_H264_PROFILE_HIGH,
+			       BIT(V4L2_MPEG_VIDEO_H264_PROFILE_EXTENDED),
+			       V4L2_MPEG_VIDEO_H264_PROFILE_HIGH);
+	v4l2_ctrl_new_std_menu(hdl, &rkvenc_ctrl_ops,
+			       V4L2_CID_MPEG_VIDEO_H264_LEVEL,
+			       V4L2_MPEG_VIDEO_H264_LEVEL_5_1, 0,
+			       V4L2_MPEG_VIDEO_H264_LEVEL_4_0);
+	v4l2_ctrl_new_std(hdl, &rkvenc_ctrl_ops,
+			  V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE, 0, 1, 1, 1);
+	v4l2_ctrl_new_std(hdl, &rkvenc_ctrl_ops,
+			  V4L2_CID_MPEG_VIDEO_MB_RC_ENABLE, 0, 1, 1, 1);
+	v4l2_ctrl_new_std(hdl, &rkvenc_ctrl_ops,
+			  V4L2_CID_MPEG_VIDEO_PREPEND_SPSPPS_TO_IDR,
+			  0, 1, 1, 1);
+
+	ctrl = v4l2_ctrl_new_std(hdl, &rkvenc_ctrl_ops,
+				 V4L2_CID_MIN_BUFFERS_FOR_OUTPUT, 1, 32, 1, 1);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	ctx->fh.ctrl_handler = hdl;
+
+	return v4l2_ctrl_handler_setup(hdl);
+}
+
+static int rkvenc_open(struct file *file)
+{
+	struct rkvenc_dev *enc = video_drvdata(file);
+	struct rkvenc_ctx *ctx;
+	int ret;
+
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->enc = enc;
+	ctx->bitrate = RKVENC_DEFAULT_BITRATE;
+	ctx->gop_size = RKVENC_DEFAULT_GOP_SIZE;
+	/*
+	 * Until rate control runs, this QP is what every macroblock gets, so
+	 * it has to be a sane picture rather than a placeholder: zero would
+	 * ask for near-lossless coding and overrun any bitstream buffer.
+	 */
+	ctx->qp = RKVENC_DEFAULT_QP;
+	ctx->profile_idc = RKVENC_H264_PROFILE_HIGH;
+	ctx->fps_num = RKVENC_DEFAULT_FPS;
+	ctx->fps_den = 1;
+
+	ctx->src_fmt.width = RKVENC_DEFAULT_WIDTH;
+	ctx->src_fmt.height = RKVENC_DEFAULT_HEIGHT;
+	ctx->src_fmt.colorspace = V4L2_COLORSPACE_REC709;
+	ctx->src_fmt.quantization = V4L2_QUANTIZATION_LIM_RANGE;
+	rkvenc_fill_raw_fmt(&ctx->src_fmt);
+
+	ctx->dst_fmt.width = RKVENC_DEFAULT_WIDTH;
+	ctx->dst_fmt.height = RKVENC_DEFAULT_HEIGHT;
+	ctx->dst_fmt.colorspace = V4L2_COLORSPACE_REC709;
+	ctx->dst_fmt.quantization = V4L2_QUANTIZATION_LIM_RANGE;
+	rkvenc_fill_coded_fmt(&ctx->dst_fmt);
+
+	ctx->crop.left = 0;
+	ctx->crop.top = 0;
+	ctx->crop.width = ctx->src_fmt.width;
+	ctx->crop.height = ctx->src_fmt.height;
+
+	if (mutex_lock_interruptible(&enc->mutex)) {
+		ret = -ERESTARTSYS;
+		goto err_free;
+	}
+
+	v4l2_fh_init(&ctx->fh, video_devdata(file));
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(enc->m2m_dev, ctx,
+					    rkvenc_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		goto err_fh;
+	}
+
+	ret = rkvenc_setup_ctrls(ctx);
+	if (ret)
+		goto err_m2m;
+
+	v4l2_fh_add(&ctx->fh, file);
+	mutex_unlock(&enc->mutex);
+
+	return 0;
+
+err_m2m:
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+err_fh:
+	v4l2_fh_exit(&ctx->fh);
+	mutex_unlock(&enc->mutex);
+err_free:
+	kfree(ctx);
+	return ret;
+}
+
+static int rkvenc_release(struct file *file)
+{
+	struct rkvenc_ctx *ctx = file_to_ctx(file);
+	struct rkvenc_dev *enc = ctx->enc;
+
+	mutex_lock(&enc->mutex);
+	v4l2_fh_del(&ctx->fh, file);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	v4l2_ctrl_handler_free(&ctx->ctrl_handler);
+	v4l2_fh_exit(&ctx->fh);
+	mutex_unlock(&enc->mutex);
+
+	/*
+	 * Held for the life of the context, not of a stream: a client that
+	 * stops and restarts -- which a remote desktop does on every
+	 * resolution change -- would otherwise give the memory back and
+	 * immediately ask for it again on a pool it may no longer win.
+	 */
+	rkvenc_frame_bufs_free(enc->dev, &ctx->bufs);
+
+	kfree(ctx);
+
+	return 0;
+}
+
+static const struct v4l2_file_operations rkvenc_fops = {
+	.owner		= THIS_MODULE,
+	.open		= rkvenc_open,
+	.release	= rkvenc_release,
+	.poll		= v4l2_m2m_fop_poll,
+	.unlocked_ioctl	= video_ioctl2,
+	.mmap		= v4l2_m2m_fop_mmap,
+};
+
+static int rkvenc_job_ready(void *priv)
+{
+	struct rkvenc_ctx *ctx = priv;
+
+	return v4l2_m2m_num_src_bufs_ready(ctx->fh.m2m_ctx) &&
+	       v4l2_m2m_num_dst_bufs_ready(ctx->fh.m2m_ctx);
+}
+
+static bool rkvenc_want_idr(struct rkvenc_ctx *ctx)
+{
+	if (ctx->force_key_frame)
+		return true;
+
+	/* gop_size 0 means "all intra"; otherwise every gop_size-th frame. */
+	if (!ctx->gop_size)
+		return true;
+
+	return ctx->frame_cnt % ctx->gop_size == 0;
+}
+
+static size_t rkvenc_write_headers(struct rkvenc_ctx *ctx, void *dst,
+				   size_t size)
+{
+	struct rkvenc_h264_params p = {};
+	size_t n, total = 0;
+
+	p.width = ctx->src_fmt.width;
+	p.height = ctx->src_fmt.height;
+	p.profile_idc = ctx->profile_idc;
+	p.cabac = ctx->profile_idc != RKVENC_H264_PROFILE_BASELINE;
+	p.init_qp = ctx->qp;
+	p.chroma_qp_index_offset = 0;
+	p.fps_num = ctx->fps_num;
+	p.fps_den = ctx->fps_den;
+	p.max_num_ref_frames = 1;
+	p.log2_max_frame_num_minus4 = RKVENC_LOG2_MAX_FRAME_NUM_M4;
+	p.log2_max_poc_lsb_minus4 = RKVENC_LOG2_MAX_POC_LSB_M4;
+	p.level_idc = rkvenc_h264_level_idc(DIV_ROUND_UP(p.width, 16),
+					    DIV_ROUND_UP(p.height, 16),
+					    p.fps_num, p.fps_den);
+
+	n = rkvenc_h264_write_sps(&p, dst, size);
+	if (!n)
+		return 0;
+	total = n;
+
+	n = rkvenc_h264_write_pps(&p, dst + total, size - total);
+	if (!n)
+		return 0;
+
+	return total + n;
+}
+
+static void rkvenc_device_run(void *priv)
+{
+	struct rkvenc_ctx *ctx = priv;
+	struct rkvenc_dev *enc = ctx->enc;
+	struct rkvenc_frame_job job = {};
+	struct vb2_v4l2_buffer *src, *dst;
+	unsigned long flags;
+	unsigned int cur, prev;
+	void *bs_cpu;
+	bool idr;
+
+	/*
+	 * The buffers stay on the queue until the interrupt says the block is
+	 * done with them. Removing them here, as the skeleton did, would hand
+	 * them back before the hardware had read the source or written the
+	 * bitstream.
+	 */
+	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+	if (!src || !dst) {
+		v4l2_m2m_job_finish(enc->m2m_dev, ctx->fh.m2m_ctx);
+		return;
+	}
+
+	idr = rkvenc_want_idr(ctx);
+	cur = ctx->recon_idx;
+	prev = cur ^ 1;
+
+	/*
+	 * The block writes slices only, so the parameter sets go in front of
+	 * them by hand. An IDR that a decoder cannot configure itself from is
+	 * not a random-access point, which is the one thing an IDR is for.
+	 */
+	ctx->job_hdr_bytes = 0;
+	if (idr) {
+		bs_cpu = vb2_plane_vaddr(&dst->vb2_buf, 0);
+		if (bs_cpu) {
+			ctx->job_hdr_bytes =
+				rkvenc_write_headers(ctx, bs_cpu,
+						     vb2_plane_size(&dst->vb2_buf, 0));
+			if (!ctx->job_hdr_bytes) {
+				dev_err(enc->dev, "no room for SPS/PPS\n");
+				goto fail;
+			}
+		}
+	}
+
+	job.coded_width = ALIGN(ctx->src_fmt.width, RKVENC_MB_DIM);
+	job.coded_height = ALIGN(ctx->src_fmt.height, RKVENC_MB_DIM);
+	job.visible_width = ctx->src_fmt.width;
+	job.visible_height = ctx->src_fmt.height;
+	job.mb_width = job.coded_width / RKVENC_MB_DIM;
+	job.mb_height = job.coded_height / RKVENC_MB_DIM;
+	job.src_stride_y = ctx->src_fmt.plane_fmt[0].bytesperline;
+	job.src_stride_c = job.src_stride_y;
+	job.src_y = vb2_dma_contig_plane_dma_addr(&src->vb2_buf, 0);
+	job.src_c = job.src_y + job.src_stride_y * job.coded_height;
+
+	job.bs_base = vb2_dma_contig_plane_dma_addr(&dst->vb2_buf, 0);
+	job.bs_offset = ctx->job_hdr_bytes;
+	job.bs_size = vb2_plane_size(&dst->vb2_buf, 0);
+
+	job.recon_hdr = ctx->bufs.recon[cur].pixel.dma;
+	job.recon_body = job.recon_hdr + ctx->bufs.fbc_hdr_size;
+	job.recon_thumb = ctx->bufs.recon[cur].thumb.dma;
+	job.ref_hdr = ctx->bufs.recon[prev].pixel.dma;
+	job.ref_body = job.ref_hdr + ctx->bufs.fbc_hdr_size;
+	job.ref_thumb = ctx->bufs.recon[prev].thumb.dma;
+
+	job.ext_line = ctx->bufs.ext_line.dma;
+	job.ext_line_size = ctx->bufs.ext_line.size;
+
+	job.idr = idr;
+	job.qp = ctx->qp;
+	job.cabac = ctx->profile_idc != RKVENC_H264_PROFILE_BASELINE;
+	job.frame_num = idr ? 0 : ctx->frame_cnt;
+	job.idr_pic_id = ctx->idr_pic_id;
+	job.log2_max_frame_num_minus4 = RKVENC_LOG2_MAX_FRAME_NUM_M4;
+	job.log2_max_poc_lsb_minus4 = RKVENC_LOG2_MAX_POC_LSB_M4;
+	/* Coding order is display order, so two ticks per frame. */
+	job.poc_lsb = idr ? 0 : ctx->frame_cnt * 2;
+	job.chroma_qp_index_offset = 0;
+	job.profile_idc = ctx->profile_idc;
+	job.level_idc = rkvenc_h264_level_idc(DIV_ROUND_UP(ctx->src_fmt.width, 16),
+					      DIV_ROUND_UP(ctx->src_fmt.height, 16),
+					      ctx->fps_num, ctx->fps_den);
+
+	dev_info(enc->dev,
+		 "job: src %pad+%pad bs %pad+%u/%u recon %pad body %pad thumb %pad\n",
+		 &job.src_y, &job.src_c, &job.bs_base, job.bs_offset,
+		 job.bs_size, &job.recon_hdr, &job.recon_body,
+		 &job.recon_thumb);
+
+	/*
+	 * STREAMOFF may race the m2m scheduler after it selected this context
+	 * but before device_run reached the hardware. Serialize that boundary:
+	 * abort either prevents the launch or takes ownership of an active job.
+	 * Arm the watchdog before starting the block so a very fast completion
+	 * cannot leave delayed work from this job attached to the next one.
+	 */
+	spin_lock_irqsave(&enc->job_lock, flags);
+	if (ctx->aborting) {
+		spin_unlock_irqrestore(&enc->job_lock, flags);
+		goto fail;
+	}
+	atomic_set(&enc->job_active, 1);
+	schedule_delayed_work(&enc->watchdog,
+			      msecs_to_jiffies(RKVENC_JOB_TIMEOUT_MS));
+	rkvenc_hw_run(enc->regs, &job);
+	spin_unlock_irqrestore(&enc->job_lock, flags);
+
+	return;
+
+fail:
+	src = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+	if (src)
+		v4l2_m2m_buf_done(src, VB2_BUF_STATE_ERROR);
+	if (dst)
+		v4l2_m2m_buf_done(dst, VB2_BUF_STATE_ERROR);
+	v4l2_m2m_job_finish(enc->m2m_dev, ctx->fh.m2m_ctx);
+}
+
+static void rkvenc_reset_block(struct rkvenc_dev *enc)
+{
+	if (!rkvenc_hw_reset(enc->regs))
+		return;
+
+	dev_warn(enc->dev, "soft reset timed out, using reset controls\n");
+	if (reset_control_bulk_assert(RKVENC_NUM_RESETS, enc->resets)) {
+		dev_err(enc->dev, "failed to assert reset controls\n");
+		return;
+	}
+
+	udelay(5);
+	if (reset_control_bulk_deassert(RKVENC_NUM_RESETS, enc->resets)) {
+		dev_err(enc->dev, "failed to deassert reset controls\n");
+		return;
+	}
+
+	/* A reset clears the tables that the next frame expects to find. */
+	rkvenc_hw_setup_common(enc->regs);
+	rkvenc_hw_load_tables(enc->regs);
+}
+
+static void rkvenc_watchdog(struct work_struct *work)
+{
+	struct rkvenc_dev *enc =
+		container_of(to_delayed_work(work), struct rkvenc_dev, watchdog);
+	struct vb2_v4l2_buffer *src, *dst;
+	struct rkvenc_ctx *ctx;
+	unsigned long flags;
+
+	spin_lock_irqsave(&enc->job_lock, flags);
+	if (atomic_cmpxchg(&enc->job_active, 1, 0) != 1) {
+		spin_unlock_irqrestore(&enc->job_lock, flags);
+		return;
+	}
+	spin_unlock_irqrestore(&enc->job_lock, flags);
+
+	dev_err(enc->dev, "job timed out after %u ms, int status 0x%08x\n",
+		RKVENC_JOB_TIMEOUT_MS, rkvenc_read(enc, RKVENC_REG_INT_STA));
+
+	/*
+	 * Stop the block before touching the buffers: it may still be writing
+	 * into them, and handing memory back to userspace while the hardware
+	 * has a pointer to it is worse than the stall we are recovering from.
+	 */
+	rkvenc_reset_block(enc);
+	synchronize_irq(enc->irq);
+
+	ctx = v4l2_m2m_get_curr_priv(enc->m2m_dev);
+	if (!ctx)
+		return;
+
+	src = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+	if (src)
+		v4l2_m2m_buf_done(src, VB2_BUF_STATE_ERROR);
+	if (dst) {
+		vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+		v4l2_m2m_buf_done(dst, VB2_BUF_STATE_ERROR);
+	}
+
+	v4l2_m2m_job_finish(enc->m2m_dev, ctx->fh.m2m_ctx);
+}
+
+static void rkvenc_job_abort(void *priv)
+{
+	struct rkvenc_ctx *ctx = priv;
+	struct rkvenc_dev *enc = ctx->enc;
+	struct vb2_v4l2_buffer *src, *dst;
+	unsigned long flags;
+
+	spin_lock_irqsave(&enc->job_lock, flags);
+	ctx->aborting = true;
+
+	/* IRQ or watchdog already owns completion; cancel_job will wait for it. */
+	if (atomic_cmpxchg(&enc->job_active, 1, 0) != 1) {
+		spin_unlock_irqrestore(&enc->job_lock, flags);
+		return;
+	}
+
+	spin_unlock_irqrestore(&enc->job_lock, flags);
+
+	/* Stop all asynchronous owners before resetting and returning memory. */
+	cancel_delayed_work_sync(&enc->watchdog);
+	rkvenc_reset_block(enc);
+	synchronize_irq(enc->irq);
+
+	src = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+	if (src)
+		v4l2_m2m_buf_done(src, VB2_BUF_STATE_ERROR);
+	if (dst) {
+		vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+		v4l2_m2m_buf_done(dst, VB2_BUF_STATE_ERROR);
+	}
+
+	v4l2_m2m_job_finish(enc->m2m_dev, ctx->fh.m2m_ctx);
+}
+
+static const struct v4l2_m2m_ops rkvenc_m2m_ops = {
+	.device_run	= rkvenc_device_run,
+	.job_ready	= rkvenc_job_ready,
+	.job_abort	= rkvenc_job_abort,
+};
+
+static irqreturn_t rkvenc_irq(int irq, void *data)
+{
+	struct rkvenc_dev *enc = data;
+	struct vb2_v4l2_buffer *src, *dst;
+	struct rkvenc_ctx *ctx;
+	enum vb2_buffer_state state;
+	unsigned long flags;
+	u32 status, bytes = 0;
+
+	status = rkvenc_read(enc, RKVENC_REG_INT_STA);
+	if (!status)
+		return IRQ_NONE;
+
+	rkvenc_write(enc, RKVENC_REG_INT_CLR, status);
+
+	/*
+	 * A job can complete after its context has gone -- a client that
+	 * closes the device mid-frame -- so the interrupt has to cope with
+	 * having nobody to report to.
+	 */
+	ctx = v4l2_m2m_get_curr_priv(enc->m2m_dev);
+	if (!ctx)
+		return IRQ_HANDLED;
+
+	/*
+	 * Slice-progress interrupts arrive while the frame is still running,
+	 * so only claim the job once something final has happened.
+	 */
+	if (status & (RKVENC_INT_ENC_DONE | RKVENC_INT_ERROR)) {
+		spin_lock_irqsave(&enc->job_lock, flags);
+		if (atomic_cmpxchg(&enc->job_active, 1, 0) != 1) {
+			spin_unlock_irqrestore(&enc->job_lock, flags);
+			return IRQ_HANDLED;
+		}
+		spin_unlock_irqrestore(&enc->job_lock, flags);
+		cancel_delayed_work(&enc->watchdog);
+	}
+
+	if (status & RKVENC_INT_ERROR) {
+		/*
+		 * The two readings of this register available to us disagree
+		 * about which bit is which error, so report the raw value
+		 * rather than a decoded name that may be wrong.
+		 */
+		dev_err(enc->dev, "encode error, int status 0x%08x\n", status);
+		state = VB2_BUF_STATE_ERROR;
+	} else if (status & RKVENC_INT_ENC_DONE) {
+		bytes = rkvenc_hw_bitstream_len(enc->regs);
+		state = VB2_BUF_STATE_DONE;
+	} else {
+		/* Slice or link-table progress: the frame is not finished. */
+		return IRQ_HANDLED;
+	}
+
+	src = v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+	if (src && dst) {
+		v4l2_m2m_buf_copy_metadata(src, dst);
+		src->sequence = ctx->sequence_out++;
+		dst->sequence = ctx->sequence_cap++;
+
+		if (state == VB2_BUF_STATE_DONE) {
+			/*
+			 * The hardware counts only what it wrote, so the
+			 * parameter sets placed in front of the slice have to
+			 * be added back or the client receives a payload that
+			 * starts mid-stream.
+			 */
+			vb2_set_plane_payload(&dst->vb2_buf, 0,
+					      ctx->job_hdr_bytes + bytes);
+
+			if (ctx->job_hdr_bytes)
+				dst->flags |= V4L2_BUF_FLAG_KEYFRAME;
+			else
+				dst->flags |= V4L2_BUF_FLAG_PFRAME;
+
+			ctx->recon_idx ^= 1;
+			if (ctx->job_hdr_bytes) {
+				ctx->frame_cnt = 1;
+				ctx->idr_pic_id ^= 1;
+				ctx->force_key_frame = false;
+			} else {
+				ctx->frame_cnt++;
+			}
+		} else {
+			vb2_set_plane_payload(&dst->vb2_buf, 0, 0);
+		}
+
+		/*
+		 * A client that drains -- which is every client at end of
+		 * stream -- queues its last frame and then waits to be told
+		 * the stream is over. That signal is this flag on the final
+		 * capture buffer plus the EOS event; without it the encoder
+		 * produces a perfectly good frame that nobody ever collects.
+		 */
+		if (v4l2_m2m_is_last_draining_src_buf(ctx->fh.m2m_ctx, src)) {
+			dst->flags |= V4L2_BUF_FLAG_LAST;
+			v4l2_m2m_mark_stopped(ctx->fh.m2m_ctx);
+			v4l2_event_queue_fh(&ctx->fh,
+					    &(const struct v4l2_event) {
+						.type = V4L2_EVENT_EOS,
+					    });
+		}
+
+		v4l2_m2m_buf_done(src, state);
+		v4l2_m2m_buf_done(dst, state);
+	}
+
+	v4l2_m2m_job_finish(enc->m2m_dev, ctx->fh.m2m_ctx);
+
+	return IRQ_HANDLED;
+}
+
+static int rkvenc_runtime_resume(struct device *dev)
+{
+	struct rkvenc_dev *enc = dev_get_drvdata(dev);
+	int ret;
+
+	ret = clk_bulk_prepare_enable(RKVENC_NUM_CLKS, enc->clks);
+	if (ret)
+		return ret;
+
+	/*
+	 * The power domain clears the block's registers, so its clock gate,
+	 * bus byte order and watchdog have to be written again here rather
+	 * than once at probe.
+	 */
+	rkvenc_hw_setup_common(enc->regs);
+	rkvenc_hw_load_tables(enc->regs);
+
+	return 0;
+}
+
+static int rkvenc_runtime_suspend(struct device *dev)
+{
+	struct rkvenc_dev *enc = dev_get_drvdata(dev);
+
+	clk_bulk_disable_unprepare(RKVENC_NUM_CLKS, enc->clks);
+
+	return 0;
+}
+
+static const struct dev_pm_ops rkvenc_pm_ops = {
+	RUNTIME_PM_OPS(rkvenc_runtime_suspend, rkvenc_runtime_resume, NULL)
+};
+
+static int rkvenc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rkvenc_dev *enc;
+	struct video_device *vfd;
+	int ret;
+
+	enc = devm_kzalloc(dev, sizeof(*enc), GFP_KERNEL);
+	if (!enc)
+		return -ENOMEM;
+
+	enc->dev = dev;
+	platform_set_drvdata(pdev, enc);
+	INIT_DELAYED_WORK(&enc->watchdog, rkvenc_watchdog);
+	atomic_set(&enc->job_active, 0);
+	spin_lock_init(&enc->job_lock);
+	mutex_init(&enc->mutex);
+
+	enc->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(enc->regs))
+		return PTR_ERR(enc->regs);
+
+	enc->clks[0].id = "aclk";
+	enc->clks[1].id = "hclk";
+	enc->clks[2].id = "core";
+	ret = devm_clk_bulk_get(dev, RKVENC_NUM_CLKS, enc->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get clocks\n");
+
+	enc->resets[0].id = "a";
+	enc->resets[1].id = "h";
+	enc->resets[2].id = "core";
+	ret = devm_reset_control_bulk_get_exclusive(dev, RKVENC_NUM_RESETS,
+						    enc->resets);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get resets\n");
+
+	enc->irq = platform_get_irq_byname(pdev, "enc");
+	if (enc->irq < 0)
+		enc->irq = platform_get_irq(pdev, 0);
+	if (enc->irq < 0)
+		return enc->irq;
+
+	ret = devm_request_irq(dev, enc->irq, rkvenc_irq, 0, dev_name(dev),
+			       enc);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request IRQ\n");
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set DMA mask\n");
+
+	pm_runtime_set_suspended(dev);
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to power encoder\n");
+	enc->hw_id = rkvenc_read(enc, RKVENC_REG_VERSION);
+	pm_runtime_put(dev);
+
+	if (!enc->hw_id || enc->hw_id == 0xffffffff)
+		return dev_err_probe(dev, -ENODEV,
+				     "implausible hardware id 0x%08x\n",
+				     enc->hw_id);
+
+	if (!(enc->hw_id & RKVENC_VERSION_H264_CAP))
+		return dev_err_probe(dev, -ENODEV,
+				     "H.264 capability missing in id 0x%08x\n",
+				     enc->hw_id);
+
+	ret = v4l2_device_register(dev, &enc->v4l2_dev);
+	if (ret)
+		return ret;
+
+	enc->m2m_dev = v4l2_m2m_init(&rkvenc_m2m_ops);
+	if (IS_ERR(enc->m2m_dev)) {
+		ret = PTR_ERR(enc->m2m_dev);
+		goto err_v4l2;
+	}
+
+	vfd = &enc->vfd;
+	vfd->fops = &rkvenc_fops;
+	vfd->ioctl_ops = &rkvenc_ioctl_ops;
+	vfd->release = video_device_release_empty;
+	vfd->lock = &enc->mutex;
+	vfd->v4l2_dev = &enc->v4l2_dev;
+	vfd->vfl_dir = VFL_DIR_M2M;
+	vfd->device_caps = V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_STREAMING;
+	strscpy(vfd->name, RKVENC_NAME, sizeof(vfd->name));
+	video_set_drvdata(vfd, enc);
+
+	ret = video_register_device(vfd, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_m2m;
+
+	dev_info(dev,
+		 "VEPU580 [build 081217] registered as /dev/video%d: version 0x%08x, H.264, HEVC %s, FBC %lu\n",
+		 vfd->num, enc->hw_id,
+		 enc->hw_id & RKVENC_VERSION_HEVC_CAP ? "yes" : "no",
+		 FIELD_GET(RKVENC_VERSION_FBC_CAP, enc->hw_id));
+
+	return 0;
+
+err_m2m:
+	v4l2_m2m_release(enc->m2m_dev);
+err_v4l2:
+	v4l2_device_unregister(&enc->v4l2_dev);
+	return ret;
+}
+
+static void rkvenc_remove(struct platform_device *pdev)
+{
+	struct rkvenc_dev *enc = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&enc->watchdog);
+
+	video_unregister_device(&enc->vfd);
+	v4l2_m2m_release(enc->m2m_dev);
+	v4l2_device_unregister(&enc->v4l2_dev);
+}
+
+static const struct of_device_id rkvenc_of_match[] = {
+	{ .compatible = "rockchip,rk3588-vepu580" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, rkvenc_of_match);
+
+static struct platform_driver rkvenc_driver = {
+	.probe = rkvenc_probe,
+	.remove = rkvenc_remove,
+	.driver = {
+		.name = RKVENC_NAME,
+		.of_match_table = rkvenc_of_match,
+		.pm = pm_ptr(&rkvenc_pm_ops),
+	},
+};
+module_platform_driver(rkvenc_driver);
+
+MODULE_DESCRIPTION("Rockchip VEPU580 H.264 encoder skeleton");
+MODULE_LICENSE("GPL");
