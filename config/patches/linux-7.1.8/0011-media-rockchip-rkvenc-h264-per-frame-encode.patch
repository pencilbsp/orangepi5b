--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-hw.h	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-hw.h	2026-09-09 08:49:39.497692058 +0000
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Per-frame register path for the Rockchip VEPU580 encoder driver.
+ *
+ * Copyright (C) 2026 Orange Pi 5B mainline project
+ *
+ * The register writes depend on nothing but a flat description of one frame
+ * and the mapped register base. Keeping struct rkvenc_ctx out of here means
+ * the sequence can be read against the register map on its own, and that a
+ * future link-table path can drive the same code with a different source of
+ * addresses.
+ */
+
+#ifndef _RKVENC_HW_H_
+#define _RKVENC_HW_H_
+
+#include <linux/types.h>
+
+/*
+ * Tuning tables the block reads out of its own register space. Their contents
+ * are hardware data with no published derivation -- see rkvenc-tables.c.
+ */
+#define RKVENC_SCL_TAB_LEN	576
+#define RKVENC_LAMBDA_TAB_LEN	52
+#define RKVENC_KLUT_TAB_LEN	30
+
+extern const u32 rkvenc_h264_flat_scl_tab[RKVENC_SCL_TAB_LEN];
+extern const u32 rkvenc_h264_lambda_tab[RKVENC_LAMBDA_TAB_LEN];
+extern const u32 rkvenc_h264_klut_weight[RKVENC_KLUT_TAB_LEN];
+
+/**
+ * struct rkvenc_frame_job - one frame's worth of hardware programming
+ * @coded_width:  macroblock-aligned width in samples
+ * @coded_height: macroblock-aligned height in samples
+ * @src_stride_y: source luma stride in bytes
+ * @src_stride_c: source chroma stride in bytes
+ * @src_y:        source luma plane
+ * @src_c:        source chroma plane, NV12 interleaved
+ * @bs_base:      bitstream buffer, device address
+ * @bs_offset:    where the block starts writing, past any software headers
+ * @bs_size:      capacity of the bitstream buffer from @bs_base
+ * @recon_hdr:    FBC header of the frame being coded
+ * @recon_body:   FBC body of the frame being coded
+ * @recon_thumb:  downscaled copy of the frame being coded
+ * @ref_hdr:      FBC header of the reference frame
+ * @ref_body:     FBC body of the reference frame
+ * @ref_thumb:    downscaled copy of the reference frame
+ * @ext_line:     wide-picture line buffer, zero when not allocated
+ * @ext_line_size: size of @ext_line
+ * @idr:          code as an IDR rather than a predicted picture
+ * @qp:           picture QP, 0..51
+ * @cabac:        entropy coder, must match the PPS handed to the decoder
+ * @frame_num:    H.264 frame_num for this picture
+ * @idr_pic_id:   idr_pic_id, alternates between consecutive IDRs
+ * @log2_max_frame_num_minus4: must match the SPS
+ * @chroma_qp_index_offset:    must match the PPS
+ *
+ * Everything the decoder will read out of the parameter sets appears twice:
+ * once in the bytes rkvenc-h264.c writes, and once here, because the block
+ * builds the slice header itself. The two have to agree or the stream is
+ * self-contradictory, which is why both are driven from the same context
+ * fields rather than from separate defaults.
+ */
+struct rkvenc_frame_job {
+	u32 coded_width;
+	u32 coded_height;
+	u32 visible_width;
+	u32 visible_height;
+	u32 mb_width;
+	u32 mb_height;
+	u32 src_stride_y;
+	u32 src_stride_c;
+
+	dma_addr_t src_y;
+	dma_addr_t src_c;
+
+	dma_addr_t bs_base;
+	u32 bs_offset;
+	u32 bs_size;
+
+	dma_addr_t recon_hdr;
+	dma_addr_t recon_body;
+	dma_addr_t recon_thumb;
+	dma_addr_t ref_hdr;
+	dma_addr_t ref_body;
+	dma_addr_t ref_thumb;
+
+	dma_addr_t ext_line;
+	u32 ext_line_size;
+
+	bool idr;
+	u8 qp;
+	bool cabac;
+	u16 frame_num;
+	u16 idr_pic_id;
+	u8 log2_max_frame_num_minus4;
+	u8 log2_max_poc_lsb_minus4;
+	u16 poc_lsb;
+	s8 chroma_qp_index_offset;
+	u8 profile_idc;
+	u8 level_idc;
+};
+
+/*
+ * Block-level state: clock gate, bus byte order, watchdog, interrupts.
+ * Must run on every runtime resume, not only at probe.
+ */
+void rkvenc_hw_setup_common(void __iomem *regs);
+
+/*
+ * Load the tuning tables. Like the common setup these live in registers the
+ * power domain clears, so they belong on the resume path, not in probe.
+ */
+void rkvenc_hw_load_tables(void __iomem *regs);
+
+/* Program one frame and start it. Returns nothing: completion is by IRQ. */
+void rkvenc_hw_run(void __iomem *regs, const struct rkvenc_frame_job *job);
+
+/* Bytes the block wrote for the frame that just completed. */
+u32 rkvenc_hw_bitstream_len(void __iomem *regs);
+
+/* Stop a running job and leave the block idle. Returns a safe-clear timeout. */
+int rkvenc_hw_reset(void __iomem *regs);
+
+#endif /* _RKVENC_HW_H_ */
