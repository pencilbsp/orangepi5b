diff -uNr -x '.*' -x '*.o' -x '*.ko' -x '*.mod' -x '*.mod.c' -x modules.order -x Module.symvers -x Kconfig base/drivers/media/platform/rockchip/rkvenc/rockchip-rkvenc.c ktest/drivers/media/platform/rockchip/rkvenc/rockchip-rkvenc.c
