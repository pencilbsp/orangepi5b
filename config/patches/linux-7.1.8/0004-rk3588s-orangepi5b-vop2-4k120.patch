 #define VOP2_VP_FEATURE_OUTPUT_10BIT        BIT(0)
 
+/*
+ * Highest rate the video port dclk can run at. Beyond this a port drives more
+ * than one pixel per clock instead, which is how modes past 4K60 are reached.
+ */
+#define VOP2_MAX_DCLK_RATE		600000000UL
+
