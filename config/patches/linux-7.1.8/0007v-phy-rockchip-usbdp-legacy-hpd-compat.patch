From: Codex <codex@openai.com>
Date: Sat, 12 Sep 2026 15:15:00 +0000
Subject: [PATCH] phy: rockchip: usbdp: retain legacy VO GRF HPD routing

The upstream USBDP v13 cleanup hands USB-C HPD propagation to a follow-up
DRM bridge.  Linux 7.1.8 does not yet contain the matching Synopsys DW-DP
bridge rework, so removing the legacy PHY-side VO GRF trigger leaves the
controller without an HPD signal.

Temporarily retain the old HPD routing on top of the new USBDP power-state
and DWC3 reset-notifier implementation.  Cache HPD until the DP consumer is
initialized, replay it during PHY init, and continue to pulse the VO GRF bit
for IRQ HPD events.  This compatibility layer can be removed when the full
DW-DP follow-up bridge series is merged.

Signed-off-by: Codex <codex@openai.com>
---
 drivers/phy/rockchip/phy-rockchip-usbdp.c | 67 ++++++++++++++++++++++-
 1 file changed, 66 insertions(+), 1 deletion(-)

diff --git a/drivers/phy/rockchip/phy-rockchip-usbdp.c b/drivers/phy/rockchip/phy-rockchip-usbdp.c
--- a/drivers/phy/rockchip/phy-rockchip-usbdp.c
+++ b/drivers/phy/rockchip/phy-rockchip-usbdp.c
@@ -130,6 +130,7 @@
 
 struct rk_udphy_vogrf_cfg {
 	/* vo-grf */
+	struct rk_udphy_grf_reg hpd_trigger;
 	u32 dp_lane_reg;
 };
 
@@ -188,12 +189,15 @@
 	u32 dp_lane_sel[4];
 	u32 dp_aux_dout_sel;
 	u32 dp_aux_din_sel;
+	bool dp_sink_hpd_sel;
+	bool dp_sink_hpd_cfg;
 	unsigned int link_rate;
 	unsigned int lanes;
 	u8 bw;
 	int id;
 
 	int dp_lanes;
+	bool dp_in_use;
 
 	/* PHY const config */
 	const struct rk_udphy_cfg *cfgs;
@@ -580,6 +584,19 @@
 				   CMN_DP_CMN_RSTN, FIELD_PREP(CMN_DP_CMN_RSTN, 0x0));
 }
 
+static void rk_udphy_dp_hpd_event_trigger(struct rk_udphy *udphy, bool hpd)
+{
+	const struct rk_udphy_cfg *cfg = udphy->cfgs;
+
+	udphy->dp_sink_hpd_sel = true;
+	udphy->dp_sink_hpd_cfg = hpd;
+
+	if (!udphy->dp_in_use)
+		return;
+
+	rk_udphy_grfreg_write(udphy->vogrf, &cfg->vogrfcfg[udphy->id].hpd_trigger, hpd);
+}
+
 static void rk_udphy_set_lane_mux(struct rk_udphy *udphy)
 {
 	if (udphy->dp_lanes == 4) {
@@ -1086,6 +1103,28 @@
 	return 0;
 }
 
+static int rk_udphy_dp_phy_init(struct phy *phy)
+{
+	struct rk_udphy *udphy = phy_get_drvdata(phy);
+
+	guard(mutex)(&udphy->mutex);
+	udphy->dp_in_use = true;
+	if (udphy->dp_sink_hpd_sel)
+		rk_udphy_dp_hpd_event_trigger(udphy, udphy->dp_sink_hpd_cfg);
+
+	return 0;
+}
+
+static int rk_udphy_dp_phy_exit(struct phy *phy)
+{
+	struct rk_udphy *udphy = phy_get_drvdata(phy);
+
+	guard(mutex)(&udphy->mutex);
+	udphy->dp_in_use = false;
+
+	return 0;
+}
+
 static int rk_udphy_dp_phy_power_on(struct phy *phy)
 {
 	struct rk_udphy *udphy = phy_get_drvdata(phy);
@@ -1322,6 +1361,8 @@
 }
 
 static const struct phy_ops rk_udphy_dp_phy_ops = {
+	.init		= rk_udphy_dp_phy_init,
+	.exit		= rk_udphy_dp_phy_exit,
 	.power_on	= rk_udphy_dp_phy_power_on,
 	.power_off	= rk_udphy_dp_phy_power_off,
 	.configure	= rk_udphy_dp_phy_configure,
@@ -1388,6 +1429,8 @@
 				  struct typec_mux_state *state)
 {
 	struct rk_udphy *udphy = typec_mux_get_drvdata(mux);
+	struct typec_displayport_data *data;
+	int ret;
 
 	/* Ignore mux events not involving USB or DP */
 	if (!rk_udphy_is_supported_mode(state)) {
@@ -1400,8 +1443,28 @@
 	guard(mutex)(&udphy->mutex);
 
 	rk_udphy_set_typec_state(udphy, state->mode);
+	ret = rk_udphy_update_power_state(udphy);
+	if (ret)
+		return ret;
 
-	return rk_udphy_update_power_state(udphy);
+	if (!state->alt || state->alt->svid != USB_TYPEC_DP_SID) {
+		rk_udphy_dp_hpd_event_trigger(udphy, false);
+		return 0;
+	}
+
+	data = state->data;
+	if (!data) {
+		rk_udphy_dp_hpd_event_trigger(udphy, false);
+	} else if (data->status & DP_STATUS_IRQ_HPD) {
+		rk_udphy_dp_hpd_event_trigger(udphy, false);
+		usleep_range(750, 800);
+		rk_udphy_dp_hpd_event_trigger(udphy, true);
+	} else {
+		rk_udphy_dp_hpd_event_trigger(udphy,
+					      data->status & DP_STATUS_HPD_STATE);
+	}
+
+	return 0;
 }
 
 static void rk_udphy_typec_mux_unregister(void *data)
@@ -1616,9 +1679,11 @@
 	},
 	.vogrfcfg = {
 		{
+			.hpd_trigger	= RK_UDPHY_GEN_GRF_REG(0x0000, 11, 10, 1, 3),
 			.dp_lane_reg	= 0x0000,
 		},
 		{
+			.hpd_trigger	= RK_UDPHY_GEN_GRF_REG(0x0008, 11, 10, 1, 3),
 			.dp_lane_reg	= 0x0008,
 		},
 	},
-- 
2.51.0
