+/*
+ * FRL bring-up spike.
+ *
+ * Answers exactly one question: can this board train a Fixed Rate Link with
+ * the attached sink?  It implements LTS1..LTS3 of the HDMI 2.1 link training
+ * state machine and stops as soon as the sink reports a pass (LTSP).
+ *
+ * Deliberately not implemented, because the spike does not need them:
+ *   - LTS4, the sink-requested rate change: reported as a failure instead.
+ *   - TxFFE level adjustment: the sink's "raise TxFFE" request is refused,
+ *     which costs link margin but keeps the PHY out of the picture.
+ *   - The LTSP poll loop that watches for the sink dropping the link later.
+ *   - Audio, DSC, and any interaction with the atomic modeset path.
+ *   - Any way back to TMDS. Once this has run, the next atomic_check fails
+ *     with -EINVAL because the PHY is in FRL mode while DRM still asks for a
+ *     TMDS char rate, and the CRTC is torn down. Reboot to recover; do not
+ *     try to undo it by poking the controller, which by then is unclocked.
+ *
+ * The caller (platform glue) is responsible for putting the PHY into FRL
+ * mode and re-powering it before calling in here.
+ */
+
+/*
+ * How much TxFFE headroom we tell the sink we have. Declaring 0 means the sink
+ * has no way to ask for more equalisation, which is fine at 6 Gbps per lane
+ * and fatal above it: the sink simply gives up and resets, taking SCDC with
+ * it. Rockchip's BSP exposes the same value as a per-board DT property.
+ */
+static unsigned int frl_max_ffe_lv = 3;
+module_param(frl_max_ffe_lv, uint, 0644);
+MODULE_PARM_DESC(frl_max_ffe_lv, "FRL max TxFFE level advertised to the sink, 0-3");
+
+/*
+ * A sink leaving standby is slow twice over. It takes seconds to answer DDC at
+ * all, and then answers SCDC well before it will agree to be trained: one
+ * measured wake replied to LTS1 immediately and only raised FLT_ready five
+ * seconds after the PHY began sending. Both waits happen in the worker rather
+ * than in atomic_enable, which would otherwise stall the modeset for all of it.
+ */
+#define FRL_SINK_READY_TIMEOUT_MS	6000
+#define FRL_LTS2_TIMEOUT_MS		8000
+#define FRL_LTS3_TIMEOUT_MS		2000
+
+/* Attempts before giving up on bringing the link back. */
+#define FRL_TRAIN_ATTEMPTS		5
+#define FRL_RETRY_DELAY_MS		500
+
+/* How often to ask the sink whether the link still needs attention. */
+#define FRL_SUPERVISE_INTERVAL_MS	200
+
+#define FFE_PRE_SHOOT_ENABLE		BIT(0)
+#define FFE_DE_EMPHASIS_ENABLE		BIT(1)
+#define FFE_BOTH_ENABLE			(FFE_PRE_SHOOT_ENABLE | FFE_DE_EMPHASIS_ENABLE)
+
+static void dw_hdmi_qp_frl_set_ffe(struct dw_hdmi_qp *hdmi, u8 ffe_lv, u8 ffe_mode)
+{
+	if (!hdmi->phy.ops->set_ffe)
+		return;
+
+	hdmi->phy.ops->set_ffe(hdmi, hdmi->phy.data, ffe_lv, ffe_mode);
+}
+
+/*
+ * The sink asks for the "all lanes pattern 3" code when it wants the source to
+ * keep whatever it is already sending. Re-writing the register in that case
+ * would restart the pattern, so feed the current value back instead.
+ */
+static void dw_hdmi_qp_frl_set_ltp(struct dw_hdmi_qp *hdmi, u32 value)
+{
+	if (!hdmi->flt_no_timeout && value == 0x3333f)
+		value = dw_hdmi_qp_read(hdmi, FLT_CONFIG1);
+
+	dw_hdmi_qp_write(hdmi, value, FLT_CONFIG1);
+}
+
+static unsigned int dw_hdmi_qp_frl_rate_mask(unsigned int lanes,
+					     unsigned int rate_per_lane)
+{
+	switch (lanes * rate_per_lane) {
+	case 9:		/* 3 Gbps x 3 lanes */
+		return 1;
+	case 18:	/* 6 Gbps x 3 lanes */
+		return 2;
+	case 24:	/* 6 Gbps x 4 lanes */
+		return 3;
+	case 32:	/* 8 Gbps x 4 lanes */
+		return 4;
+	case 40:	/* 10 Gbps x 4 lanes */
+		return 5;
+	case 48:	/* 12 Gbps x 4 lanes */
+		return 6;
+	}
+
+	return 0;
+}
+
+/*
+ * DDC keeps glitching for a while after a sink answers for the first time
+ * coming out of standby: a read fails with EIO, the next one works. Dropping a
+ * whole training round over one of those costs a second of black screen, so
+ * retry the transfer instead.
+ */
+#define FRL_SCDC_ATTEMPTS		3
+
+static int dw_hdmi_qp_scdc_read(struct dw_hdmi_qp *hdmi, u8 reg, u8 *val)
+{
+	int i, ret = -EIO;
+
+	for (i = 0; i < FRL_SCDC_ATTEMPTS; i++) {
+		ret = drm_scdc_readb(hdmi->bridge.ddc, reg, val);
+		if (ret >= 0)
+			return ret;
+
+		usleep_range(1000, 2000);
+	}
+
+	return ret;
+}
+
+static int dw_hdmi_qp_scdc_write(struct dw_hdmi_qp *hdmi, u8 reg, u8 val)
+{
+	int i, ret = -EIO;
+
+	for (i = 0; i < FRL_SCDC_ATTEMPTS; i++) {
+		ret = drm_scdc_writeb(hdmi->bridge.ddc, reg, val);
+		if (ret >= 0)
+			return ret;
+
+		usleep_range(1000, 2000);
+	}
+
+	return ret;
+}
+
+static int dw_hdmi_qp_frl_lts1(struct dw_hdmi_qp *hdmi)
+{
+	unsigned long deadline;
+	u8 val = 0;
+	int ret;
+
+	/* Park the video datapath while the link is retrained. */
+	dw_hdmi_qp_mod(hdmi, AVP_DATAPATH_VIDEO_SWDISABLE,
+		       AVP_DATAPATH_VIDEO_SWDISABLE, GLOBAL_SWDISABLE);
+	dw_hdmi_qp_write(hdmi, BIT(6), GLOBAL_SWRESET_REQUEST);
+
+	deadline = jiffies + msecs_to_jiffies(FRL_SINK_READY_TIMEOUT_MS);
+	do {
+		ret = dw_hdmi_qp_scdc_read(hdmi, SCDC_SINK_VERSION, &val);
+		if (ret >= 0 && val)
+			break;
+
+		msleep(100);
+	} while (time_before(jiffies, deadline));
+
+	if (ret < 0) {
+		dev_err(hdmi->dev, "FRL: sink never answered SCDC: %d\n", ret);
+		return ret;
+	}
+
+	if (!val) {
+		dev_err(hdmi->dev, "FRL: sink stuck at SCDC version 0\n");
+		return -ENODEV;
+	}
+
+	ret = dw_hdmi_qp_scdc_write(hdmi, SCDC_SOURCE_VERSION, 1);
+	if (ret < 0) {
+		dev_err(hdmi->dev, "FRL: SCDC write failed: %d\n", ret);
+		return ret;
+	}
+
+	hdmi->flt_no_timeout = false;
+	if (!dw_hdmi_qp_scdc_read(hdmi, SCDC_SINK_SOURCE_TEST_CONFIG, &val))
+		hdmi->flt_no_timeout = val & BIT(5);
+
+	dev_info(hdmi->dev, "FRL: LTS1 done, flt_no_timeout=%d\n",
+		 hdmi->flt_no_timeout);
+
+	return 0;
+}
+
+static int dw_hdmi_qp_frl_lts2(struct dw_hdmi_qp *hdmi, unsigned int rate_mask)
+{
+	unsigned long deadline = jiffies +
+				 msecs_to_jiffies(FRL_LTS2_TIMEOUT_MS);
+	u8 val = 0;
+	int ret;
+
+	do {
+		ret = dw_hdmi_qp_scdc_read(hdmi, SCDC_STATUS_FLAGS_0, &val);
+		if (ret < 0)
+			return ret;
+
+		if (val & SCDC_SINK_STATUS_FLAGS_0_FLT_READY)
+			break;
+
+		msleep(20);
+	} while (time_before(jiffies, deadline));
+
+	if (!(val & SCDC_SINK_STATUS_FLAGS_0_FLT_READY)) {
+		dev_err(hdmi->dev,
+			"FRL: sink never raised FLT_ready (SCDC 0x40 = 0x%02x)\n",
+			val);
+		return -ETIMEDOUT;
+	}
+
+	/* Tell the sink which rate we will train and how much TxFFE we have. */
+	hdmi->flt_ffe_lv = 0;
+	dw_hdmi_qp_frl_set_ffe(hdmi, 0, FFE_BOTH_ENABLE);
+
+	ret = dw_hdmi_qp_scdc_write(hdmi, SCDC_SINK_CONFIG_1,
+			      (frl_max_ffe_lv & 0x3) << 4 | rate_mask);
+	if (ret < 0)
+		return ret;
+
+	ret = dw_hdmi_qp_scdc_write(hdmi, SCDC_CONFIG_0, 0);
+	if (ret < 0)
+		return ret;
+
+	dev_info(hdmi->dev, "FRL: LTS2 done, advertised max TxFFE level %u\n",
+		 frl_max_ffe_lv & 0x3);
+
+	return 0;
+}
+
+static int dw_hdmi_qp_frl_lts3(struct dw_hdmi_qp *hdmi)
+{
+	unsigned long deadline = jiffies +
+				 msecs_to_jiffies(FRL_LTS3_TIMEOUT_MS);
+	u8 ffe_mode_prev = 0;
+	bool ffe_test = false;
+	u8 upd, flags1, flags2;
+	u8 ltp[4];
+	int ret;
+
+	while (time_before(jiffies, deadline) || hdmi->flt_no_timeout) {
+		/* The spec wants the source to poll at least every 2 ms. */
+		usleep_range(400, 600);
+
+		ret = dw_hdmi_qp_scdc_read(hdmi, SCDC_UPDATE_0, &upd);
+		if (ret < 0)
+			return ret;
+
+		if (upd & SCDC_SINK_UPDATE_0_SOURCE_TEST) {
+			u8 cfg = 0;
+
+			ret = drm_scdc_readb(hdmi->bridge.ddc,
+					     SCDC_SINK_SOURCE_TEST_CONFIG, &cfg);
+			if (ret < 0)
+				return ret;
+
+			hdmi->flt_no_timeout = cfg & BIT(5);
+
+			/*
+			 * In the FFE test case the sink drives which parts of
+			 * the equaliser it wants exercised via bits 2:1.
+			 */
+			if (ffe_test) {
+				u8 ffe_mode = (cfg >> 1) & 0x3;
+
+				if (ffe_mode != ffe_mode_prev || ffe_mode_prev)
+					dw_hdmi_qp_frl_set_ffe(hdmi,
+							       hdmi->flt_ffe_lv,
+							       ffe_mode);
+				else
+					dw_hdmi_qp_frl_set_ffe(hdmi,
+							       hdmi->flt_ffe_lv,
+							       FFE_BOTH_ENABLE);
+
+				ffe_mode_prev = ffe_mode;
+			}
+		}
+
+		if (!(upd & (SCDC_SINK_UPDATE_0_FRL_START |
+			     SCDC_SINK_UPDATE_0_FLT_UPDATE))) {
+			if (upd & SCDC_SINK_UPDATE_0_SOURCE_TEST)
+				drm_scdc_writeb(hdmi->bridge.ddc,
+						SCDC_UPDATE_0, upd);
+			continue;
+		}
+
+		if (!(upd & SCDC_SINK_UPDATE_0_FLT_UPDATE))
+			continue;
+
+		ret = dw_hdmi_qp_scdc_read(hdmi, SCDC_STATUS_FLAGS_1,
+				     &flags1);
+		if (!ret)
+			ret = drm_scdc_readb(hdmi->bridge.ddc,
+					     SCDC_SINK_STATUS_FLAGS_2, &flags2);
+		if (ret < 0)
+			return ret;
+
+		ltp[0] = flags1 & 0xf;
+		ltp[1] = flags1 >> 4;
+		ltp[2] = flags2 & 0xf;
+		ltp[3] = flags2 >> 4;
+
+		dev_info(hdmi->dev,
+			 "FRL: LTP request ln0=%x ln1=%x ln2=%x ln3=%x (ffe_lv=%u)\n",
+			 ltp[0], ltp[1], ltp[2], ltp[3], hdmi->flt_ffe_lv);
+
+		/* One lane on pattern 4 and the rest on 2 means FFE test. */
+		if ((ltp[0] == 4 && ltp[1] == 2 && ltp[2] == 2 && ltp[3] == 2) ||
+		    (ltp[0] == 2 && ltp[1] == 4 && ltp[2] == 2 && ltp[3] == 2) ||
+		    (ltp[0] == 2 && ltp[1] == 2 && ltp[2] == 4 && ltp[3] == 2) ||
+		    (ltp[0] == 2 && ltp[1] == 2 && ltp[2] == 2 && ltp[3] == 4))
+			ffe_test = true;
+
+		if (!ltp[0] && !ltp[1] && !ltp[2] && !ltp[3]) {
+			dw_hdmi_qp_write(hdmi, 0, FLT_CONFIG1);
+			dw_hdmi_qp_scdc_write(hdmi, SCDC_UPDATE_0, upd);
+			dev_info(hdmi->dev,
+				 "FRL: LTS3 passed at TxFFE level %u\n",
+				 hdmi->flt_ffe_lv);
+			return 0;
+		}
+
+		if (ltp[0] == 0xf || ltp[1] == 0xf ||
+		    ltp[2] == 0xf || ltp[3] == 0xf) {
+			dev_err(hdmi->dev,
+				"FRL: sink requested a lower rate (LTS4), not implemented\n");
+			return -EAGAIN;
+		}
+
+		if (ltp[0] == 0xe || ltp[1] == 0xe ||
+		    ltp[2] == 0xe || ltp[3] == 0xe) {
+			if (hdmi->flt_ffe_lv >= (frl_max_ffe_lv & 0x3)) {
+				dev_err(hdmi->dev,
+					"FRL: sink wants more TxFFE but level %u is our max\n",
+					hdmi->flt_ffe_lv);
+				return -ERANGE;
+			}
+
+			hdmi->flt_ffe_lv++;
+			ffe_mode_prev = FFE_BOTH_ENABLE;
+			dw_hdmi_qp_frl_set_ffe(hdmi, hdmi->flt_ffe_lv,
+					       FFE_BOTH_ENABLE);
+			dev_info(hdmi->dev, "FRL: raised TxFFE to level %u\n",
+				 hdmi->flt_ffe_lv);
+		} else {
+			dw_hdmi_qp_frl_set_ltp(hdmi,
+					       ltp[3] << 16 | ltp[2] << 12 |
+					       ltp[1] << 8 | ltp[0] << 4 | 0xf);
+		}
+
+		dw_hdmi_qp_scdc_write(hdmi, SCDC_UPDATE_0, upd);
+	}
+
+	dev_err(hdmi->dev, "FRL: LTS3 timed out at TxFFE level %u\n",
+		hdmi->flt_ffe_lv);
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * LTSP: link training has passed, now the actual FRL stream has to be started.
+ *
+ * The sink drives this through SCDC_UPDATE_0. FRL_START means "begin sending",
+ * FLT_UPDATE means "not good enough, train again". Skipping this phase is why
+ * an earlier version of the spike reached "training passed" and still left the
+ * monitor reporting no signal: the handshake completed but the stream never
+ * began, and the sink sat there raising FLT_UPDATE forever.
+ */
+static int dw_hdmi_qp_frl_ltsp(struct dw_hdmi_qp *hdmi)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(2000);
+	u8 val = 0;
+	int i, ret;
+
+	while (time_before(jiffies, deadline)) {
+		usleep_range(400, 600);
+
+		ret = dw_hdmi_qp_scdc_read(hdmi, SCDC_UPDATE_0, &val);
+		if (ret < 0)
+			return ret;
+
+		if (!(val & (SCDC_SINK_UPDATE_0_FRL_START |
+			     SCDC_SINK_UPDATE_0_FLT_UPDATE)))
+			continue;
+
+		if (val & SCDC_SINK_UPDATE_0_FRL_START) {
+			/* Let pixels through and start the FRL packet scheduler. */
+			dw_hdmi_qp_mod(hdmi, 0, AVP_DATAPATH_VIDEO_SWDISABLE,
+				       GLOBAL_SWDISABLE);
+			dw_hdmi_qp_scdc_write(hdmi, SCDC_UPDATE_0,
+					SCDC_SINK_UPDATE_0_FRL_START);
+			dw_hdmi_qp_write(hdmi, 2, PKTSCHED_PKT_CONTROL0);
+			dw_hdmi_qp_mod(hdmi, PKTSCHED_GCP_TX_EN,
+				       PKTSCHED_GCP_TX_EN, PKTSCHED_PKT_EN);
+
+			/* Nudge the sink with NULL packets; BSP does this too. */
+			for (i = 0; i < 200; i++) {
+				dw_hdmi_qp_mod(hdmi, PKTSCHED_NULL_TX_EN,
+					       PKTSCHED_NULL_TX_EN, PKTSCHED_PKT_EN);
+				usleep_range(50, 60);
+				dw_hdmi_qp_mod(hdmi, 0, PKTSCHED_NULL_TX_EN,
+					       PKTSCHED_PKT_EN);
+				usleep_range(50, 60);
+			}
+
+			dev_info(hdmi->dev, "FRL: FRL stream started\n");
+
+			return 0;
+		}
+
+		/* Sink wants another training round. */
+		dw_hdmi_qp_mod(hdmi, AVP_DATAPATH_VIDEO_SWDISABLE,
+			       AVP_DATAPATH_VIDEO_SWDISABLE, GLOBAL_SWDISABLE);
+		dw_hdmi_qp_scdc_write(hdmi, SCDC_UPDATE_0,
+				SCDC_SINK_UPDATE_0_FLT_UPDATE);
+
+		return -EAGAIN;
+	}
+
+	dev_err(hdmi->dev,
+		"FRL: timed out waiting for FRL start (SCDC 0x10 = 0x%02x)\n",
+		val);
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * Put the controller into FRL op mode. Must run before the PHY is powered on:
+ * Rockchip's BSP sets the op mode first and only then enables the PHY, and
+ * bringing the serialiser up in TMDS op mode and switching underneath it is
+ * not something the hardware is documented to tolerate.
+ */
+static void dw_hdmi_qp_frl_set_opmode(struct dw_hdmi_qp *hdmi, unsigned int lanes)
+{
+	dw_hdmi_qp_mod(hdmi, lanes == 4 ? OPMODE_FRL_4LANES : 0,
+		       OPMODE_FRL_4LANES, LINK_CONFIG0);
+	dw_hdmi_qp_mod(hdmi, OPMODE_FRL, OPMODE_FRL, LINK_CONFIG0);
+}
+
+static int dw_hdmi_qp_frl_train(struct dw_hdmi_qp *hdmi, unsigned int lanes,
+				unsigned int rate_per_lane);
+
+/*
+ * After the stream starts the sink is still in charge: if it loses lock it
+ * raises FLT_update and waits for the source to retrain. Without anyone
+ * watching that flag the picture drops out and comes back on its own, which is
+ * what 12 Gbps per lane does when it trains at the lowest TxFFE level and then
+ * has to carry real traffic. Retraining here also lets the sink walk the TxFFE
+ * up, which is the mechanism that is supposed to fix exactly this.
+ */
+static void dw_hdmi_qp_frl_supervise(struct work_struct *work)
+{
+	struct dw_hdmi_qp *hdmi = container_of(to_delayed_work(work),
+					       struct dw_hdmi_qp, frl_work);
+	u8 upd = 0;
+
+	/*
+	 * Everything below touches controller registers and the DDC, so it must
+	 * not overlap a modeset. Disable clears frl_lanes under this lock and
+	 * only then waits for us, which is what keeps the teardown from pulling
+	 * the clocks out from under a retrain.
+	 */
+	mutex_lock(&hdmi->frl_lock);
+
+	if (!hdmi->frl_lanes || !hdmi->curr_conn) {
+		mutex_unlock(&hdmi->frl_lock);
+		return;
+	}
+
+	if (!hdmi->frl_up) {
+		if (hdmi->frl_attempts >= FRL_TRAIN_ATTEMPTS) {
+			dev_err(hdmi->dev,
+				"FRL: link stayed down after %u attempts\n",
+				hdmi->frl_attempts);
+			mutex_unlock(&hdmi->frl_lock);
+			return;
+		}
+
+		hdmi->frl_attempts++;
+		if (hdmi->frl_attempts > 1)
+			dev_info(hdmi->dev,
+				 "FRL: retrying link training (attempt %u)\n",
+				 hdmi->frl_attempts);
+
+		if (!dw_hdmi_qp_frl_train(hdmi, hdmi->frl_lanes,
+					  hdmi->frl_rate_per_lane))
+			hdmi->frl_up = true;
+
+		goto reschedule;
+	}
+
+	if (dw_hdmi_qp_scdc_read(hdmi, SCDC_UPDATE_0, &upd) >= 0 &&
+	    (upd & SCDC_SINK_UPDATE_0_FLT_UPDATE)) {
+		dev_info(hdmi->dev,
+			 "FRL: sink lost lock, retraining from TxFFE level %u\n",
+			 hdmi->flt_ffe_lv);
+
+		/* Park the video while the link is retrained. */
+		dw_hdmi_qp_mod(hdmi, AVP_DATAPATH_VIDEO_SWDISABLE,
+			       AVP_DATAPATH_VIDEO_SWDISABLE, GLOBAL_SWDISABLE);
+		dw_hdmi_qp_scdc_write(hdmi, SCDC_UPDATE_0,
+				SCDC_SINK_UPDATE_0_FLT_UPDATE);
+
+		if (dw_hdmi_qp_frl_lts3(hdmi) || dw_hdmi_qp_frl_ltsp(hdmi)) {
+			/* Hand it to the retry path rather than leaving it dark. */
+			hdmi->frl_up = false;
+			hdmi->frl_attempts = 0;
+		}
+	}
+
+reschedule:
+	if (hdmi->frl_lanes && hdmi->curr_conn)
+		schedule_delayed_work(&hdmi->frl_work,
+				      msecs_to_jiffies(hdmi->frl_up ?
+						       FRL_SUPERVISE_INTERVAL_MS :
+						       FRL_RETRY_DELAY_MS));
+
+	mutex_unlock(&hdmi->frl_lock);
+}
+
+static int dw_hdmi_qp_frl_train(struct dw_hdmi_qp *hdmi, unsigned int lanes,
+				unsigned int rate_per_lane)
+{
+	unsigned int rate_mask = dw_hdmi_qp_frl_rate_mask(lanes, rate_per_lane);
+	int round, ret;
+
+	if (!rate_mask) {
+		dev_err(hdmi->dev, "FRL: no FRL rate for %u lanes x %u Gbps\n",
+			lanes, rate_per_lane);
+		return -EINVAL;
+	}
+
+	if (!hdmi->bridge.ddc) {
+		dev_err(hdmi->dev, "FRL: no DDC adapter\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * Every register access below assumes the controller is clocked, which
+	 * is only true while a modeset is up. Touching it after the CRTC has
+	 * been torn down wedges the AXI bus and hangs the machine hard, with
+	 * nothing in the log. curr_conn is set in atomic_enable and cleared in
+	 * atomic_disable, so it is a cheap proxy for "the controller is alive".
+	 */
+	if (!hdmi->curr_conn) {
+		dev_err(hdmi->dev, "FRL: no active modeset, refusing\n");
+		return -ENODEV;
+	}
+
+	dev_info(hdmi->dev, "FRL: training %u lanes x %u Gbps (FRL rate %u)\n",
+		 lanes, rate_per_lane, rate_mask);
+
+	/* Let the PHY output settle before starting link training. */
+	msleep(50);
+
+	ret = dw_hdmi_qp_frl_lts1(hdmi);
+	if (ret)
+		goto fail;
+
+	ret = dw_hdmi_qp_frl_lts2(hdmi, rate_mask);
+	if (ret)
+		goto fail;
+
+	for (round = 0; round < 5; round++) {
+		ret = dw_hdmi_qp_frl_lts3(hdmi);
+		if (ret)
+			goto fail;
+
+		ret = dw_hdmi_qp_frl_ltsp(hdmi);
+		if (!ret)
+			break;
+		if (ret != -EAGAIN)
+			goto fail;
+
+		dev_info(hdmi->dev,
+			 "FRL: sink asked to retrain, round %d\n", round + 2);
+	}
+
+	if (ret) {
+		dev_err(hdmi->dev, "FRL: sink kept asking to retrain\n");
+		goto fail;
+	}
+
+	dev_info(hdmi->dev, "FRL link up: %u lanes x %u Gbps (TxFFE level %u)\n",
+		 lanes, rate_per_lane, hdmi->flt_ffe_lv);
+
+	return 0;
+
+fail:
+	dev_err(hdmi->dev, "FRL link training failed: %d\n", ret);
+
+	return ret;
+}
