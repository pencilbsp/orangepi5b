+#define FFE_PRE_SHOOT_ENABLE		BIT(0)
+#define FFE_DE_EMPHASIS_ENABLE		BIT(1)
+
+/*
+ * FRL transmit FFE.
+ *
+ * rk_hdptx_frl_lane_init_seq programs LANE_REG(03/04/05/06 04) = 0x14
+ * (de-emphasis 4, override enabled) and LANE_REG(..05) = 0x4f (pre-shoot 3),
+ * which is level 0 below. Higher levels only raise de-emphasis. The sink asks
+ * for a level increase during FRL link training when the eye is not open
+ * enough at the requested rate, which is what 8 Gbps per lane and above need.
+ */
+static const struct {
+	u8 pre_shoot;
+	u8 de_emphasis;
+} rk_hdptx_frl_ffe_cfg[] = {
+	{ 0x3, 0x4 },
+	{ 0x3, 0x6 },
+	{ 0x3, 0x8 },
+	{ 0x3, 0x9 },
+};
+
+static void rk_hdptx_frl_apply_ffe(struct rk_hdptx_phy *hdptx)
+{
+	static const u32 post_reg[] = { LANE_REG(0304), LANE_REG(0404),
+					LANE_REG(0504), LANE_REG(0604) };
+	static const u32 pre_reg[]  = { LANE_REG(0305), LANE_REG(0405),
+					LANE_REG(0505), LANE_REG(0605) };
+	u8 pre_shoot, de_emphasis;
+	int i;
+
+	if (hdptx->hdmi_cfg.mode != PHY_HDMI_MODE_FRL)
+		return;
+
+	if (hdptx->hdmi_cfg.ffe_lv >= ARRAY_SIZE(rk_hdptx_frl_ffe_cfg))
+		return;
+
+	pre_shoot = rk_hdptx_frl_ffe_cfg[hdptx->hdmi_cfg.ffe_lv].pre_shoot;
+	de_emphasis = rk_hdptx_frl_ffe_cfg[hdptx->hdmi_cfg.ffe_lv].de_emphasis;
+
+	if (!(hdptx->hdmi_cfg.ffe_mode & FFE_PRE_SHOOT_ENABLE))
+		pre_shoot = 0;
+	if (!(hdptx->hdmi_cfg.ffe_mode & FFE_DE_EMPHASIS_ENABLE))
+		de_emphasis = 0;
+
+	for (i = 0; i < 4; i++) {
+		regmap_update_bits(hdptx->regmap, post_reg[i],
+				   LN_TX_DRV_POST_LVL_CTRL_MASK,
+				   FIELD_PREP(LN_TX_DRV_POST_LVL_CTRL_MASK,
+					      de_emphasis));
+		regmap_update_bits(hdptx->regmap, pre_reg[i],
+				   LN_TX_DRV_PRE_LVL_CTRL_MASK,
+				   FIELD_PREP(LN_TX_DRV_PRE_LVL_CTRL_MASK,
+					      pre_shoot));
+	}
+
+	dev_dbg(hdptx->dev, "FRL TxFFE lv=%u mode=%u pre=%u de=%u\n",
+		hdptx->hdmi_cfg.ffe_lv, hdptx->hdmi_cfg.ffe_mode,
+		pre_shoot, de_emphasis);
+}
