+/**
+ * drm_hdmi_frl_link_rate - FRL rate usable between this source and sink
+ * @connector: connector to query
+ *
+ * Returns the aggregate FRL bandwidth in bits per second that both ends can
+ * sustain, or 0 when either end is TMDS only.
+ */
+unsigned long long drm_hdmi_frl_link_rate(const struct drm_connector *connector)
+{
+	const struct drm_hdmi_info *sink = &connector->display_info.hdmi;
+	unsigned int rate_per_lane;
+
+	if (!connector->hdmi.max_frl_rate_per_lane)
+		return 0;
+
+	if (!sink->max_lanes || !sink->max_frl_rate_per_lane)
+		return 0;
+
+	rate_per_lane = min_t(unsigned int, sink->max_frl_rate_per_lane,
+			      connector->hdmi.max_frl_rate_per_lane);
+
+	return (unsigned long long)sink->max_lanes * rate_per_lane * 1000000000ULL;
+}
+EXPORT_SYMBOL(drm_hdmi_frl_link_rate);
+
+/**
+ * drm_hdmi_frl_payload_rate - FRL bandwidth a TMDS character rate needs
+ * @tmds_char_rate: character rate the mode would need on a TMDS link
+ *
+ * A TMDS character period carries 24 bits of pixel data, and FRL wraps that in
+ * 16b/18b coding, so the link has to carry an eighth more than the raw payload.
+ */
+unsigned long long drm_hdmi_frl_payload_rate(unsigned long long tmds_char_rate)
+{
+	return DIV_ROUND_UP_ULL(tmds_char_rate * 24 * 18, 16);
+}
+EXPORT_SYMBOL(drm_hdmi_frl_payload_rate);
+
+/* HDMI 2.1 FRL rates, ascending. */
+static const struct {
+	u8 lanes;
+	u8 rate_per_lane;
+} drm_hdmi_frl_rates[] = {
+	{ 3,  3 },	/* FRL1,  9 Gbps */
+	{ 3,  6 },	/* FRL2, 18 Gbps */
+	{ 4,  6 },	/* FRL3, 24 Gbps */
+	{ 4,  8 },	/* FRL4, 32 Gbps */
+	{ 4, 10 },	/* FRL5, 40 Gbps */
+	{ 4, 12 },	/* FRL6, 48 Gbps */
+};
+
+/**
+ * drm_hdmi_frl_select_rate - pick an FRL configuration for a mode
+ * @connector: connector the mode will run on
+ * @tmds_char_rate: character rate the mode would need on a TMDS link
+ * @lanes: filled with the lane count to train
+ * @rate_per_lane: filled with the per-lane rate in Gbps
+ *
+ * Chooses the slowest standard FRL rate that carries the payload and that both
+ * ends support. Running no faster than necessary keeps link margin, which is
+ * the opposite of what the vendor driver does: it always asks for the sink's
+ * maximum and then clamps the result to 40 Gbps.
+ *
+ * Returns 0 on success, -ERANGE when no supported rate is fast enough.
+ */
+int drm_hdmi_frl_select_rate(const struct drm_connector *connector,
+			     unsigned long long tmds_char_rate,
+			     u8 *lanes, u8 *rate_per_lane)
+{
+	const struct drm_hdmi_info *sink = &connector->display_info.hdmi;
+	unsigned long long needed = drm_hdmi_frl_payload_rate(tmds_char_rate);
+	unsigned int src_max = connector->hdmi.max_frl_rate_per_lane;
+	int i;
+
+	if (!src_max || !sink->max_lanes || !sink->max_frl_rate_per_lane)
+		return -ERANGE;
+
+	for (i = 0; i < ARRAY_SIZE(drm_hdmi_frl_rates); i++) {
+		u8 l = drm_hdmi_frl_rates[i].lanes;
+		u8 r = drm_hdmi_frl_rates[i].rate_per_lane;
+
+		if (l > sink->max_lanes || r > sink->max_frl_rate_per_lane ||
+		    r > src_max)
+			continue;
+
+		if ((unsigned long long)l * r * 1000000000ULL < needed)
+			continue;
+
+		*lanes = l;
+		*rate_per_lane = r;
+
+		return 0;
+	}
+
+	return -ERANGE;
+}
+EXPORT_SYMBOL(drm_hdmi_frl_select_rate);
