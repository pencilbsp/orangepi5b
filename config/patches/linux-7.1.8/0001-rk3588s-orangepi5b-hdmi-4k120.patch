+static u32 *
+dw_hdmi_qp_bridge_get_output_bus_fmts(struct drm_bridge *bridge,
+				      struct drm_bridge_state *bridge_state,
+				      struct drm_crtc_state *crtc_state,
+				      struct drm_connector_state *conn_state,
+				      unsigned int *num_output_fmts)
+{
+	u32 *out_fmts;
+	u32 bus_fmt;
+
+	*num_output_fmts = 0;
+
+	if (!(bridge->supported_formats & BIT(conn_state->hdmi.output_format)))
+		return NULL;
+
+	switch (conn_state->hdmi.output_bpc) {
+	case 12:
+		switch (conn_state->hdmi.output_format) {
+		case DRM_OUTPUT_COLOR_FORMAT_RGB444:
+			bus_fmt = MEDIA_BUS_FMT_RGB121212_1X36;
+			break;
+		case DRM_OUTPUT_COLOR_FORMAT_YCBCR444:
+			bus_fmt = MEDIA_BUS_FMT_YUV12_1X36;
+			break;
+		case DRM_OUTPUT_COLOR_FORMAT_YCBCR422:
+			bus_fmt = MEDIA_BUS_FMT_UYVY12_1X24;
+			break;
+		case DRM_OUTPUT_COLOR_FORMAT_YCBCR420:
+			bus_fmt = MEDIA_BUS_FMT_UYYVYY12_0_5X36;
+			break;
+		default:
+			return NULL;
+		}
+		break;
+	case 10:
+		switch (conn_state->hdmi.output_format) {
+		case DRM_OUTPUT_COLOR_FORMAT_RGB444:
+			bus_fmt = MEDIA_BUS_FMT_RGB101010_1X30;
+			break;
+		case DRM_OUTPUT_COLOR_FORMAT_YCBCR444:
+			bus_fmt = MEDIA_BUS_FMT_YUV10_1X30;
+			break;
+		case DRM_OUTPUT_COLOR_FORMAT_YCBCR422:
+			bus_fmt = MEDIA_BUS_FMT_UYVY10_1X20;
+			break;
+		case DRM_OUTPUT_COLOR_FORMAT_YCBCR420:
+			bus_fmt = MEDIA_BUS_FMT_UYYVYY10_0_5X30;
+			break;
+		default:
+			return NULL;
+		}
+		break;
+	case 8:
+		switch (conn_state->hdmi.output_format) {
+		case DRM_OUTPUT_COLOR_FORMAT_RGB444:
+			bus_fmt = MEDIA_BUS_FMT_RGB888_1X24;
+			break;
+		case DRM_OUTPUT_COLOR_FORMAT_YCBCR444:
+			bus_fmt = MEDIA_BUS_FMT_YUV8_1X24;
+			break;
+		case DRM_OUTPUT_COLOR_FORMAT_YCBCR422:
+			bus_fmt = MEDIA_BUS_FMT_UYVY8_1X16;
+			break;
+		case DRM_OUTPUT_COLOR_FORMAT_YCBCR420:
+			bus_fmt = MEDIA_BUS_FMT_UYYVYY8_0_5X24;
+			break;
+		default:
+			return NULL;
+		}
+		break;
+	default:
+		return NULL;
+	}
+
+	out_fmts = kmalloc(sizeof(*out_fmts), GFP_KERNEL);
+	if (!out_fmts)
+		return NULL;
+
+	out_fmts[0] = bus_fmt;
+	*num_output_fmts = 1;
+
+	return out_fmts;
+}
