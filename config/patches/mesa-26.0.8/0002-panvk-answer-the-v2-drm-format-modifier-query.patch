    return features;
 }
 
+/* The two DRM format modifier queries differ only in the width of the feature
+ * mask, so enumerate once and let each list copy what it can hold.
+ */
+#define PANVK_MAX_FORMAT_MODIFIERS 32
+
+struct panvk_format_modifier {
+   uint64_t modifier;
+   uint32_t plane_count;
+   VkFormatFeatureFlags2 features;
+};
+
+static uint32_t
+collect_format_modifiers(const struct panvk_physical_device *physical_device,
+                         VkFormat format, VkFormatFeatureFlags2 tex,
+                         struct panvk_format_modifier *mods)
+{
+   PAN_SUPPORTED_MODIFIERS(supported);
+   const unsigned arch = pan_arch(physical_device->kmod.dev->props.gpu_id);
+   uint32_t n_mods = 0;
+
+   if (!tex)
+      return 0;
+
+   assert(ARRAY_SIZE(supported) + 1 <= PANVK_MAX_FORMAT_MODIFIERS);
+
+   if (PANVK_DEBUG(WSI_AFBC)) {
+      for (int mi = 0; mi < ARRAY_SIZE(supported); mi++) {
+         if (drm_is_afbc(supported[mi]) &&
+             pan_afbc_supports_format(arch, vk_format_to_pipe_format(format)))
+         {
+            mods[n_mods++] = (struct panvk_format_modifier){
+               .modifier = supported[mi],
+               .plane_count = 1,
+               .features = tex,
+            };
+         }
+      }
+   }
+
+   mods[n_mods++] = (struct panvk_format_modifier){
+      .modifier = DRM_FORMAT_MOD_LINEAR,
+      .plane_count = 1,
+      .features = tex,
+   };
+
+   return n_mods;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_GetPhysicalDeviceFormatProperties2(VkPhysicalDevice physicalDevice,
                                          VkFormat format,
                                          VkFormatProperties2 *pFormatProperties)
 {
    VK_FROM_HANDLE(panvk_physical_device, physical_device, physicalDevice);
-   const unsigned arch = pan_arch(physical_device->kmod.dev->props.gpu_id);
 
    VkFormatFeatureFlags2 tex =
       get_image_format_features(physical_device, format);
@@ -906,37 +953,41 @@
 
