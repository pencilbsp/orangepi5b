+static void dw_hdmi_qp_rk3588_phy_set_ffe(struct dw_hdmi_qp *dw_hdmi, void *data,
+					 u8 ffe_lv, u8 ffe_mode)
+{
+	struct rockchip_hdmi_qp *hdmi = data;
+	union phy_configure_opts phy_cfg = {};
+	int ret;
+
+	if (!hdmi->frl_lanes)
+		return;
+
+	/*
+	 * phy_configure() is the only channel to the PHY, so the whole FRL
+	 * config has to be resent, not just the FFE part.
+	 */
+	phy_cfg.hdmi.bpc = 8;
+	phy_cfg.hdmi.frl.lanes = hdmi->frl_lanes;
+	phy_cfg.hdmi.frl.rate_per_lane = hdmi->frl_rate_per_lane;
+	phy_cfg.hdmi.frl.ffe_lv = ffe_lv;
+	phy_cfg.hdmi.frl.ffe_mode = ffe_mode;
+
+	ret = phy_configure(hdmi->phy, &phy_cfg);
+	if (ret)
+		dev_err(hdmi->dev, "failed to set TxFFE level %u: %d\n",
+			ffe_lv, ret);
+}
