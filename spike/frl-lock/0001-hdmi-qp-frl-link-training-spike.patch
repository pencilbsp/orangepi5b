+/*
+ * FRL bring-up spike. Writing an FRL rate per lane (3, 6, 8, 10 or 12) to
+ *
+ *	/sys/devices/platform/fde80000.hdmi/frl_spike
+ *
+ * switches the PHY and the controller to 4-lane FRL at that rate and runs
+ * link training once, on whatever mode is currently active. This is one-way:
+ * the display goes down afterwards and only a reboot brings it back.
+ *
+ * This deliberately bypasses the atomic modeset path: nothing here runs at
+ * boot, and the default behaviour of the driver is unchanged. See
+ * dw_hdmi_qp_frl_spike() for what is and is not implemented.
+ */
+static void rockchip_hdmi_qp_set_link_mode(struct rockchip_hdmi_qp *hdmi,
+					   bool frl)
+{
+	regmap_write(hdmi->vo_regmap,
+		     hdmi->port_id ? RK3588_GRF_VO1_CON7 : RK3588_GRF_VO1_CON4,
+		     FIELD_PREP_WM16(RK3588_HDMI21_MASK, frl ? 1 : 0));
+}
+
+static ssize_t frl_spike_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t len)
+{
+	struct rockchip_hdmi_qp *hdmi = dev_get_drvdata(dev);
+	union phy_configure_opts phy_cfg = {};
+	unsigned int rate_per_lane, lanes = 4;
+	int ret;
+
+	/* "<rate>" means 4 lanes; "<lanes>:<rate>" picks the lane count. */
+	if (sscanf(buf, "%u:%u", &lanes, &rate_per_lane) != 2) {
+		lanes = 4;
+		ret = kstrtouint(buf, 0, &rate_per_lane);
+		if (ret)
+			return ret;
+	}
+
+	if (lanes != 3 && lanes != 4)
+		return -EINVAL;
+
+	/*
+	 * There is no way back. Undoing this means touching the controller
+	 * after DRM has torn the CRTC down and powered the PHY off, and those
+	 * register accesses hang the SoC with nothing in the log. Reboot is the
+	 * only supported recovery, and it is a clean one: the modules that boot
+	 * come from the initramfs, not from /lib/modules.
+	 */
+	if (!rate_per_lane) {
+		dev_err(hdmi->dev, "frl-spike: cannot return to TMDS, reboot instead\n");
+		return -EINVAL;
+	}
+
+	/* The next modeset must reconfigure the PHY rather than bail early. */
+	hdmi->tmds_char_rate = 0;
+
+	gpiod_set_value_cansleep(hdmi->frl_enable_gpio, 1);
+	rockchip_hdmi_qp_set_link_mode(hdmi, true);
+
+	phy_power_off(hdmi->phy);
+
+	ret = phy_set_mode_ext(hdmi->phy, PHY_MODE_HDMI, PHY_HDMI_MODE_FRL);
+	if (ret) {
+		dev_err(hdmi->dev, "frl-spike: phy_set_mode failed: %d\n", ret);
+		return ret;
+	}
+
+	hdmi->frl_lanes = lanes;
+	hdmi->frl_rate_per_lane = rate_per_lane;
+
+	phy_cfg.hdmi.bpc = 8;
+	phy_cfg.hdmi.frl.lanes = hdmi->frl_lanes;
+	phy_cfg.hdmi.frl.rate_per_lane = hdmi->frl_rate_per_lane;
+	phy_cfg.hdmi.frl.ffe_lv = 0;
+	phy_cfg.hdmi.frl.ffe_mode = 0x3;
+
+	ret = phy_configure(hdmi->phy, &phy_cfg);
+	if (ret) {
+		dev_err(hdmi->dev, "frl-spike: phy_configure failed: %d\n", ret);
+		return ret;
+	}
+
+	/* Controller into FRL op mode first, then bring the PHY up. */
+	dw_hdmi_qp_frl_set_opmode(hdmi->hdmi, lanes);
+
+	ret = phy_power_on(hdmi->phy);
+	if (ret) {
+		dev_err(hdmi->dev, "frl-spike: phy_power_on failed: %d\n", ret);
+		return ret;
+	}
+
+	ret = dw_hdmi_qp_frl_spike(hdmi->hdmi, lanes, rate_per_lane);
+	if (ret)
+		return ret;
+
+	return len;
+}
