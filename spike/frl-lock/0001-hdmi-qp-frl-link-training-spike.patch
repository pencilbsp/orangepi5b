 #define EARCRX_1_INT_CLEAR				0x4828
 #define EARCRX_1_INT_FORCE				0x482c
 
+/*
+ * Sink-side SCDC offsets used by FRL link training (HDMI 2.1 SCDC map).
+ * Prefixed SCDC_SINK_ to avoid clashing with the controller-side SCDC_*
+ * register block above, which lives at 0x140..0x150.
+ */
+#define SCDC_SINK_CONFIG_1				0x31
+#define SCDC_SINK_STATUS_FLAGS_0_FLT_READY		BIT(6)
+#define SCDC_SINK_UPDATE_0_SOURCE_TEST			BIT(3)
+#define SCDC_SINK_UPDATE_0_FRL_START			BIT(4)
+#define SCDC_SINK_UPDATE_0_FLT_UPDATE			BIT(5)
+#define SCDC_SINK_SOURCE_TEST_CONFIG			0x35
+#define SCDC_SINK_STATUS_FLAGS_2			0x42
+
 #endif /* __DW_HDMI_QP_H__ */
diff -Naur '--exclude=.git' '--exclude=*.orig' '--exclude=*.rej' '--exclude=include-prefixes' a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
@@ -7,7 +7,9 @@
  * Author: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
  */
 #include <linux/completion.h>
+#include <linux/delay.h>
 #include <linux/hdmi.h>
+#include <linux/jiffies.h>
 #include <linux/export.h>
 #include <linux/i2c.h>
 #include <linux/irq.h>
