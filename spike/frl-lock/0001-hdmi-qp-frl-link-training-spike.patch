+	bool flt_no_timeout;
+	u8 flt_ffe_lv;
 };
 
 static void dw_hdmi_qp_write(struct dw_hdmi_qp *hdmi, unsigned int val,
@@ -1558,6 +1564,406 @@
 }
 EXPORT_SYMBOL_GPL(dw_hdmi_qp_resume);
 
+/*
+ * FRL bring-up spike.
+ *
+ * Answers exactly one question: can this board train a Fixed Rate Link with
+ * the attached sink?  It implements LTS1..LTS3 of the HDMI 2.1 link training
+ * state machine and stops as soon as the sink reports a pass (LTSP).
+ *
+ * Deliberately not implemented, because the spike does not need them:
+ *   - LTS4, the sink-requested rate change: reported as a failure instead.
+ *   - TxFFE level adjustment: the sink's "raise TxFFE" request is refused,
+ *     which costs link margin but keeps the PHY out of the picture.
+ *   - The LTSP poll loop that watches for the sink dropping the link later.
+ *   - Audio, DSC, and any interaction with the atomic modeset path.
+ *   - Any way back to TMDS. Once this has run, the next atomic_check fails
+ *     with -EINVAL because the PHY is in FRL mode while DRM still asks for a
+ *     TMDS char rate, and the CRTC is torn down. Reboot to recover; do not
+ *     try to undo it by poking the controller, which by then is unclocked.
+ *
+ * The caller (platform glue) is responsible for putting the PHY into FRL
+ * mode and re-powering it before calling in here.
+ */
+
+/*
+ * How much TxFFE headroom we tell the sink we have. Declaring 0 means the sink
+ * has no way to ask for more equalisation, which is fine at 6 Gbps per lane
+ * and fatal above it: the sink simply gives up and resets, taking SCDC with
+ * it. Rockchip's BSP exposes the same value as a per-board DT property.
+ */
+static unsigned int frl_max_ffe_lv = 3;
+module_param(frl_max_ffe_lv, uint, 0644);
+MODULE_PARM_DESC(frl_max_ffe_lv, "FRL max TxFFE level advertised to the sink, 0-3");
+
+#define FRL_SPIKE_LTS2_TIMEOUT_MS	400
+#define FRL_SPIKE_LTS3_TIMEOUT_MS	2000
+
+#define FFE_PRE_SHOOT_ENABLE		BIT(0)
+#define FFE_DE_EMPHASIS_ENABLE		BIT(1)
+#define FFE_BOTH_ENABLE			(FFE_PRE_SHOOT_ENABLE | FFE_DE_EMPHASIS_ENABLE)
+
+static void dw_hdmi_qp_frl_set_ffe(struct dw_hdmi_qp *hdmi, u8 ffe_lv, u8 ffe_mode)
+{
+	if (!hdmi->phy.ops->set_ffe)
+		return;
+
+	hdmi->phy.ops->set_ffe(hdmi, hdmi->phy.data, ffe_lv, ffe_mode);
+}
+
+/*
+ * The sink asks for the "all lanes pattern 3" code when it wants the source to
+ * keep whatever it is already sending. Re-writing the register in that case
+ * would restart the pattern, so feed the current value back instead.
+ */
+static void dw_hdmi_qp_frl_set_ltp(struct dw_hdmi_qp *hdmi, u32 value)
+{
+	if (!hdmi->flt_no_timeout && value == 0x3333f)
+		value = dw_hdmi_qp_read(hdmi, FLT_CONFIG1);
+
+	dw_hdmi_qp_write(hdmi, value, FLT_CONFIG1);
+}
+
+static unsigned int dw_hdmi_qp_frl_rate_mask(unsigned int lanes,
+					     unsigned int rate_per_lane)
+{
+	switch (lanes * rate_per_lane) {
+	case 9:		/* 3 Gbps x 3 lanes */
+		return 1;
+	case 18:	/* 6 Gbps x 3 lanes */
+		return 2;
+	case 24:	/* 6 Gbps x 4 lanes */
+		return 3;
+	case 32:	/* 8 Gbps x 4 lanes */
+		return 4;
+	case 40:	/* 10 Gbps x 4 lanes */
+		return 5;
+	case 48:	/* 12 Gbps x 4 lanes */
+		return 6;
+	}
+
+	return 0;
+}
+
+static int dw_hdmi_qp_frl_lts1(struct dw_hdmi_qp *hdmi)
+{
+	u8 val = 0;
+	int ret;
+
+	/* Park the video datapath while the link is retrained. */
+	dw_hdmi_qp_mod(hdmi, AVP_DATAPATH_VIDEO_SWDISABLE,
+		       AVP_DATAPATH_VIDEO_SWDISABLE, GLOBAL_SWDISABLE);
+	dw_hdmi_qp_write(hdmi, BIT(6), GLOBAL_SWRESET_REQUEST);
+
+	ret = drm_scdc_readb(hdmi->bridge.ddc, SCDC_SINK_VERSION, &val);
+	if (ret < 0) {
+		dev_err(hdmi->dev, "frl-spike: SCDC read failed: %d\n", ret);
+		return ret;
+	}
+
+	if (!val) {
+		dev_err(hdmi->dev, "frl-spike: sink reports SCDC version 0\n");
+		return -ENODEV;
+	}
+
+	ret = drm_scdc_writeb(hdmi->bridge.ddc, SCDC_SOURCE_VERSION, 1);
+	if (ret < 0) {
+		dev_err(hdmi->dev, "frl-spike: SCDC write failed: %d\n", ret);
+		return ret;
+	}
+
+	hdmi->flt_no_timeout = false;
+	if (!drm_scdc_readb(hdmi->bridge.ddc, SCDC_SINK_SOURCE_TEST_CONFIG, &val))
+		hdmi->flt_no_timeout = val & BIT(5);
+
+	dev_info(hdmi->dev, "frl-spike: LTS1 done, flt_no_timeout=%d\n",
+		 hdmi->flt_no_timeout);
+
+	return 0;
+}
+
+static int dw_hdmi_qp_frl_lts2(struct dw_hdmi_qp *hdmi, unsigned int rate_mask)
+{
+	unsigned long deadline = jiffies +
+				 msecs_to_jiffies(FRL_SPIKE_LTS2_TIMEOUT_MS);
+	u8 val = 0;
+	int ret;
+
+	do {
+		ret = drm_scdc_readb(hdmi->bridge.ddc, SCDC_STATUS_FLAGS_0, &val);
+		if (ret < 0)
+			return ret;
+
+		if (val & SCDC_SINK_STATUS_FLAGS_0_FLT_READY)
+			break;
+
+		msleep(20);
+	} while (time_before(jiffies, deadline));
+
+	if (!(val & SCDC_SINK_STATUS_FLAGS_0_FLT_READY)) {
+		dev_err(hdmi->dev,
+			"frl-spike: sink never raised FLT_ready (SCDC 0x40 = 0x%02x)\n",
+			val);
+		return -ETIMEDOUT;
+	}
+
+	/* Tell the sink which rate we will train and how much TxFFE we have. */
+	hdmi->flt_ffe_lv = 0;
+	dw_hdmi_qp_frl_set_ffe(hdmi, 0, FFE_BOTH_ENABLE);
+
+	ret = drm_scdc_writeb(hdmi->bridge.ddc, SCDC_SINK_CONFIG_1,
+			      (frl_max_ffe_lv & 0x3) << 4 | rate_mask);
+	if (ret < 0)
+		return ret;
+
+	ret = drm_scdc_writeb(hdmi->bridge.ddc, SCDC_CONFIG_0, 0);
+	if (ret < 0)
+		return ret;
+
+	dev_info(hdmi->dev, "frl-spike: LTS2 done, advertised max TxFFE level %u\n",
+		 frl_max_ffe_lv & 0x3);
+
+	return 0;
+}
+
+static int dw_hdmi_qp_frl_lts3(struct dw_hdmi_qp *hdmi)
+{
+	unsigned long deadline = jiffies +
+				 msecs_to_jiffies(FRL_SPIKE_LTS3_TIMEOUT_MS);
+	u8 ffe_mode_prev = 0;
+	bool ffe_test = false;
+	u8 upd, flags1, flags2;
+	u8 ltp[4];
+	int ret;
+
+	while (time_before(jiffies, deadline) || hdmi->flt_no_timeout) {
+		/* The spec wants the source to poll at least every 2 ms. */
+		usleep_range(400, 600);
+
+		ret = drm_scdc_readb(hdmi->bridge.ddc, SCDC_UPDATE_0, &upd);
+		if (ret < 0)
+			return ret;
+
+		if (upd & SCDC_SINK_UPDATE_0_SOURCE_TEST) {
+			u8 cfg = 0;
+
+			ret = drm_scdc_readb(hdmi->bridge.ddc,
+					     SCDC_SINK_SOURCE_TEST_CONFIG, &cfg);
+			if (ret < 0)
+				return ret;
+
+			hdmi->flt_no_timeout = cfg & BIT(5);
+
+			/*
+			 * In the FFE test case the sink drives which parts of
+			 * the equaliser it wants exercised via bits 2:1.
+			 */
+			if (ffe_test) {
+				u8 ffe_mode = (cfg >> 1) & 0x3;
+
+				if (ffe_mode != ffe_mode_prev || ffe_mode_prev)
+					dw_hdmi_qp_frl_set_ffe(hdmi,
+							       hdmi->flt_ffe_lv,
+							       ffe_mode);
+				else
+					dw_hdmi_qp_frl_set_ffe(hdmi,
+							       hdmi->flt_ffe_lv,
+							       FFE_BOTH_ENABLE);
+
+				ffe_mode_prev = ffe_mode;
+			}
+		}
+
+		if (!(upd & (SCDC_SINK_UPDATE_0_FRL_START |
+			     SCDC_SINK_UPDATE_0_FLT_UPDATE))) {
+			if (upd & SCDC_SINK_UPDATE_0_SOURCE_TEST)
+				drm_scdc_writeb(hdmi->bridge.ddc,
+						SCDC_UPDATE_0, upd);
+			continue;
+		}
+
+		if (!(upd & SCDC_SINK_UPDATE_0_FLT_UPDATE))
+			continue;
+
+		ret = drm_scdc_readb(hdmi->bridge.ddc, SCDC_STATUS_FLAGS_1,
+				     &flags1);
+		if (!ret)
+			ret = drm_scdc_readb(hdmi->bridge.ddc,
+					     SCDC_SINK_STATUS_FLAGS_2, &flags2);
+		if (ret < 0)
+			return ret;
+
+		ltp[0] = flags1 & 0xf;
+		ltp[1] = flags1 >> 4;
+		ltp[2] = flags2 & 0xf;
+		ltp[3] = flags2 >> 4;
+
+		dev_info(hdmi->dev,
+			 "frl-spike: LTP request ln0=%x ln1=%x ln2=%x ln3=%x (ffe_lv=%u)\n",
+			 ltp[0], ltp[1], ltp[2], ltp[3], hdmi->flt_ffe_lv);
+
+		/* One lane on pattern 4 and the rest on 2 means FFE test. */
+		if ((ltp[0] == 4 && ltp[1] == 2 && ltp[2] == 2 && ltp[3] == 2) ||
+		    (ltp[0] == 2 && ltp[1] == 4 && ltp[2] == 2 && ltp[3] == 2) ||
+		    (ltp[0] == 2 && ltp[1] == 2 && ltp[2] == 4 && ltp[3] == 2) ||
+		    (ltp[0] == 2 && ltp[1] == 2 && ltp[2] == 2 && ltp[3] == 4))
+			ffe_test = true;
+
+		if (!ltp[0] && !ltp[1] && !ltp[2] && !ltp[3]) {
+			dw_hdmi_qp_write(hdmi, 0, FLT_CONFIG1);
+			drm_scdc_writeb(hdmi->bridge.ddc, SCDC_UPDATE_0, upd);
+			dev_info(hdmi->dev,
+				 "frl-spike: LTS3 passed at TxFFE level %u\n",
+				 hdmi->flt_ffe_lv);
+			return 0;
+		}
+
+		if (ltp[0] == 0xf || ltp[1] == 0xf ||
+		    ltp[2] == 0xf || ltp[3] == 0xf) {
+			dev_err(hdmi->dev,
+				"frl-spike: sink requested a lower rate (LTS4), not implemented\n");
+			return -EAGAIN;
+		}
+
+		if (ltp[0] == 0xe || ltp[1] == 0xe ||
+		    ltp[2] == 0xe || ltp[3] == 0xe) {
+			if (hdmi->flt_ffe_lv >= (frl_max_ffe_lv & 0x3)) {
+				dev_err(hdmi->dev,
+					"frl-spike: sink wants more TxFFE but level %u is our max\n",
+					hdmi->flt_ffe_lv);
+				return -ERANGE;
+			}
+
+			hdmi->flt_ffe_lv++;
+			ffe_mode_prev = FFE_BOTH_ENABLE;
+			dw_hdmi_qp_frl_set_ffe(hdmi, hdmi->flt_ffe_lv,
+					       FFE_BOTH_ENABLE);
+			dev_info(hdmi->dev, "frl-spike: raised TxFFE to level %u\n",
+				 hdmi->flt_ffe_lv);
+		} else {
+			dw_hdmi_qp_frl_set_ltp(hdmi,
+					       ltp[3] << 16 | ltp[2] << 12 |
+					       ltp[1] << 8 | ltp[0] << 4 | 0xf);
+		}
+
+		drm_scdc_writeb(hdmi->bridge.ddc, SCDC_UPDATE_0, upd);
+	}
+
+	dev_err(hdmi->dev, "frl-spike: LTS3 timed out at TxFFE level %u\n",
+		hdmi->flt_ffe_lv);
+
+	return -ETIMEDOUT;
+}
+
+static void dw_hdmi_qp_frl_report(struct dw_hdmi_qp *hdmi)
+{
+	u8 f0 = 0, f1 = 0, f2 = 0, upd = 0;
+	int i;
+
+	/*
+	 * Sample the link for a moment while it is still up. A failed
+	 * atomic_check tears the CRTC down roughly 1.5s after this returns, so
+	 * keep the window short.
+	 */
+	for (i = 0; i < 5; i++) {
+		drm_scdc_readb(hdmi->bridge.ddc, SCDC_STATUS_FLAGS_0, &f0);
+		drm_scdc_readb(hdmi->bridge.ddc, SCDC_STATUS_FLAGS_1, &f1);
+		drm_scdc_readb(hdmi->bridge.ddc, SCDC_SINK_STATUS_FLAGS_2, &f2);
+		drm_scdc_readb(hdmi->bridge.ddc, SCDC_UPDATE_0, &upd);
+
+		/*
+		 * Only the sink over DDC and the controller's own SCDC block,
+		 * which link training has just exercised. Do NOT read
+		 * FRL_RSFEC_STATUS0 or FRL_PKTZ_STATUS1 here: those live in
+		 * sub-blocks that are not necessarily clocked at this point,
+		 * and reading them wedged the SoC during the rate sweep.
+		 */
+		dev_info(hdmi->dev,
+			 "frl-spike: t+%dms sink[0x40]=%02x [0x41]=%02x [0x42]=%02x [0x10]=%02x ctrl_scdc=%08x\n",
+			 i * 200, f0, f1, f2, upd,
+			 dw_hdmi_qp_read(hdmi, SCDC_STATUS0));
+
+		msleep(200);
+	}
+}
+
+/*
+ * Put the controller into FRL op mode. Must run before the PHY is powered on:
+ * Rockchip's BSP sets the op mode first and only then enables the PHY, and
+ * bringing the serialiser up in TMDS op mode and switching underneath it is
+ * not something the hardware is documented to tolerate.
+ */
+void dw_hdmi_qp_frl_set_opmode(struct dw_hdmi_qp *hdmi, unsigned int lanes)
+{
+	dw_hdmi_qp_mod(hdmi, lanes == 4 ? OPMODE_FRL_4LANES : 0,
+		       OPMODE_FRL_4LANES, LINK_CONFIG0);
+	dw_hdmi_qp_mod(hdmi, OPMODE_FRL, OPMODE_FRL, LINK_CONFIG0);
+}
+EXPORT_SYMBOL_GPL(dw_hdmi_qp_frl_set_opmode);
+
+int dw_hdmi_qp_frl_spike(struct dw_hdmi_qp *hdmi, unsigned int lanes,
+			 unsigned int rate_per_lane)
+{
+	unsigned int rate_mask = dw_hdmi_qp_frl_rate_mask(lanes, rate_per_lane);
+	int ret;
+
+	if (!rate_mask) {
+		dev_err(hdmi->dev, "frl-spike: no FRL rate for %u lanes x %u Gbps\n",
+			lanes, rate_per_lane);
+		return -EINVAL;
+	}
+
+	if (!hdmi->bridge.ddc) {
+		dev_err(hdmi->dev, "frl-spike: no DDC adapter\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * Every register access below assumes the controller is clocked, which
+	 * is only true while a modeset is up. Touching it after the CRTC has
+	 * been torn down wedges the AXI bus and hangs the machine hard, with
+	 * nothing in the log. curr_conn is set in atomic_enable and cleared in
+	 * atomic_disable, so it is a cheap proxy for "the controller is alive".
+	 */
+	if (!hdmi->curr_conn) {
+		dev_err(hdmi->dev, "frl-spike: no active modeset, refusing\n");
+		return -ENODEV;
+	}
+
+	dev_info(hdmi->dev, "frl-spike: training %u lanes x %u Gbps (FRL rate %u)\n",
+		 lanes, rate_per_lane, rate_mask);
+
+	/* Let the PHY output settle before starting link training. */
+	msleep(50);
+
+	ret = dw_hdmi_qp_frl_lts1(hdmi);
+	if (ret)
+		goto fail;
+
+	ret = dw_hdmi_qp_frl_lts2(hdmi, rate_mask);
+	if (ret)
+		goto fail;
+
+	ret = dw_hdmi_qp_frl_lts3(hdmi);
+	if (ret)
+		goto fail;
+
+	/* Let pixels through again so the sink has something to display. */
+	dw_hdmi_qp_mod(hdmi, 0, AVP_DATAPATH_VIDEO_SWDISABLE, GLOBAL_SWDISABLE);
+
+	dev_info(hdmi->dev, "frl-spike: PASS\n");
+
+	dw_hdmi_qp_frl_report(hdmi);
+
+	return 0;
+
+fail:
+	dev_err(hdmi->dev, "frl-spike: FAIL (%d)\n", ret);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(dw_hdmi_qp_frl_spike);
