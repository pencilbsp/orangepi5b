+static unsigned int dw_hdmi_qp_frl_debug_interval(void)
+{
+	unsigned int interval = dw_hdmi_qp_frl_debug_interval_ms;
+
+	if (interval < 100)
+		interval = 100;
+	if (interval > 60000)
+		interval = 60000;
+
+	return interval;
+}
+
+static u16 dw_hdmi_qp_frl_debug_ced_counter(const u8 *raw, unsigned int offset)
+{
+	return ((raw[offset + 1] & 0x7f) << 8) | raw[offset];
+}
+
+static void dw_hdmi_qp_frl_debug_work(struct work_struct *work)
+{
+	struct delayed_work *dwork = to_delayed_work(work);
+	struct dw_hdmi_qp *hdmi = container_of(dwork, struct dw_hdmi_qp,
+					       frl_debug_work);
+	u8 upd0 = 0, upd1 = 0, cfg0 = 0, sink_cfg1 = 0;
+	u8 status0 = 0, ltp01 = 0, ltp23 = 0;
+	u8 ced[11] = {};
+	u32 link, flt0, flt1, flt2, flt_ctrl;
+	u32 scdc_cfg, scdc_ctrl, scdc_status;
+	u32 rsfec_cfg, rsfec_status;
+	u32 pktz_cfg, pktz_ctrl0, pktz_ctrl1, pktz_status1;
+	u32 swdisable, pkten, main_irq, avp1_irq, avp3_irq;
+	u32 video_if_status, video_mon_status;
+	u32 sample;
+	int hpd = -1;
+	int ret;
+
+	if (!READ_ONCE(dw_hdmi_qp_frl_debug) ||
+	    !READ_ONCE(hdmi->frl_debug_active))
+		return;
+
+	if (!mutex_trylock(&hdmi->mutex))
+		goto requeue;
+
+	link = hdmi_readl(hdmi, LINK_CONFIG0);
+	if (!hdmi->curr_conn || hdmi->disabled || !hdmi->ddc ||
+	    !(link & OPMODE_FRL)) {
+		WRITE_ONCE(hdmi->frl_debug_active, false);
+		mutex_unlock(&hdmi->mutex);
+		return;
+	}
+
+	sample = ++hdmi->frl_debug_sample;
+
+	flt0 = hdmi_readl(hdmi, FLT_CONFIG0);
+	flt1 = hdmi_readl(hdmi, FLT_CONFIG1);
+	flt2 = hdmi_readl(hdmi, FLT_CONFIG2);
+	flt_ctrl = hdmi_readl(hdmi, FLT_CONTROL0);
+	scdc_cfg = hdmi_readl(hdmi, SCDC_CONFIG0);
+	scdc_ctrl = hdmi_readl(hdmi, SCDC_CONTROL0);
+	scdc_status = hdmi_readl(hdmi, SCDC_STATUS0);
+	rsfec_cfg = hdmi_readl(hdmi, FRL_RSFEC_CONFIG0);
+	rsfec_status = hdmi_readl(hdmi, FRL_RSFEC_STATUS0);
+	pktz_cfg = hdmi_readl(hdmi, FRL_PKTZ_CONFIG0);
+	pktz_ctrl0 = hdmi_readl(hdmi, FRL_PKTZ_CONTROL0);
+	pktz_ctrl1 = hdmi_readl(hdmi, FRL_PKTZ_CONTROL1);
+	pktz_status1 = hdmi_readl(hdmi, FRL_PKTZ_STATUS1);
+	swdisable = hdmi_readl(hdmi, GLOBAL_SWDISABLE);
+	pkten = hdmi_readl(hdmi, PKTSCHED_PKT_EN);
+	main_irq = hdmi_readl(hdmi, MAINUNIT_1_INT_STATUS);
+	avp1_irq = hdmi_readl(hdmi, AVP_1_INT_STATUS);
+	avp3_irq = hdmi_readl(hdmi, AVP_3_INT_STATUS);
+	video_if_status = hdmi_readl(hdmi, VIDEO_INTERFACE_STATUS0);
+	video_mon_status = hdmi_readl(hdmi, VIDEO_MONITOR_STATUS0);
+
+	if (hdmi->phy.ops->read_hpd)
+		hpd = hdmi->phy.ops->read_hpd(hdmi, hdmi->phy.data) ==
+		      connector_status_connected;
+
+	ret = drm_scdc_readb(hdmi->ddc, SCDC_UPDATE_0, &upd0);
+	if (!ret)
+		ret = drm_scdc_readb(hdmi->ddc, SCDC_UPDATE_1, &upd1);
+	if (!ret)
+		ret = drm_scdc_readb(hdmi->ddc, SCDC_CONFIG_0, &cfg0);
+	if (!ret)
+		ret = drm_scdc_readb(hdmi->ddc, 0x31, &sink_cfg1);
+	if (!ret)
+		ret = drm_scdc_readb(hdmi->ddc, SCDC_STATUS_FLAGS_0,
+				     &status0);
+	if (!ret)
+		ret = drm_scdc_readb(hdmi->ddc, 0x41, &ltp01);
+	if (!ret)
+		ret = drm_scdc_readb(hdmi->ddc, 0x42, &ltp23);
+	if (!ret)
+		ret = drm_scdc_read(hdmi->ddc, 0x50, ced, sizeof(ced));
+
+	if (ret) {
+		dev_info(hdmi->dev,
+			 "FRLDBG_BSP sample=%u scdc_read_err=%d link=%08x scdc=%08x/%08x/%08x main_irq=%08x avp_irq=%08x/%08x hpd=%d\n",
+			 sample, ret, link, scdc_cfg, scdc_ctrl, scdc_status,
+			 main_irq, avp1_irq, avp3_irq, hpd);
+	} else {
+		dev_info(hdmi->dev,
+			 "FRLDBG_BSP sample=%u upd=%02x/%02x cfg=%02x sink=%02x ffe=%u status=%02x ltp=%02x/%02x hpd=%d link=%08x flt=%08x/%08x/%08x/%08x scdc=%08x/%08x/%08x rsfec=%08x/%08x pktz=%08x/%08x/%08x/%08x swdisable=%08x pkten=%08x irq=%08x/%08x/%08x video=%08x/%08x\n",
+			 sample, upd0, upd1, cfg0, sink_cfg1, sink_cfg1 >> 4,
+			 status0, ltp01, ltp23, hpd, link, flt0, flt1, flt2,
+			 flt_ctrl, scdc_cfg, scdc_ctrl, scdc_status, rsfec_cfg,
+			 rsfec_status, pktz_cfg, pktz_ctrl0, pktz_ctrl1,
+			 pktz_status1, swdisable, pkten, main_irq, avp1_irq,
+			 avp3_irq, video_if_status, video_mon_status);
+		dev_info(hdmi->dev,
+			 "FRLDBG_BSP decoded CED_checksum=%s lanes=[%u,%u,%u,%u] RS_corrections_snapshot=%u raw50_5a=%02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			 ced[8] & 0x80 ? "ok" : "bad",
+			 dw_hdmi_qp_frl_debug_ced_counter(ced, 0),
+			 dw_hdmi_qp_frl_debug_ced_counter(ced, 2),
+			 dw_hdmi_qp_frl_debug_ced_counter(ced, 4),
+			 dw_hdmi_qp_frl_debug_ced_counter(ced, 6),
+			 dw_hdmi_qp_frl_debug_ced_counter(ced, 9),
+			 ced[0], ced[1], ced[2], ced[3], ced[4], ced[5],
+			 ced[6], ced[7], ced[8], ced[9], ced[10]);
+	}
+
+	mutex_unlock(&hdmi->mutex);
+
+requeue:
+	if (READ_ONCE(dw_hdmi_qp_frl_debug) &&
+	    READ_ONCE(hdmi->frl_debug_active))
+		mod_delayed_work(system_wq, &hdmi->frl_debug_work,
+				 msecs_to_jiffies(dw_hdmi_qp_frl_debug_interval()));
+}
+
+static void dw_hdmi_qp_frl_debug_start(struct dw_hdmi_qp *hdmi)
+{
+	u32 link;
+
+	if (!READ_ONCE(dw_hdmi_qp_frl_debug))
+		return;
+
+	link = hdmi_readl(hdmi, LINK_CONFIG0);
+	if (!(link & OPMODE_FRL))
+		return;
+
+	cancel_delayed_work_sync(&hdmi->frl_debug_work);
+	hdmi->frl_debug_sample = 0;
+	WRITE_ONCE(hdmi->frl_debug_active, true);
+	dev_info(hdmi->dev,
+		 "FRLDBG_BSP v1 enable interval_ms=%u link=%08x\n",
+		 dw_hdmi_qp_frl_debug_interval(), link);
+	mod_delayed_work(system_wq, &hdmi->frl_debug_work, 0);
+}
+
+static void dw_hdmi_qp_frl_debug_stop(struct dw_hdmi_qp *hdmi,
+				      const char *reason)
+{
+	WRITE_ONCE(hdmi->frl_debug_active, false);
+	if (cancel_delayed_work_sync(&hdmi->frl_debug_work))
+		dev_info(hdmi->dev, "FRLDBG_BSP disable reason=%s samples=%u\n",
+			 reason, hdmi->frl_debug_sample);
+}
