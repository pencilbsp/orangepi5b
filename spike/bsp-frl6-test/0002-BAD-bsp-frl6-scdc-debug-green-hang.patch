+	INIT_DELAYED_WORK(&hdmi->frl_debug_work, dw_hdmi_qp_frl_debug_work);
 
 	ddc_node = of_parse_phandle(np, "ddc-i2c-bus", 0);
 	if (ddc_node) {
@@ -4143,6 +4326,8 @@ static struct dw_hdmi_qp *dw_hdmi_qp_probe(struct platform_device *pdev,
 
